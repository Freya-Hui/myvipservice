---
import { getCollection } from 'astro:content';
import { languages, useTranslations, type Locale } from '../i18n/ui';
import { getStaticLocaleHref } from '../i18n/routes';

const currentLocale = (Astro.currentLocale ?? 'en') as Locale;
const t = useTranslations(currentLocale);
const year = new Date().getFullYear();
const pathname = Astro.url.pathname;

const allServices = await getCollection('services', (entry) =>
  entry.id.startsWith(`${currentLocale}/`),
);
const services = allServices.sort((a, b) => a.data.order - b.data.order);

function slugOf(id: string) {
  return id.split('/').slice(1).join('/');
}

// Brand names, not translated. Facebook has no custom username yet, so it uses the numeric Page id.
const socialLinks = [
  { name: 'Instagram', icon: 'instagram', href: 'https://www.instagram.com/myvipservice.paris/' },
  {
    name: 'Facebook',
    icon: 'facebook',
    href: 'https://www.facebook.com/profile.php?id=61594022342370',
  },
];
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <p class="wordmark">MYVIPSERVICE</p>
      <p class="text-small">{t('footer.brandBlurb')}</p>
    </div>

    <nav aria-label={t('footer.quickLinksHeading')}>
      <h2 class="text-small footer-heading">{t('footer.quickLinksHeading')}</h2>
      <ul class="footer-list">
        <li><a href={`/${currentLocale}/`}>{t('nav.home')}</a></li>
        <li><a href={`/${currentLocale}/about/`}>{t('nav.about')}</a></li>
        <li><a href={`/${currentLocale}/services/`}>{t('nav.services')}</a></li>
        <li>
          <a href={`/${currentLocale}/travel-styles/`}>{t('travelStyles.hero.title')}</a>
        </li>
        <li><a href={`/${currentLocale}/contact/`}>{t('nav.contact')}</a></li>
      </ul>
    </nav>

    <nav aria-label={t('footer.servicesHeading')}>
      <h2 class="text-small footer-heading">{t('footer.servicesHeading')}</h2>
      <ul class="footer-list">
        {
          services.map((service) => (
            <li>
              <a href={`/${currentLocale}/services/${slugOf(service.id)}/`}>{service.data.title}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h2 class="text-small footer-heading">{t('footer.contactHeading')}</h2>
      <ul class="footer-list">
        <li>{t('contact.info.email')}: contact@myvipservice.com</li>
        <li>{t('contact.info.address')}: 29 rue de Mogador, 75009 Paris</li>
      </ul>
      <a class="button button--quiet" href={`/${currentLocale}/contact/`}>{t('nav.contact')} →</a>

      <h2 class="text-small footer-heading footer-heading--spaced">{t('footer.followHeading')}</h2>
      <ul class="footer-list footer-list--inline footer-list--social">
        {
          socialLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${link.name} (${t('footer.opensInNewTab')})`}
              >
                {link.icon === 'instagram' && (
                  <svg
                    class="social-icon"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    aria-hidden="true"
                  >
                    <rect x="3" y="3" width="18" height="18" rx="5" />
                    <circle cx="12" cy="12" r="4" />
                    <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
                  </svg>
                )}
                {link.icon === 'facebook' && (
                  <svg
                    class="social-icon"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M13.5 21v-8h2.7l.4-3.2h-3.1V7.8c0-.9.3-1.5 1.6-1.5h1.7V3.4c-.3 0-1.3-.2-2.4-.2-2.4 0-4 1.4-4 4.1v2.5H7.7V13h2.7v8h3.1z" />
                  </svg>
                )}
                <span>{link.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <nav aria-label={t('footer.languageHeading')}>
      <h2 class="text-small footer-heading">{t('footer.languageHeading')}</h2>
      <ul class="footer-list footer-list--inline">
        {
          Object.entries(languages).map(([code, label]) => (
            <li>
              <a
                href={getStaticLocaleHref(pathname, code as Locale)}
                lang={code}
                aria-current={code === currentLocale ? 'true' : undefined}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="container site-footer__bottom">
    <p class="text-small cookie-notice">{t('common.cookieNotice')}</p>
    <div class="site-footer__legal">
      <p class="text-small">&copy; {year} MYVIPSERVICE. {t('footer.rightsReserved')}</p>
      <ul class="footer-list footer-list--inline">
        <li><a href={`/${currentLocale}/privacy-policy/`}>{t('footer.privacyPolicy')}</a></li>
        <li><a href={`/${currentLocale}/legal-notice/`}>{t('footer.legalNotice')}</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-7);
    padding-block: var(--space-6) var(--space-4);
    color: var(--color-text-muted);
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: var(--space-5);
    margin-bottom: var(--space-6);
  }

  .site-footer__brand .wordmark {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--color-text);
    letter-spacing: var(--tracking-wordmark);
    margin-bottom: var(--space-2);
  }

  .footer-heading {
    color: var(--color-text);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    margin-bottom: var(--space-3);
  }

  .footer-heading--spaced {
    margin-top: var(--space-5);
  }

  .footer-list {
    list-style: none;
    margin: 0 0 var(--space-3);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--text-small);
  }

  .footer-list--inline {
    flex-direction: row;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: 0;
  }

  .footer-list a {
    text-decoration: none;
    color: var(--color-text-muted);
  }

  /* Bigger tap area for the social links on touch screens. */
  .footer-list--social a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding-block: var(--space-2);
  }

  .social-icon {
    flex-shrink: 0;
  }

  .footer-list a:hover {
    color: var(--color-accent);
  }

  .footer-list a[aria-current='true'] {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .site-footer__bottom {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-4);
  }

  .cookie-notice {
    margin-bottom: var(--space-3);
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
  }
</style>
