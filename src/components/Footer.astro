---
import { getCollection } from 'astro:content';
import { useTranslations, type Locale } from '../i18n/ui';
import LanguageSwitcher from './LanguageSwitcher.astro';

const currentLocale = (Astro.currentLocale ?? 'en') as Locale;
const t = useTranslations(currentLocale);
const year = new Date().getFullYear();

const allServices = await getCollection('services', (entry) =>
  entry.id.startsWith(`${currentLocale}/`),
);
const services = allServices.sort((a, b) => a.data.order - b.data.order);

function slugOf(id: string) {
  return id.split('/').slice(1).join('/');
}
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <p class="wordmark">MYVIPSERVICE</p>
      <p class="text-small">{t('footer.brandBlurb')}</p>
    </div>

    <nav aria-label={t('footer.quickLinksHeading')}>
      <h2 class="text-small footer-heading">{t('footer.quickLinksHeading')}</h2>
      <ul class="footer-list">
        <li><a href={`/${currentLocale}/`}>{t('nav.home')}</a></li>
        <li><a href={`/${currentLocale}/about/`}>{t('nav.about')}</a></li>
        <li><a href={`/${currentLocale}/services/`}>{t('nav.services')}</a></li>
        <li><a href={`/${currentLocale}/contact/`}>{t('nav.contact')}</a></li>
      </ul>
    </nav>

    <nav aria-label={t('footer.servicesHeading')}>
      <h2 class="text-small footer-heading">{t('footer.servicesHeading')}</h2>
      <ul class="footer-list">
        {
          services.map((service) => (
            <li>
              <a href={`/${currentLocale}/services/#${slugOf(service.id)}`}>{service.data.title}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h2 class="text-small footer-heading">{t('footer.contactHeading')}</h2>
      <ul class="footer-list">
        <li>{t('contact.info.email')}: {t('contact.info.emailPlaceholder')}</li>
        <li>{t('contact.info.phone')}: {t('contact.info.phonePlaceholder')}</li>
      </ul>
      <a class="button button--quiet" href={`/${currentLocale}/contact/`}>{t('nav.contact')} →</a>
    </div>

    <div>
      <h2 class="text-small footer-heading">{t('footer.languageHeading')}</h2>
      <LanguageSwitcher />
    </div>
  </div>

  <div class="container site-footer__bottom">
    <p class="text-small cookie-notice">{t('common.cookieNotice')}</p>
    <div class="site-footer__legal">
      <p class="text-small">&copy; {year} MYVIPSERVICE. {t('footer.rightsReserved')}</p>
      <ul class="footer-list footer-list--inline">
        <li><a href={`/${currentLocale}/privacy-policy/`}>{t('footer.privacyPolicy')}</a></li>
        <li><a href={`/${currentLocale}/legal-notice/`}>{t('footer.legalNotice')}</a></li>
      </ul>
      <p class="text-small placeholder-note">{t('footer.icpPlaceholder')}</p>
      <p class="text-small placeholder-note">{t('footer.socialPlaceholder')}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-7);
    padding-block: var(--space-6) var(--space-4);
    color: var(--color-text-muted);
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: var(--space-5);
    margin-bottom: var(--space-6);
  }

  .site-footer__brand .wordmark {
    font-family: var(--font-display);
    color: var(--color-text);
    letter-spacing: var(--tracking-wordmark);
    margin-bottom: var(--space-2);
  }

  .footer-heading {
    color: var(--color-text);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    margin-bottom: var(--space-3);
  }

  .footer-list {
    list-style: none;
    margin: 0 0 var(--space-3);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--text-small);
  }

  .footer-list--inline {
    flex-direction: row;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: 0;
  }

  .footer-list a {
    text-decoration: none;
    color: var(--color-text-muted);
  }

  .footer-list a:hover {
    color: var(--color-accent);
  }

  .site-footer__bottom {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-4);
  }

  .cookie-notice {
    margin-bottom: var(--space-3);
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
  }

  .placeholder-note {
    color: var(--color-text-faint);
  }
</style>
