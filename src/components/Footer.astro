---
import { useTranslations, type Locale } from '../i18n/ui';

const currentLocale = (Astro.currentLocale ?? 'en') as Locale;
const t = useTranslations(currentLocale);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <p class="cookie-notice">{t('common.cookieNotice')}</p>
    <div class="site-footer__row">
      <p>&copy; {year} MYVIPSERVICE. {t('footer.rightsReserved')}</p>
      <ul class="legal-links">
        <li><a href={`/${currentLocale}/privacy-policy`}>{t('footer.privacyPolicy')}</a></li>
        <li><a href={`/${currentLocale}/legal-notice`}>{t('footer.legalNotice')}</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-7);
    padding-block: var(--space-4);
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  .cookie-notice {
    margin-bottom: var(--space-3);
  }

  .site-footer__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: space-between;
    align-items: center;
  }

  .legal-links {
    display: flex;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .legal-links a {
    text-decoration: none;
    color: var(--color-text-muted);
  }

  .legal-links a:hover {
    color: var(--color-accent);
  }
</style>
