---
import { getImageSafe } from '../data/image-attributions';
import type { Locale } from '../i18n/ui';

interface Day {
  day: number;
  title: string;
  body: string;
  image?: string;
}

interface Props {
  days: Day[];
  locale: Locale;
}

const { days, locale } = Astro.props;
---

<ol class="day-itinerary">
  {
    days.map((entry) => {
      const image = entry.image ? getImageSafe(entry.image) : undefined;
      const needsCredit = image && image.license !== 'Unsplash License';
      return (
        <li class="day-itinerary__item">
          <span class="day-itinerary__index" aria-hidden="true">
            {String(entry.day).padStart(2, '0')}
          </span>
          <div class="day-itinerary__body">
            <h3>{entry.title}</h3>
            <p class="text-small">{entry.body}</p>
            {image && (
              <figure class="figure figure--standard day-itinerary__figure">
                <img
                  src={image.src}
                  alt={image.altByLocale[locale]}
                  loading="lazy"
                  width="1600"
                  height="1200"
                />
                {needsCredit && (
                  <figcaption class="gallery__credit text-small">
                    Photo:{' '}
                    <a href={image.sourceUrl} target="_blank" rel="noopener noreferrer">
                      {image.author} / {image.sourceName}
                    </a>
                    , {image.license}
                  </figcaption>
                )}
              </figure>
            )}
          </div>
        </li>
      );
    })
  }
</ol>

<style>
  .day-itinerary {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
  }

  .day-itinerary__item {
    display: flex;
    gap: var(--space-4);
    padding-block: var(--space-4);
  }

  .day-itinerary__item + .day-itinerary__item {
    border-top: 1px solid var(--color-border);
  }

  .day-itinerary__index {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    border: 1px solid var(--color-accent);
    border-radius: 50%;
    color: var(--color-accent);
    font-family: var(--font-display);
    font-size: var(--text-small);
  }

  .day-itinerary__body h3 {
    font-size: var(--text-h4);
    margin-bottom: var(--space-2);
  }

  .day-itinerary__body p {
    color: var(--color-text-muted);
  }

  .day-itinerary__figure {
    margin: var(--space-3) 0 0;
    max-width: 32rem;
  }
</style>
