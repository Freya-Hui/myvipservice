---
import { languages, useTranslations, type Locale } from '../i18n/ui';
import { getStaticLocaleHref } from '../i18n/routes';
import { getDetailSwitchUrl, type LinkableCollection } from '../lib/content';

interface Props {
  /** Set on detail pages so each language link resolves to the matching translation, not a 404 or the wrong content. */
  translationContext?: { collection: LinkableCollection; translationKey: string };
  /** Set when rendered inside a header floating over a photo — the closed
   *  toggle needs fixed light colours; the open panel has its own solid
   *  background either way, so it's untouched. */
  transparent?: boolean;
}

const { translationContext, transparent = false } = Astro.props;
const currentLocale = (Astro.currentLocale ?? 'en') as Locale;
const t = useTranslations(currentLocale);

const targets = await Promise.all(
  Object.keys(languages).map(async (code) => {
    if (code !== currentLocale && translationContext) {
      const url = await getDetailSwitchUrl(
        translationContext.collection,
        code as Locale,
        translationContext.translationKey,
      );
      return [code, url] as const;
    }
    return [code, getStaticLocaleHref(Astro.url.pathname, code as Locale)] as const;
  }),
);
const hrefByLocale = Object.fromEntries(targets);
---

<div class="language-switcher" class:list={{ 'language-switcher--transparent': transparent }}>
  <button
    type="button"
    class="language-switcher__toggle"
    id="lang-toggle"
    aria-haspopup="true"
    aria-expanded="false"
    aria-controls="lang-panel"
    aria-label={`${t('common.languageLabel')}: ${languages[currentLocale]}`}
  >
    <span>{languages[currentLocale]}</span>
    <svg
      class="language-switcher__chevron"
      width="10"
      height="6"
      viewBox="0 0 10 6"
      aria-hidden="true"
    >
      <path
        d="M1 1l4 4 4-4"
        stroke="currentColor"
        stroke-width="1.4"
        fill="none"
        stroke-linecap="round"></path>
    </svg>
  </button>
  <ul class="language-switcher__panel" id="lang-panel" hidden>
    {
      Object.entries(languages).map(([code, label]) => {
        const isCurrent = code === currentLocale;
        return (
          <li>
            <a
              href={hrefByLocale[code]}
              data-locale={code}
              lang={code}
              aria-current={isCurrent ? 'true' : undefined}
            >
              <span>{label}</span>
              {isCurrent && (
                <svg width="12" height="10" viewBox="0 0 12 10" aria-hidden="true">
                  <path
                    d="M1 5l3.5 3.5L11 1"
                    stroke="currentColor"
                    stroke-width="1.5"
                    fill="none"
                  />
                </svg>
              )}
            </a>
          </li>
        );
      })
    }
  </ul>
</div>

<script>
  const toggle = document.getElementById('lang-toggle');
  const panel = document.getElementById('lang-panel');

  function closePanel() {
    panel?.setAttribute('hidden', '');
    toggle?.setAttribute('aria-expanded', 'false');
  }

  function openPanel() {
    panel?.removeAttribute('hidden');
    toggle?.setAttribute('aria-expanded', 'true');
  }

  toggle?.addEventListener('click', (event) => {
    event.stopPropagation();
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    if (isOpen) closePanel();
    else openPanel();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      closePanel();
      toggle.focus();
    }
  });

  document.addEventListener('click', (event) => {
    if (!panel || panel.hasAttribute('hidden')) return;
    const target = event.target as Node;
    if (!panel.contains(target) && target !== toggle && !toggle?.contains(target)) {
      closePanel();
    }
  });

  // Remember the visitor's explicit choice so the root redirect (see src/pages/index.astro)
  // honours it on the next visit instead of re-guessing from navigator.language.
  panel?.querySelectorAll<HTMLAnchorElement>('a[data-locale]').forEach((link) => {
    link.addEventListener('click', () => {
      localStorage.setItem('myvipservice:locale', link.dataset.locale ?? '');
      closePanel();
    });
  });
</script>

<style>
  .language-switcher {
    position: relative;
  }

  .language-switcher__toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: transparent;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
    padding: 0.4rem 0.75rem;
    color: var(--color-text-muted);
    font: inherit;
    font-size: var(--text-small);
    cursor: pointer;
  }

  .language-switcher__toggle:hover {
    color: var(--color-accent);
  }

  /* Fixed light colours — this toggle sits on a dark photo scrim,
     independent of the site's own light/dark theme. Matches Header's own
     1261px breakpoint: below it, this toggle only ever renders inside the
     header's solid-card mobile dropdown, not the photo, so it must keep
     the normal theme colour there. */
  @media (min-width: 1261px) {
    .language-switcher--transparent .language-switcher__toggle {
      border-color: var(--color-border-on-photo);
      color: var(--color-on-photo);
      font-weight: 600;
      text-shadow: 0 1px 3px rgb(11 15 25 / 55%);
    }

    .language-switcher--transparent .language-switcher__toggle:hover {
      color: var(--color-accent-strong);
    }
  }

  .language-switcher__chevron {
    transition: transform var(--transition-fast);
  }

  .language-switcher__toggle[aria-expanded='true'] .language-switcher__chevron {
    transform: rotate(180deg);
  }

  .language-switcher__panel {
    position: absolute;
    top: calc(100% + var(--space-2));
    left: 0;
    z-index: 30;
    min-width: 9rem;
    margin: 0;
    padding: var(--space-2);
    list-style: none;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
    box-shadow: var(--shadow-elevated);
  }

  .language-switcher__panel a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-2);
    text-decoration: none;
    color: var(--color-text-muted);
    font-size: var(--text-small);
    border-radius: var(--radius);
  }

  .language-switcher__panel a:hover {
    background: var(--color-bg-inset);
    color: var(--color-text);
  }

  .language-switcher__panel a[aria-current='true'] {
    color: var(--color-accent);
  }

  .language-switcher__panel svg {
    color: var(--color-accent);
    flex-shrink: 0;
  }
</style>
