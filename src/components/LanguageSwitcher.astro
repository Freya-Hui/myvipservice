---
import { languages, useTranslations, type Locale } from '../i18n/ui';
import { KNOWN_PAGE_SLUGS } from '../i18n/routes';

const currentLocale = (Astro.currentLocale ?? 'en') as Locale;
const t = useTranslations(currentLocale);

// Swap the leading /<locale>/ segment of the current path for each language.
// If the rest of the path isn't a page we know exists in every locale yet,
// fall back to that locale's homepage instead of a dead link.
const segments = Astro.url.pathname.split('/').filter(Boolean);
const rest = segments.slice(1).join('/');
const isKnownPage = (KNOWN_PAGE_SLUGS as readonly string[]).includes(rest);
const targetPath = isKnownPage ? rest : '';
---

<nav class="language-switcher" aria-label={t('common.languageLabel')}>
  <ul>
    {
      Object.entries(languages).map(([code, label]) => (
        <li>
          <a
            href={`/${code}/${targetPath}`}
            data-locale={code}
            lang={code}
            aria-current={code === currentLocale ? 'true' : undefined}
          >
            {label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  // Remember the visitor's explicit choice so the root redirect (see src/pages/index.astro)
  // honours it on the next visit instead of re-guessing from navigator.language.
  document
    .querySelectorAll<HTMLAnchorElement>('.language-switcher a[data-locale]')
    .forEach((link) => {
      link.addEventListener('click', () => {
        localStorage.setItem('myvipservice:locale', link.dataset.locale ?? '');
      });
    });
</script>

<style>
  .language-switcher ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--text-small);
  }

  .language-switcher a {
    text-decoration: none;
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
  }

  .language-switcher a:hover {
    color: var(--color-accent);
  }

  .language-switcher a[aria-current='true'] {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
</style>
