---
import { getImage } from '../../data/image-attributions';
import type { Locale } from '../../i18n/ui';

interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  body: string;
  imageId: string;
  locale: Locale;
  reverse?: boolean;
  /** Shorter image + tighter section padding — for a spot like the
   *  homepage where this section needs to sit within one screen alongside
   *  whatever follows it, rather than the full-height version used
   *  elsewhere (About page, service detail pages). */
  compact?: boolean;
}

const { id, eyebrow, title, body, imageId, locale, reverse = false, compact = false } = Astro.props;
const image = getImage(imageId);
// Unsplash License needs no credit; other licenses (e.g. Pixabay, Wikimedia
// Commons CC BY-SA) are conditioned on attribution, so surface it.
const needsCredit = image.license !== 'Unsplash License';
---

<section
  class="section story-feature"
  id={id}
  class:list={{ 'story-feature--reverse': reverse, 'story-feature--compact': compact }}
>
  <div class="container story-feature__grid">
    <div class="figure figure--standard">
      <img
        src={image.src}
        alt={image.altByLocale[locale]}
        width="1600"
        height="1200"
        loading="lazy"
      />
      {
        needsCredit && (
          <p class="story-feature__credit text-small">
            Photo:{' '}
            <a href={image.sourceUrl} target="_blank" rel="noopener noreferrer">
              {image.author} / {image.sourceName}
            </a>
            , {image.license}
          </p>
        )
      }
    </div>
    <div class="story-feature__content prose">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2>{title}</h2>
      <p class="story-feature__body">{body}</p>
    </div>
  </div>
</section>

<style>
  .story-feature__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    align-items: center;
  }

  .story-feature__body {
    color: var(--color-text-muted);
    font-size: var(--text-body-lg);
  }

  .story-feature__credit {
    color: var(--color-text-faint);
    margin-top: var(--space-1);
  }

  .story-feature__credit a {
    color: inherit;
  }

  @media (min-width: 768px) {
    .story-feature__grid {
      grid-template-columns: 1fr 1.1fr;
    }

    .story-feature--reverse .story-feature__grid {
      grid-template-columns: 1.1fr 1fr;
    }

    .story-feature--reverse .figure {
      order: 2;
    }

    .story-feature--compact {
      padding-block: calc(var(--section-padding-block) * 0.6);
    }

    .story-feature--compact .figure--standard {
      aspect-ratio: 3 / 2;
    }
  }
</style>
