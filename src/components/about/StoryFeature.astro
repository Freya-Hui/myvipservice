---
import { getImage } from '../../data/image-attributions';
import type { Locale } from '../../i18n/ui';

interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  body: string;
  imageId: string;
  locale: Locale;
  reverse?: boolean;
}

const { id, eyebrow, title, body, imageId, locale, reverse = false } = Astro.props;
const image = getImage(imageId);
---

<section class="section story-feature" id={id} class:list={{ 'story-feature--reverse': reverse }}>
  <div class="container story-feature__grid">
    <div class="figure figure--standard">
      <img
        src={image.src}
        alt={image.altByLocale[locale]}
        width="1600"
        height="1200"
        loading="lazy"
      />
    </div>
    <div class="story-feature__content prose">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2>{title}</h2>
      <p class="story-feature__body">{body}</p>
    </div>
  </div>
</section>

<style>
  .story-feature__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    align-items: center;
  }

  .story-feature__body {
    color: var(--color-text-muted);
    font-size: var(--text-body-lg);
  }

  @media (min-width: 768px) {
    .story-feature__grid {
      grid-template-columns: 1fr 1.1fr;
    }

    .story-feature--reverse .story-feature__grid {
      grid-template-columns: 1.1fr 1fr;
    }

    .story-feature--reverse .figure {
      order: 2;
    }
  }
</style>
