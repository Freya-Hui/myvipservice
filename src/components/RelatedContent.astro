---
import SectionHeading from './SectionHeading.astro';
import ContentGrid from './ContentGrid.astro';
import ContentCard from './ContentCard.astro';
import type { Locale } from '../i18n/ui';

interface Item {
  href: string;
  imageId: string;
  eyebrow?: string;
  title: string;
  summary: string;
  meta?: string;
  draftLabel?: string;
}

interface Props {
  eyebrow: string;
  title: string;
  items: Item[];
  locale: Locale;
  /** Optional link to a full listing page — omitted on detail-page "related X" uses, which show a curated set rather than a browsable list. */
  viewAllLabel?: string;
  viewAllHref?: string;
}

const { eyebrow, title, items, locale, viewAllLabel, viewAllHref } = Astro.props;
---

{
  items.length > 0 && (
    <section class="section related-content">
      <div class="container">
        <SectionHeading eyebrow={eyebrow} title={title} />
        <ContentGrid>
          {items.map((item) => (
            <ContentCard {...item} locale={locale} />
          ))}
        </ContentGrid>
        {viewAllLabel && viewAllHref && (
          <a class="text-small related-content__view-all" href={viewAllHref}>
            {viewAllLabel}
          </a>
        )}
      </div>
    </section>
  )
}

<style>
  .related-content .content-grid {
    margin-top: var(--space-5);
  }

  .related-content__view-all {
    display: inline-block;
    margin-top: var(--space-5);
    color: var(--color-accent);
  }
</style>
