---
import SectionHeading from './SectionHeading.astro';
import ContentGrid from './ContentGrid.astro';
import ContentCard from './ContentCard.astro';
import type { Locale } from '../i18n/ui';

interface Item {
  href: string;
  imageId: string;
  eyebrow: string;
  title: string;
  summary: string;
  meta?: string;
  draftLabel?: string;
}

interface Props {
  eyebrow: string;
  title: string;
  items: Item[];
  locale: Locale;
}

const { eyebrow, title, items, locale } = Astro.props;
---

{
  items.length > 0 && (
    <section class="section related-content">
      <div class="container">
        <SectionHeading eyebrow={eyebrow} title={title} />
        <ContentGrid>
          {items.map((item) => (
            <ContentCard {...item} locale={locale} />
          ))}
        </ContentGrid>
      </div>
    </section>
  )
}

<style>
  .related-content .content-grid {
    margin-top: var(--space-5);
  }
</style>
