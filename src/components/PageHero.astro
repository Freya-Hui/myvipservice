---
import { getImage } from '../data/image-attributions';
import type { Locale } from '../i18n/ui';

interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
  /** Optional — pages that want a photographic hero pass an image id + locale. */
  imageId?: string;
  locale?: Locale;
}

const { eyebrow, title, subtitle, imageId, locale } = Astro.props;
const image = imageId ? getImage(imageId) : null;
---

<section class="page-hero section">
  <div class="container prose">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    {subtitle && <p class="page-hero__subtitle">{subtitle}</p>}
  </div>
  {
    image && locale && (
      <div class="container">
        <div class="figure figure--wide page-hero__image">
          <img
            src={image.src}
            alt={image.altByLocale[locale]}
            width="2400"
            height="1200"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    )
  }
</section>

<style>
  .page-hero {
    padding-block-end: var(--space-5);
  }

  .page-hero__subtitle {
    color: var(--color-text-muted);
    font-size: var(--text-body-lg);
  }

  .page-hero__image {
    margin-top: var(--space-5);
  }
</style>
