---
import { getImage } from '../data/image-attributions';
import type { Locale } from '../i18n/ui';

interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
  /** Optional — pages that want a photographic hero pass an image id + locale. */
  imageId?: string;
  locale?: Locale;
}

const { eyebrow, title, subtitle, imageId, locale } = Astro.props;
const image = imageId ? getImage(imageId) : null;
// A page can pass a `cta` slot to put a call-to-action on the same row as
// the title — that row then spans the full content width (matching the
// image below) instead of the narrower prose column, so the button has
// somewhere to sit and the title lines up with the image's left edge.
const hasCta = Astro.slots.has('cta');
---

<section class="page-hero section">
  <div class:list={['container', hasCta ? 'page-hero__row' : 'prose']}>
    <div class="page-hero__heading">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      {subtitle && <p class="page-hero__subtitle">{subtitle}</p>}
    </div>
    {
      hasCta && (
        <div class="page-hero__cta">
          <slot name="cta" />
        </div>
      )
    }
  </div>
  {
    image && locale && (
      <div class="container">
        <div class="figure figure--wide page-hero__image">
          <img
            src={image.src}
            alt={image.altByLocale[locale]}
            width="2400"
            height="1200"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    )
  }
</section>

<style>
  .page-hero {
    padding-block-end: var(--space-5);
  }

  .page-hero__subtitle {
    color: var(--color-text-muted);
    font-size: var(--text-body-lg);
  }

  .page-hero__image {
    margin-top: var(--space-5);
  }

  .page-hero__row {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .page-hero__heading {
    max-width: var(--prose-max-width);
    min-width: 0;
  }

  .page-hero__cta {
    flex-shrink: 0;
  }

  /* Below this width there isn't room for the title and CTA side by side
     without either cramping the heading or truncating the button — they
     stack instead, full width, same as any other narrow layout. */
  @media (min-width: 640px) {
    .page-hero__row {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: flex-end;
      justify-content: space-between;
    }

    /* Scoped to the CTA-row layout specifically — a bare .page-hero__heading
       selector here was also shrinking the heading on every CTA-less page
       (journal, destinations, journeys, experiences...), which has no CTA
       competing for the row and needs the full measure. Real bug: a long
       CJK title on a journal article was wrapping to 4 narrow lines with a
       huge stretch of empty space beside it, instead of using the width it
       actually had. */
    .page-hero__row .page-hero__heading {
      /* Flex-wrap decides whether the CTA fits on this line using each
         item's hypothetical (unshrunk) size — a heading claiming the full
         prose measure leaves less than the CTA's width free even when
         there looks like room, forcing an unwanted wrap. Capping it to
         leave space for the CTA (plus the row's gap) keeps them on one
         line down to this breakpoint, only reaching the full measure once
         the row is wide enough to spare it. */
      max-width: min(var(--prose-max-width), calc(100% - 20rem));
    }
  }
</style>
