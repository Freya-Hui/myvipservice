---
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const hotelBudgetRanges = [
  { value: 'under-500', label: t('contact.form.hotelBudget.under500') },
  { value: '500-1500', label: t('contact.form.hotelBudget.500To1500') },
  { value: '1500-5000', label: t('contact.form.hotelBudget.1500To5000') },
  { value: 'over-5000', label: t('contact.form.hotelBudget.over5000') },
];
---

<div class="hotel-enquiry" id="hotel-enquiry-root">
  <form id="hotel-enquiry-form">
    <p class="visually-hidden">
      <label>
        Leave this field blank: <input name="bot-field" tabindex="-1" autocomplete="off" />
      </label>
    </p>
    <input type="hidden" name="locale" value={locale} />

    <div class="hotel-enquiry__layout">
      <div class="hotel-enquiry__main">
        <div class="hotel-enquiry__panel" id="he-step-1">
          <h2 class="hotel-enquiry__stepHeading">{t('hotelEnquiry.step1Heading')}</h2>

          <div class="field">
            <label for="he-destination">{t('contact.form.destination')}</label>
            <input type="text" id="he-destination" name="destination" required />
          </div>

          <div class="field-group__row">
            <div class="field">
              <label for="he-check-in">{t('accommodationBooking.checkInLabel')}</label>
              <input type="date" id="he-check-in" name="checkIn" required />
            </div>
            <div class="field">
              <label for="he-check-out">{t('accommodationBooking.checkOutLabel')}</label>
              <input type="date" id="he-check-out" name="checkOut" required />
            </div>
            <div class="field">
              <label for="he-party-size">{t('ticketBooking.partySizeLabel')}</label>
              <input type="number" id="he-party-size" name="partySize" min="1" value="2" required />
            </div>
          </div>
        </div>

        <div class="hotel-enquiry__panel" id="he-step-2" hidden>
          <h2 class="hotel-enquiry__stepHeading">{t('hotelEnquiry.step2Heading')}</h2>

          <div class="field">
            <label for="he-hotel-budget">{t('contact.form.hotelBudget')}</label>
            <select id="he-hotel-budget" name="hotelBudget" required>
              <option value="">{t('contact.form.hotelBudgetPlaceholder')}</option>
              {hotelBudgetRanges.map((range) => <option value={range.value}>{range.label}</option>)}
            </select>
          </div>

          <div class="field">
            <label for="he-notes">{t('carBooking.notesLabel')}</label>
            <textarea
              id="he-notes"
              name="notes"
              rows="3"
              placeholder={t('carBooking.notesPlaceholder')}></textarea>
          </div>
        </div>

        <div class="hotel-enquiry__panel" id="he-step-3" hidden>
          <h2 class="hotel-enquiry__stepHeading">{t('carBooking.section.contact')}</h2>

          <fieldset class="field-group">
            <legend class="visually-hidden">{t('carBooking.section.contact')}</legend>
            <div class="field-group__row">
              <div class="field">
                <label for="he-name">{t('carBooking.nameLabel')}</label>
                <input type="text" id="he-name" name="name" autocomplete="name" required />
              </div>
              <div class="field">
                <label for="he-email">{t('carBooking.emailLabel')}</label>
                <input type="email" id="he-email" name="email" autocomplete="email" required />
              </div>
            </div>
          </fieldset>

          <div class="field">
            <label for="he-phone">{t('carBooking.phoneLabel')}</label>
            <div class="hotel-enquiry__phoneRow">
              <select
                id="he-phone-code"
                name="phoneCountryCode"
                aria-label={t('carBooking.phoneCodeLabel')}
              >
                <option value="+86">China +86</option>
                <option value="+33">France +33</option>
                <option value="+44">UK +44</option>
                <option value="+49">Germany +49</option>
                <option value="+39">Italy +39</option>
                <option value="+34">Spain +34</option>
                <option value="+41">Switzerland +41</option>
                <option value="+7">Russia +7</option>
                <option value="+1">US/Canada +1</option>
                <option value="+852">Hong Kong +852</option>
                <option value="+65">Singapore +65</option>
                <option value="+81">Japan +81</option>
              </select>
              <input type="tel" id="he-phone" name="phoneWechat" autocomplete="tel" required />
            </div>
            <p class="hotel-enquiry__note">{t('carBooking.whatsappNote')}</p>
          </div>

          <div class="field">
            <span class="hotel-enquiry__label">{t('carBooking.contactMethodLabel')}</span>
            <div class="hotel-enquiry__pills" role="radiogroup">
              <button type="button" class="pill is-active" data-contact-method="whatsapp"
                >{t('carBooking.contactMethod.whatsapp')}</button
              >
              <button type="button" class="pill" data-contact-method="email"
                >{t('carBooking.contactMethod.email')}</button
              >
              <button type="button" class="pill" data-contact-method="imessage"
                >{t('carBooking.contactMethod.imessage')}</button
              >
            </div>
            <input
              type="hidden"
              name="preferredContactMethod"
              id="he-contact-method-field"
              value="whatsapp"
            />
          </div>
        </div>
      </div>

      <div class="hotel-enquiry__side">
        <p class="hotel-enquiry__stepIndicator" id="he-step-indicator">
          {t('hotelEnquiry.step1Of3')}
        </p>

        <div class="hotel-enquiry__summary" id="he-summary">
          <p class="hotel-enquiry__summaryTitle">{t('carBooking.summaryTitle')}</p>
          <dl class="hotel-enquiry__summaryList" id="he-summary-list"></dl>
        </div>

        <div class="hotel-enquiry__actions">
          <button type="button" class="button button--quiet" id="he-back-button" hidden
            >{t('carBooking.backButton')}</button
          >
          <button type="button" class="button button--primary" id="he-next-button"
            >{t('hotelEnquiry.nextButton')}</button
          >
          <button type="submit" class="button button--primary" id="he-submit-button" hidden
            >{t('accommodationBooking.submit')}</button
          >
        </div>
        <p class="hotel-enquiry__status" id="he-status" role="status" aria-live="polite"></p>
      </div>
    </div>
  </form>
</div>

<script
  define:vars={{
    step1Label: t('hotelEnquiry.step1Of3'),
    step2Label: t('hotelEnquiry.step2Of3'),
    step3Label: t('hotelEnquiry.step3Of3'),
    requestReceivedNote: t('carBooking.requestReceivedNote'),
    genericErrorNote: t('carBooking.genericErrorNote'),
    destinationLabelText: t('contact.form.destination'),
    checkInLabelText: t('accommodationBooking.checkInLabel'),
    checkOutLabelText: t('accommodationBooking.checkOutLabel'),
    partySizeLabelText: t('ticketBooking.partySizeLabel'),
    hotelBudgetLabelText: t('contact.form.hotelBudget'),
  }}
>
  (function () {
    const root = document.getElementById('hotel-enquiry-root');
    if (!root) return;

    const form = document.getElementById('hotel-enquiry-form');
    const stepIndicator = document.getElementById('he-step-indicator');
    const steps = [
      document.getElementById('he-step-1'),
      document.getElementById('he-step-2'),
      document.getElementById('he-step-3'),
    ];
    const stepLabels = [step1Label, step2Label, step3Label];
    const nextButton = document.getElementById('he-next-button');
    const backButton = document.getElementById('he-back-button');
    const submitButton = document.getElementById('he-submit-button');
    const destinationInput = document.getElementById('he-destination');
    const checkInInput = document.getElementById('he-check-in');
    const checkOutInput = document.getElementById('he-check-out');
    const partySizeInput = document.getElementById('he-party-size');
    const hotelBudgetSelect = document.getElementById('he-hotel-budget');
    const contactMethodPills = root.querySelectorAll('[data-contact-method]');
    const contactMethodField = document.getElementById('he-contact-method-field');
    const summaryList = document.getElementById('he-summary-list');
    const statusEl = document.getElementById('he-status');

    let current = 0;

    function today() {
      return new Date().toISOString().slice(0, 10);
    }

    checkInInput.min = today();
    checkInInput.addEventListener('change', () => {
      checkOutInput.min = checkInInput.value || today();
      if (checkOutInput.value && checkOutInput.value <= checkInInput.value) {
        checkOutInput.value = '';
      }
      updateSummary();
    });

    function updateSummary() {
      if (!summaryList) return;
      const rows = [];
      if (destinationInput.value) rows.push([destinationLabelText, destinationInput.value]);
      if (checkInInput.value) rows.push([checkInLabelText, checkInInput.value]);
      if (checkOutInput.value) rows.push([checkOutLabelText, checkOutInput.value]);
      if (partySizeInput.value) rows.push([partySizeLabelText, partySizeInput.value]);
      const budgetOption = hotelBudgetSelect.options[hotelBudgetSelect.selectedIndex];
      if (hotelBudgetSelect.value && budgetOption) {
        rows.push([hotelBudgetLabelText, budgetOption.textContent]);
      }
      summaryList.innerHTML = rows
        .map(([k, v]) => `<div class="hotel-enquiry__summaryRow"><dt>${k}</dt><dd>${v}</dd></div>`)
        .join('');
    }

    [destinationInput, checkOutInput, partySizeInput].forEach((el) => {
      el.addEventListener('input', updateSummary);
      el.addEventListener('change', updateSummary);
    });
    hotelBudgetSelect.addEventListener('change', updateSummary);

    function showStep(index) {
      steps.forEach((panel, i) => (panel.hidden = i !== index));
      stepIndicator.textContent = stepLabels[index];
      backButton.hidden = index === 0;
      nextButton.hidden = index === steps.length - 1;
      submitButton.hidden = index !== steps.length - 1;
      root.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    nextButton.addEventListener('click', () => {
      // The hidden attribute doesn't stop constraint validation, so scope
      // the check to the current step's own fields rather than the whole
      // (mostly still-hidden) form.
      const invalid = steps[current].querySelector(':invalid');
      if (invalid) {
        invalid.reportValidity();
        return;
      }
      current = Math.min(current + 1, steps.length - 1);
      showStep(current);
    });

    backButton.addEventListener('click', () => {
      current = Math.max(current - 1, 0);
      showStep(current);
    });

    contactMethodPills.forEach((btn) => {
      btn.addEventListener('click', () => {
        contactMethodPills.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        contactMethodField.value = btn.getAttribute('data-contact-method');
      });
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const invalid = steps[current].querySelector(':invalid');
      if (invalid) {
        invalid.reportValidity();
        return;
      }
      submitButton.disabled = true;
      statusEl.textContent = '…';

      const data = Object.fromEntries(new FormData(form).entries());

      try {
        const res = await fetch('/.netlify/functions/notify-accommodation-lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        if (!res.ok) throw new Error('failed');
        statusEl.textContent = requestReceivedNote;
        form.reset();
        contactMethodPills.forEach((b) =>
          b.classList.toggle('is-active', b.dataset.contactMethod === 'whatsapp'),
        );
        contactMethodField.value = 'whatsapp';
        current = 0;
        showStep(current);
        updateSummary();
      } catch {
        statusEl.textContent = genericErrorNote;
      } finally {
        submitButton.disabled = false;
      }
    });

    showStep(current);
    updateSummary();
  })();
</script>

<style>
  .hotel-enquiry__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    /* Wider than the site's usual reading column — this page's whole job
       is the widget, and the two-column layout below needs the room. */
    max-width: 64rem;
  }

  @media (min-width: 56rem) {
    .hotel-enquiry__layout {
      grid-template-columns: 1fr 20rem;
      align-items: start;
    }

    .hotel-enquiry__side {
      position: sticky;
      top: var(--space-5);
    }
  }

  .hotel-enquiry__stepIndicator {
    font-size: var(--text-small);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-4);
  }

  .hotel-enquiry__panel[hidden] {
    display: none;
  }

  .hotel-enquiry__stepHeading {
    font-size: var(--text-h4);
    margin-bottom: var(--space-4);
  }

  .field {
    margin-bottom: var(--space-4);
  }

  .field label,
  .hotel-enquiry__label {
    display: block;
    margin-bottom: var(--space-1);
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
  }

  .field-group {
    border: none;
    padding: 0;
    margin: 0 0 var(--space-4);
  }

  .field-group__row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--space-3);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }

  .hotel-enquiry__pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .pill {
    font: inherit;
    font-size: var(--text-small);
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
    background: var(--color-bg-elevated);
    color: inherit;
    cursor: pointer;
  }

  .pill.is-active {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-bg-elevated);
  }

  .hotel-enquiry__note {
    font-size: var(--text-small);
    color: var(--color-text-muted);
    margin-top: var(--space-1);
    margin-bottom: var(--space-3);
  }

  .hotel-enquiry__phoneRow {
    display: flex;
    gap: var(--space-2);
  }

  .hotel-enquiry__phoneRow select {
    flex: 0 0 auto;
    width: auto;
  }

  .hotel-enquiry__phoneRow input {
    flex: 1;
  }

  .hotel-enquiry__side {
    padding: var(--space-4);
    background: var(--color-bg-inset);
    border-radius: var(--radius);
  }

  .hotel-enquiry__summary {
    padding-bottom: var(--space-3);
    margin-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .hotel-enquiry__summary:empty,
  .hotel-enquiry__summaryList:empty {
    display: none;
  }

  .hotel-enquiry__summaryTitle {
    font-size: var(--text-small);
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .hotel-enquiry__summaryList {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin: 0;
  }

  /* Built client-side via innerHTML (see updateSummary() above), so these
     rows never get Astro's scoping attribute — :global() is required for
     the styles to reach them. */
  :global(.hotel-enquiry__summaryRow) {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    font-size: var(--text-small);
  }

  :global(.hotel-enquiry__summaryRow dt) {
    color: var(--color-text-muted);
  }

  :global(.hotel-enquiry__summaryRow dd) {
    margin: 0;
    text-align: right;
  }

  .hotel-enquiry__actions {
    display: flex;
    gap: var(--space-3);
  }

  .hotel-enquiry__actions .button {
    flex: 1;
  }

  .hotel-enquiry__actions .button[hidden] {
    display: none;
  }

  .hotel-enquiry__status {
    margin-top: var(--space-3);
    font-size: var(--text-small);
    color: var(--color-text-muted);
    text-align: center;
  }
</style>
