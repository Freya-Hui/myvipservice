---
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  hotels: { value: string; label: string }[];
}

const { locale, hotels } = Astro.props;
const t = useTranslations(locale);

const hotelBudgetRanges = [
  { value: 'under-500', label: t('contact.form.hotelBudget.under500') },
  { value: '500-1500', label: t('contact.form.hotelBudget.500To1500') },
  { value: '1500-5000', label: t('contact.form.hotelBudget.1500To5000') },
  { value: 'over-5000', label: t('contact.form.hotelBudget.over5000') },
];

const hotelTypes = [
  { value: 'palace', label: t('hotelStay.type.palace') },
  { value: 'boutique', label: t('hotelStay.type.boutique') },
  { value: 'residence', label: t('hotelStay.type.residence') },
  { value: 'villa', label: t('hotelStay.type.villa') },
  { value: 'unsure', label: t('hotelStay.type.unsure') },
];
---

<div class="hotel-stay" id="hotel-stay-root">
  <form id="hotel-stay-form">
    <p class="visually-hidden">
      <label>
        Leave this field blank: <input name="bot-field" tabindex="-1" autocomplete="off" />
      </label>
    </p>
    <input type="hidden" name="locale" value={locale} />

    <div class="hotel-stay__layout">
      <div class="hotel-stay__main">
        <div class="hotel-stay__panel" id="hs-step-1">
          <h2 class="hotel-stay__stepHeading">{t('hotelStay.step1Heading')}</h2>

          <fieldset class="field-group">
            <legend class="hotel-stay__label">{t('hotelStay.hotelsLabel')}</legend>
            <div class="hotel-stay__checks">
              {
                hotels.map((hotel) => (
                  <label class="hotel-stay__check">
                    <input type="checkbox" name="hotelPick" value={hotel.label} />
                    {hotel.label}
                  </label>
                ))
              }
            </div>
          </fieldset>

          <div class="field">
            <label for="hs-other-hotels">{t('hotelStay.otherHotelsLabel')}</label>
            <input
              type="text"
              id="hs-other-hotels"
              name="otherHotels"
              placeholder={t('hotelStay.otherHotelsPlaceholder')}
            />
          </div>

          <div class="field-group__row">
            <div class="field">
              <label for="hs-check-in">{t('accommodationBooking.checkInLabel')}</label>
              <input type="date" id="hs-check-in" name="checkIn" />
            </div>
            <div class="field">
              <label for="hs-check-out">{t('accommodationBooking.checkOutLabel')}</label>
              <input type="date" id="hs-check-out" name="checkOut" />
            </div>
            <div class="field">
              <label for="hs-party-size">{t('ticketBooking.partySizeLabel')}</label>
              <input type="number" id="hs-party-size" name="partySize" min="1" value="2" required />
            </div>
          </div>
          <p class="hotel-stay__note">{t('hotelStay.datesNote')}</p>
        </div>

        <div class="hotel-stay__panel" id="hs-step-2" hidden>
          <h2 class="hotel-stay__stepHeading">{t('hotelStay.step2Heading')}</h2>

          <div class="field">
            <label for="hs-hotel-budget">{t('contact.form.hotelBudget')}</label>
            <select id="hs-hotel-budget" name="hotelBudget" required>
              <option value="">{t('contact.form.hotelBudgetPlaceholder')}</option>
              {hotelBudgetRanges.map((range) => <option value={range.value}>{range.label}</option>)}
            </select>
          </div>

          <fieldset class="field-group">
            <legend class="hotel-stay__label">{t('hotelStay.typeLabel')}</legend>
            <div class="hotel-stay__checks">
              {
                hotelTypes.map((type) => (
                  <label class="hotel-stay__check">
                    <input type="checkbox" name="hotelType" value={type.label} />
                    {type.label}
                  </label>
                ))
              }
            </div>
          </fieldset>

          <div class="field">
            <label for="hs-notes">{t('carBooking.notesLabel')}</label>
            <textarea
              id="hs-notes"
              name="notes"
              rows="3"
              placeholder={t('carBooking.notesPlaceholder')}></textarea>
          </div>
        </div>

        <div class="hotel-stay__panel" id="hs-step-3" hidden>
          <h2 class="hotel-stay__stepHeading">{t('carBooking.section.contact')}</h2>

          <fieldset class="field-group">
            <legend class="visually-hidden">{t('carBooking.section.contact')}</legend>
            <div class="field-group__row">
              <div class="field">
                <label for="hs-name">{t('carBooking.nameLabel')}</label>
                <input type="text" id="hs-name" name="name" autocomplete="name" required />
              </div>
              <div class="field">
                <label for="hs-email">{t('carBooking.emailLabel')}</label>
                <input type="email" id="hs-email" name="email" autocomplete="email" required />
              </div>
            </div>
          </fieldset>

          <div class="field">
            <label for="hs-phone">{t('carBooking.phoneLabel')}</label>
            <div class="hotel-stay__phoneRow">
              <select
                id="hs-phone-code"
                name="phoneCountryCode"
                aria-label={t('carBooking.phoneCodeLabel')}
              >
                <option value="+86">China +86</option>
                <option value="+33">France +33</option>
                <option value="+44">UK +44</option>
                <option value="+49">Germany +49</option>
                <option value="+39">Italy +39</option>
                <option value="+34">Spain +34</option>
                <option value="+41">Switzerland +41</option>
                <option value="+7">Russia +7</option>
                <option value="+1">US/Canada +1</option>
                <option value="+852">Hong Kong +852</option>
                <option value="+65">Singapore +65</option>
                <option value="+81">Japan +81</option>
              </select>
              <input type="tel" id="hs-phone" name="phoneWechat" autocomplete="tel" required />
            </div>
            <p class="hotel-stay__note">{t('carBooking.whatsappNote')}</p>
          </div>

          <div class="field">
            <span class="hotel-stay__label">{t('carBooking.contactMethodLabel')}</span>
            <div class="hotel-stay__pills" role="radiogroup">
              <button type="button" class="pill is-active" data-contact-method="whatsapp"
                >{t('carBooking.contactMethod.whatsapp')}</button
              >
              <button type="button" class="pill" data-contact-method="email"
                >{t('carBooking.contactMethod.email')}</button
              >
              <button type="button" class="pill" data-contact-method="imessage"
                >{t('carBooking.contactMethod.imessage')}</button
              >
            </div>
            <input
              type="hidden"
              name="preferredContactMethod"
              id="hs-contact-method-field"
              value="whatsapp"
            />
          </div>
        </div>
      </div>

      <div class="hotel-stay__side">
        <p class="hotel-stay__stepIndicator" id="hs-step-indicator">
          {t('hotelStay.step1Of3')}
        </p>

        <div class="hotel-stay__summary" id="hs-summary">
          <p class="hotel-stay__summaryTitle">{t('carBooking.summaryTitle')}</p>
          <dl class="hotel-stay__summaryList" id="hs-summary-list"></dl>
        </div>

        <div class="hotel-stay__actions">
          <button type="button" class="button button--quiet" id="hs-back-button" hidden
            >{t('carBooking.backButton')}</button
          >
          <button type="button" class="button button--primary" id="hs-next-button"
            >{t('hotelEnquiry.nextButton')}</button
          >
          <button type="submit" class="button button--primary" id="hs-submit-button" hidden
            >{t('accommodationBooking.submit')}</button
          >
        </div>
        <p class="hotel-stay__reach">{t('hotelStay.reachNote')}</p>
        <p class="hotel-stay__status" id="hs-status" role="status" aria-live="polite"></p>
      </div>
    </div>
  </form>
</div>

<script
  define:vars={{
    step1Label: t('hotelStay.step1Of3'),
    step2Label: t('hotelStay.step2Of3'),
    step3Label: t('hotelStay.step3Of3'),
    receivedNote: t('hotelStay.success'),
    genericErrorNote: t('carBooking.genericErrorNote'),
    hotelsLabelText: t('hotelStay.summaryHotels'),
    typeLabelText: t('hotelStay.summaryType'),
    checkInLabelText: t('accommodationBooking.checkInLabel'),
    checkOutLabelText: t('accommodationBooking.checkOutLabel'),
    partySizeLabelText: t('ticketBooking.partySizeLabel'),
    hotelBudgetLabelText: t('contact.form.hotelBudget'),
  }}
>
  (function () {
    const root = document.getElementById('hotel-stay-root');
    if (!root) return;

    const form = document.getElementById('hotel-stay-form');
    const stepIndicator = document.getElementById('hs-step-indicator');
    const steps = [
      document.getElementById('hs-step-1'),
      document.getElementById('hs-step-2'),
      document.getElementById('hs-step-3'),
    ];
    const stepLabels = [step1Label, step2Label, step3Label];
    const nextButton = document.getElementById('hs-next-button');
    const backButton = document.getElementById('hs-back-button');
    const submitButton = document.getElementById('hs-submit-button');
    const otherHotelsInput = document.getElementById('hs-other-hotels');
    const checkInInput = document.getElementById('hs-check-in');
    const checkOutInput = document.getElementById('hs-check-out');
    const partySizeInput = document.getElementById('hs-party-size');
    const hotelBudgetSelect = document.getElementById('hs-hotel-budget');
    const contactMethodPills = root.querySelectorAll('[data-contact-method]');
    const contactMethodField = document.getElementById('hs-contact-method-field');
    const summaryList = document.getElementById('hs-summary-list');
    const statusEl = document.getElementById('hs-status');

    let current = 0;

    // Multi-select checkboxes share one name, so a plain FormData-to-object
    // pass would keep only the last tick — collect them explicitly.
    function checked(name) {
      return [...form.querySelectorAll(`input[name="${name}"]:checked`)].map((el) => el.value);
    }

    function hotelNames() {
      const typed = otherHotelsInput.value
        .split(/[,，、]/)
        .map((name) => name.trim())
        .filter(Boolean);
      return [...checked('hotelPick'), ...typed];
    }

    function today() {
      return new Date().toISOString().slice(0, 10);
    }

    checkInInput.min = today();
    checkInInput.addEventListener('change', () => {
      checkOutInput.min = checkInInput.value || today();
      if (checkOutInput.value && checkInInput.value && checkOutInput.value <= checkInInput.value) {
        checkOutInput.value = '';
      }
    });

    function escapeHtml(value) {
      return String(value).replace(
        /[&<>"']/g,
        (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c],
      );
    }

    function updateSummary() {
      const rows = [];
      const hotels = hotelNames();
      if (hotels.length) rows.push([hotelsLabelText, hotels.join(', ')]);
      if (checkInInput.value) rows.push([checkInLabelText, checkInInput.value]);
      if (checkOutInput.value) rows.push([checkOutLabelText, checkOutInput.value]);
      if (partySizeInput.value) rows.push([partySizeLabelText, partySizeInput.value]);
      const budgetOption = hotelBudgetSelect.options[hotelBudgetSelect.selectedIndex];
      if (hotelBudgetSelect.value && budgetOption) {
        rows.push([hotelBudgetLabelText, budgetOption.textContent]);
      }
      const types = checked('hotelType');
      if (types.length) rows.push([typeLabelText, types.join(', ')]);
      summaryList.innerHTML = rows
        .map(
          ([k, v]) =>
            `<div class="hotel-stay__summaryRow"><dt>${escapeHtml(k)}</dt><dd>${escapeHtml(v)}</dd></div>`,
        )
        .join('');
    }

    // Selections (steps 1–2) drive the summary; contact details never do.
    steps.slice(0, 2).forEach((panel) => {
      panel.addEventListener('input', updateSummary);
      panel.addEventListener('change', updateSummary);
    });

    function showStep(index) {
      steps.forEach((panel, i) => (panel.hidden = i !== index));
      stepIndicator.textContent = stepLabels[index];
      backButton.hidden = index === 0;
      nextButton.hidden = index === steps.length - 1;
      submitButton.hidden = index !== steps.length - 1;
      root.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    nextButton.addEventListener('click', () => {
      // The hidden attribute doesn't stop constraint validation, so scope
      // the check to the current step's own fields rather than the whole
      // (mostly still-hidden) form.
      const invalid = steps[current].querySelector(':invalid');
      if (invalid) {
        invalid.reportValidity();
        return;
      }
      current = Math.min(current + 1, steps.length - 1);
      showStep(current);
    });

    backButton.addEventListener('click', () => {
      current = Math.max(current - 1, 0);
      showStep(current);
    });

    contactMethodPills.forEach((btn) => {
      btn.addEventListener('click', () => {
        contactMethodPills.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        contactMethodField.value = btn.getAttribute('data-contact-method');
      });
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const invalid = steps[current].querySelector(':invalid');
      if (invalid) {
        invalid.reportValidity();
        return;
      }
      submitButton.disabled = true;
      statusEl.textContent = '…';

      const data = Object.fromEntries(new FormData(form).entries());
      delete data.hotelPick;
      delete data.otherHotels;
      delete data.hotelType;
      data.propertyName = hotelNames().join(', ');
      data.hotelTypes = checked('hotelType').join(', ');

      try {
        const res = await fetch('/.netlify/functions/notify-accommodation-lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        if (!res.ok) throw new Error('failed');
        statusEl.textContent = receivedNote;
        form.reset();
        contactMethodPills.forEach((b) =>
          b.classList.toggle('is-active', b.dataset.contactMethod === 'whatsapp'),
        );
        contactMethodField.value = 'whatsapp';
        current = 0;
        showStep(current);
        updateSummary();
      } catch {
        statusEl.textContent = genericErrorNote;
      } finally {
        submitButton.disabled = false;
      }
    });

    showStep(current);
    updateSummary();
  })();
</script>

<style>
  .hotel-stay__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 56rem) {
    .hotel-stay__layout {
      grid-template-columns: 1fr 20rem;
      align-items: start;
    }

    .hotel-stay__side {
      position: sticky;
      top: var(--space-5);
    }
  }

  .hotel-stay__stepIndicator {
    font-size: var(--text-small);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-4);
  }

  .hotel-stay__panel[hidden] {
    display: none;
  }

  .hotel-stay__stepHeading {
    font-size: var(--text-h4);
    margin-bottom: var(--space-4);
  }

  .field {
    margin-bottom: var(--space-4);
  }

  .field label,
  .hotel-stay__label {
    display: block;
    margin-bottom: var(--space-1);
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
  }

  .field-group {
    border: none;
    padding: 0;
    margin: 0 0 var(--space-4);
  }

  .field-group__row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--space-3);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }

  .hotel-stay__pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .pill {
    font: inherit;
    font-size: var(--text-small);
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
    background: var(--color-bg-elevated);
    color: inherit;
    cursor: pointer;
  }

  .pill.is-active {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-bg-elevated);
  }

  .hotel-stay__note {
    font-size: var(--text-small);
    color: var(--color-text-muted);
    margin-top: var(--space-1);
    margin-bottom: var(--space-3);
  }

  .hotel-stay__phoneRow {
    display: flex;
    gap: var(--space-2);
  }

  .hotel-stay__phoneRow select {
    flex: 0 0 auto;
    width: auto;
  }

  .hotel-stay__phoneRow input {
    flex: 1;
  }

  .hotel-stay__side {
    padding: var(--space-4);
    background: var(--color-bg-inset);
    border-radius: var(--radius);
  }

  .hotel-stay__summary {
    padding-bottom: var(--space-3);
    margin-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .hotel-stay__summary:empty,
  .hotel-stay__summaryList:empty {
    display: none;
  }

  .hotel-stay__summaryTitle {
    font-size: var(--text-small);
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .hotel-stay__summaryList {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin: 0;
  }

  /* Built client-side via innerHTML (see updateSummary() above), so these
     rows never get Astro's scoping attribute — :global() is required for
     the styles to reach them. */
  :global(.hotel-stay__summaryRow) {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    font-size: var(--text-small);
  }

  :global(.hotel-stay__summaryRow dt) {
    color: var(--color-text-muted);
  }

  :global(.hotel-stay__summaryRow dd) {
    margin: 0;
    text-align: right;
  }

  .hotel-stay__actions {
    display: flex;
    gap: var(--space-3);
  }

  .hotel-stay__actions .button {
    flex: 1;
  }

  .hotel-stay__actions .button[hidden] {
    display: none;
  }

  .hotel-stay__checks {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-2) var(--space-4);
  }

  .hotel-stay__check {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    margin: 0;
    font-size: var(--text-body);
    color: inherit;
  }

  .hotel-stay__check input {
    width: auto;
    flex: 0 0 auto;
  }

  .hotel-stay__reach {
    margin-top: var(--space-3);
    font-size: var(--text-small);
    text-align: center;
  }

  .hotel-stay__status {
    margin-top: var(--space-3);
    font-size: var(--text-small);
    color: var(--color-text-muted);
    text-align: center;
  }
</style>
