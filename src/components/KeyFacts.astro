---
interface Fact {
  label: string;
  value: string;
}

interface Props {
  facts: Fact[];
}

const { facts } = Astro.props;
---

{
  facts.length > 0 && (
    <dl class="key-facts">
      {facts.map((fact) => (
        <div class="key-facts__item">
          <dt class="text-small">{fact.label}</dt>
          <dd>{fact.value}</dd>
        </div>
      ))}
    </dl>
  )
}

<style>
  .key-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--space-4);
    margin: 0;
  }

  .key-facts__item dt {
    color: var(--color-text-muted);
    margin-bottom: var(--space-1);
  }

  .key-facts__item dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-h4);
  }
</style>
