    background: var(--color-bg-inset);
  }

  .car-booking__note {
    color: var(--color-text-faint);
    font-size: var(--text-small);
    margin: calc(var(--space-3) * -1) 0 0;
  }

  /* Two notes can be visible back to back (e.g. the lead-time note and the
     airport wait-time note) — give them normal spacing instead of stacking
     the pull-up meant for the field above onto each other. */
  .car-booking__note + .car-booking__note,
  .car-booking__summary + .car-booking__note,
  .car-booking__total + .car-booking__note {
    margin-top: var(--space-2);
  }

  .car-booking__note[hidden] {
    display: none;
  }

  #cb-lead-note {
    color: var(--color-error);
  }

  /* The step-1 notes conditionally show/hide based on service type — the
     adjacent-sibling rule above only fires when two visible notes are
     literally back-to-back in the DOM, so a hidden note (or any other
     element) sitting between two visible ones silently breaks it and their
     negative top margins collide instead of stacking. `gap` sidesteps this
     entirely: a [hidden] (display:none) child is never a flex item, so it
     never counts against the gap regardless of which notes are visible. */
  .car-booking__noteStack {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: calc(var(--space-3) * -1);
  }

  .car-booking__noteStack .car-booking__note {
    margin: 0;
  }

