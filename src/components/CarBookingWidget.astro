    white-space: nowrap;
  }

  .car-booking__subtitle {
    color: var(--color-text-muted);
    max-width: var(--prose-max-width);
  }

  .car-booking__stepIndicator {
    margin-top: var(--space-4);
    font-size: var(--text-small);
    letter-spacing: 0.04em;
    text-transform: uppercase;
