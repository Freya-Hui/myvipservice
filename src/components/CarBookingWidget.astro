    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .pill.is-active {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: var(--color-bg-inset);
  }

  .car-booking__vehicles {
    display: grid;
