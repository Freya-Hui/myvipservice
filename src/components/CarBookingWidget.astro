    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--space-3);
  }

  .car-booking__phoneRow {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--space-3);
  }

  .car-booking__label {
    display: block;
    font-size: var(--text-small);
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .car-booking__pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .pill {
