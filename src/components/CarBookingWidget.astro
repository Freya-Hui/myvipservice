  }

  .car-booking__form {
    margin-top: var(--space-4);
    /* Wider than the site's usual reading column — this page's whole job
       is the widget, and the two-column layout below needs the room. */
    max-width: 64rem;
  }

  .car-booking__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 56rem) {
    .car-booking__layout {
