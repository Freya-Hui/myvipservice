---
import { getImageSafe } from '../data/image-attributions';
import type { Locale } from '../i18n/ui';

interface Props {
  images: string[];
  locale: Locale;
}

const { images, locale } = Astro.props;
---

{
  images.length > 0 && (
    <ul class="gallery">
      {images.map((id) => {
        const image = getImageSafe(id);
        {
          /* Unsplash License needs no credit; other licenses (e.g. Wikimedia
          Commons CC BY-SA) are conditioned on attribution, so surface it. */
        }
        const needsCredit = image.license !== 'Unsplash License';
        return (
          <li class="figure figure--standard">
            <img
              src={image.src}
              alt={image.altByLocale[locale]}
              loading="lazy"
              width="1600"
              height="1200"
            />
            {needsCredit && (
              <p class="gallery__credit text-small">
                Photo:{' '}
                <a href={image.sourceUrl} target="_blank" rel="noopener noreferrer">
                  {image.author} / {image.sourceName}
                </a>
                , {image.license}
              </p>
            )}
          </li>
        );
      })}
    </ul>
  )
}

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .gallery__credit {
    color: var(--color-text-faint);
    margin-top: var(--space-1);
  }

  .gallery__credit a {
    color: inherit;
  }
</style>
