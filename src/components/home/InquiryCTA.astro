---
interface Props {
  title: string;
  body: string;
  ctaLabel: string;
  ctaHref: string;
  emailLabel?: string;
  email?: string;
}

const { title, body, ctaLabel, ctaHref, emailLabel, email } = Astro.props;
---

<section class="section inquiry-cta">
  <div class="container inquiry-cta__inner">
    <h2>{title}</h2>
    <p class="inquiry-cta__body">{body}</p>
    <a class="button button--primary" href={ctaHref}>{ctaLabel}</a>
    {
      email && (
        <p class="inquiry-cta__email">
          {emailLabel}: <a href={`mailto:${email}`}>{email}</a>
        </p>
      )
    }
  </div>
</section>

<style>
  /* Recurring bold dark bar (the reference site's black "CONTACT" strips) —
     inverted from the rest of the page rather than a new colour: reuses
     --color-text as the background and --color-bg as the foreground. */
  .inquiry-cta {
    background: var(--color-text);
    color: var(--color-bg);
  }

  .inquiry-cta__inner {
    text-align: center;
    max-width: var(--prose-max-width);
    margin-inline: auto;
  }

  .inquiry-cta h2 {
    color: var(--color-bg);
  }

  .inquiry-cta__body {
    font-family: var(--font-body);
    font-size: var(--text-body-lg);
    color: var(--color-bg-inset);
  }

  .inquiry-cta .button {
    margin-inline: auto;
    background: var(--color-accent-strong);
    border-color: var(--color-accent-strong);
    color: var(--color-text);
  }

  .inquiry-cta__email {
    margin-top: var(--space-4);
    font-size: var(--text-small);
    color: var(--color-bg-inset);
  }

  .inquiry-cta__email a {
    color: var(--color-bg);
    text-underline-offset: 0.25em;
  }

  .inquiry-cta .button:hover {
    background: transparent;
    border-color: var(--color-bg);
    color: var(--color-bg);
  }
</style>
