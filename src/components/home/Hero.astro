---
import { getImage } from '../../data/image-attributions';
import type { Locale } from '../../i18n/ui';

interface Props {
  eyebrow: string;
  tagline: string;
  ctaLabel: string;
  ctaHref: string;
  secondaryCtaLabel?: string;
  secondaryCtaHref?: string;
  locale: Locale;
}

const { eyebrow, tagline, ctaLabel, ctaHref, secondaryCtaLabel, secondaryCtaHref, locale } =
  Astro.props;
const heroImage = getImage('hero-home');
---

<section class="hero">
  <div class="hero__media figure">
    <img
      src={heroImage.src}
      alt={heroImage.altByLocale[locale]}
      width="2400"
      height="1350"
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div class="container hero__content">
    <p class="eyebrow">{eyebrow}</p>
    <h1>MYVIPSERVICE</h1>
    <p class="hero__tagline">{tagline}</p>
    <div class="hero__actions">
      <a class="button button--primary" href={ctaHref}>{ctaLabel}</a>
      {
        secondaryCtaLabel && secondaryCtaHref && (
          <a class="button button--quiet" href={secondaryCtaHref}>
            {secondaryCtaLabel}
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    color: var(--color-text);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(11 15 25 / 55%) 0%, rgb(11 15 25 / 88%) 100%);
  }

  .hero__content {
    padding-block: clamp(5rem, 4rem + 5vw, 9rem) var(--space-7);
    max-width: 42rem;
  }

  .hero h1 {
    font-size: var(--text-h1);
    letter-spacing: var(--tracking-wordmark);
  }

  .hero__tagline {
    color: var(--color-text-muted);
    font-size: var(--text-body-lg);
    max-width: 34rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
</style>
