---
import type { SiteDataItem } from '../../data/site-content';

interface Props {
  eyebrow: string;
  title: string;
  steps: SiteDataItem[];
}

const { eyebrow, title, steps } = Astro.props;
---

<section class="section process">
  <div class="container">
    <p class="eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
    <ol class="process__list">
      {
        steps.map((step, index) => (
          <li>
            <div class="process__head">
              <span class="process__index" aria-hidden="true">
                {index + 1}
              </span>
              <h3>{step.title}</h3>
            </div>
            <p class="text-small">{step.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: var(--card-gap);
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    counter-reset: none;
  }

  /* Mobile: badge and title share a row (see .process__head below) so a
     step reads as one compact line instead of the badge, then a gap, then
     the title stacked underneath — desktop keeps the original stacked
     look untouched. */
  .process__head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .process__head h3 {
    margin-bottom: 0;
  }

  .process__index {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    background: var(--color-accent);
    border-radius: var(--radius-sm);
    color: var(--color-on-accent);
    font-family: var(--font-display);
    font-weight: 700;
  }

  .process__list p {
    color: var(--color-text-muted);
  }

  @media (min-width: 768px) {
    .process {
      padding-block: calc(var(--section-padding-block) * 0.65);
    }

    .process__head {
      display: block;
      margin-bottom: 0;
    }

    .process__index {
      margin-bottom: var(--space-3);
    }

    .process__head h3 {
      margin-bottom: var(--space-2);
    }
  }
</style>
