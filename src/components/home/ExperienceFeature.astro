---
import { getImage } from '../../data/image-attributions';

interface Props {
  eyebrow: string;
  title: string;
  body: string;
  ctaLabel: string;
  ctaHref: string;
  imageId: string;
}

const { eyebrow, title, body, ctaLabel, ctaHref, imageId } = Astro.props;
const image = getImage(imageId);
---

<section class="section feature feature--reverse">
  <div class="container feature__grid">
    <div class="feature__content">
      <p class="eyebrow">{eyebrow}</p>
      <h2>{title}</h2>
      <p class="feature__body">{body}</p>
      <a class="button" href={ctaHref}>{ctaLabel}</a>
    </div>
    <div class="figure figure--standard">
      <img src={image.src} alt={image.alt} width="1600" height="1200" loading="lazy" />
    </div>
  </div>
</section>

<style>
  .feature__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    align-items: center;
  }

  .feature__body {
    color: var(--color-text-muted);
  }

  @media (min-width: 768px) {
    .feature--reverse .feature__grid {
      grid-template-columns: 1fr 1.1fr;
    }
  }
</style>
