---
import type { SiteDataItem } from '../../data/site-content';

interface Props {
  eyebrow: string;
  title: string;
  items: SiteDataItem[];
  ctaLabel: string;
  ctaHref: string;
}

const { eyebrow, title, items, ctaLabel, ctaHref } = Astro.props;
---

<section class="section network">
  <div class="container">
    <p class="eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
    <ul class="network__grid">
      {
        items.map((item) => (
          <li class="card">
            <h3>{item.title}</h3>
            <p class="text-small">{item.description}</p>
          </li>
        ))
      }
    </ul>
    <a class="button" href={ctaHref}>{ctaLabel}</a>
  </div>
</section>

<style>
  .network__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--card-gap);
    list-style: none;
    margin: var(--space-5) 0;
    padding: 0;
  }

  .network__grid h3 {
    margin-bottom: var(--space-2);
  }

  .network__grid p {
    color: var(--color-text-muted);
  }
</style>
