---
interface Props {
  message: string;
}

const { message } = Astro.props;
---

<div class="empty-state">
  <p>{message}</p>
</div>

<style>
  .empty-state {
    padding: var(--space-6) var(--space-4);
    text-align: center;
    color: var(--color-text-muted);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius);
  }
</style>
