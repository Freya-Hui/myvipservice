---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { languages, useTranslations, type Locale } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);
---

<BaseLayout
  title={t('orderStatus.pageTitle')}
  description={t('orderStatus.pageDescription')}
  path="order-status"
  noindex
>
  <div class="container prose order-status">
    <h1>{t('orderStatus.pageTitle')}</h1>
    <p id="os-loading">{t('orderStatus.loading')}</p>
    <div id="os-content" hidden>
      <p class="order-status__status" id="os-status"></p>
      <p id="os-detail"></p>
      <dl class="order-status__vehicle" id="os-vehicle" hidden></dl>
    </div>
    <p id="os-notfound" hidden>
      {t('orderStatus.notFound')}
      <a href={`/${locale}/contact/`}>{t('orderStatus.contactCta')}</a>
    </p>
  </div>
</BaseLayout>

<script
  is:inline
  define:vars={{
    statusLabels: {
      pending_payment: t('orderStatus.status.pending_payment'),
      paid: t('orderStatus.status.paid'),
      vehicle_confirmed: t('orderStatus.status.vehicle_confirmed'),
      driver_info_sent: t('orderStatus.status.driver_info_sent'),
      expired: t('orderStatus.status.expired'),
    },
    detailText: {
      paid: t('orderStatus.detail.paid'),
      vehicle_confirmed: t('orderStatus.detail.vehicle_confirmed'),
      driver_info_sent: t('orderStatus.detail.driver_info_sent'),
      expired: t('orderStatus.detail.expired'),
    },
    driverLabel: t('orderStatus.driverLabel'),
    phoneLabel: t('orderStatus.phoneLabel'),
    vehicleLabel: t('orderStatus.vehicleLabel'),
  }}
>
  (function () {
    const loading = document.getElementById('os-loading');
    const content = document.getElementById('os-content');
    const notFound = document.getElementById('os-notfound');
    const statusEl = document.getElementById('os-status');
    const detailEl = document.getElementById('os-detail');
    const vehicleEl = document.getElementById('os-vehicle');

    const ref = new URLSearchParams(window.location.search).get('ref');

    function show(el) {
      loading.hidden = true;
      content.hidden = el !== content;
      notFound.hidden = el !== notFound;
    }

    if (!ref) {
      show(notFound);
      return;
    }

    fetch(`/.netlify/functions/get-order-status?ref=${encodeURIComponent(ref)}`)
      .then((res) => (res.ok ? res.json() : Promise.reject()))
      .then((order) => {
        statusEl.textContent = statusLabels[order.status] || order.status;
        detailEl.textContent = detailText[order.status] || '';
        if (order.vehicleInfo) {
          vehicleEl.hidden = false;
          vehicleEl.innerHTML = `
            <div><dt>${driverLabel}</dt><dd>${order.vehicleInfo.driverName}</dd></div>
            <div><dt>${phoneLabel}</dt><dd>${order.vehicleInfo.driverPhone}</dd></div>
            <div><dt>${vehicleLabel}</dt><dd>${order.vehicleInfo.vehicleDescription}</dd></div>
          `;
        }
        show(content);
      })
      .catch(() => show(notFound));
  })();
</script>

<style>
  .order-status {
    padding-block: var(--space-6);
  }

  .order-status__status {
    font-family: var(--font-display);
    font-size: var(--text-h4);
    color: var(--color-accent);
  }

  .order-status__vehicle {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .order-status__vehicle dt {
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }

  .order-status__vehicle dd {
    margin: 0;
  }
</style>
