---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PageHero from '../../../../components/PageHero.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import StoryFeature from '../../../../components/about/StoryFeature.astro';
import MediaHighlightList from '../../../../components/MediaHighlightList.astro';
import SectionHeading from '../../../../components/SectionHeading.astro';
import RelatedContent from '../../../../components/RelatedContent.astro';
import Faq from '../../../../components/Faq.astro';
import ContentStatusBadge from '../../../../components/ContentStatusBadge.astro';
import InquiryCTA from '../../../../components/home/InquiryCTA.astro';
import {
  getDetailStaticPaths,
  getEntriesByTravelStyle,
  getLocaleEntries,
  excludeShownImages,
} from '../../../../lib/content';
import { useTranslations, type Locale } from '../../../../i18n/ui';

export const getStaticPaths = () => getDetailStaticPaths('travelStyles');

const { locale } = Astro.params as { locale: Locale };
const { entry } = Astro.props as Awaited<ReturnType<typeof getDetailStaticPaths>>[number]['props'];
const { data } = entry;
const t = useTranslations(locale);

const ctaHref = `/${locale}/contact/?about=${encodeURIComponent(data.title)}`;

interface HighlightItem {
  text: string;
  image?: string;
}

const highlights: HighlightItem[] = data.highlights.map((item: string | HighlightItem) =>
  typeof item === 'string' ? { text: item } : item,
);

const shownImageIds = [data.coverImage, ...data.gallery];
// `travelFit` in particular is a broad, already-populated tag (most
// accommodations carry several values), so cap each section rather than
// dumping the whole matching set onto one page.
const RELATED_LIMIT = 6;
const [accommodationsAll, experiencesAll, journeysAll, destinationsAll] = await Promise.all([
  getEntriesByTravelStyle('accommodations', locale, data.translationKey, data.travelFitTag),
  getEntriesByTravelStyle('experiences', locale, data.translationKey),
  getEntriesByTravelStyle('journeys', locale, data.translationKey),
  getEntriesByTravelStyle('destinations', locale, data.translationKey),
]);
const accommodations = accommodationsAll.slice(0, RELATED_LIMIT);
const experiences = experiencesAll.slice(0, RELATED_LIMIT);
const destinations = destinationsAll.slice(0, RELATED_LIMIT);
const journeys = journeysAll.slice(0, RELATED_LIMIT);
// Journal's relatedTravelStyleKeys is a forward reference (content-architecture.md
// §7's planned hook), so this is a plain in-memory reverse lookup rather
// than going through getEntriesByTravelStyle — a one-off, not reused
// elsewhere, so it isn't worth generalising the shared helper for it.
const journalArticles = (await getLocaleEntries('journal', locale))
  .filter((entry) => entry.data.relatedTravelStyleKeys.includes(data.translationKey))
  .slice(0, RELATED_LIMIT);

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: data.title,
    description: data.description,
    url: new URL(`/${locale}/travel-styles/${data.slug}/`, Astro.site).toString(),
  },
];
---

<BaseLayout
  title={data.seoTitle ?? data.title}
  description={data.seoDescription ?? data.description}
  path={`travel-styles/${data.slug}`}
  imageId={data.coverImage}
  structuredData={structuredData}
  translationContext={{ collection: 'travelStyles', translationKey: data.translationKey }}
>
  <div class="container">
    <Breadcrumbs
      items={[
        { label: t('nav.home'), href: `/${locale}/` },
        { label: t('travelStyles.hero.title'), href: `/${locale}/travel-styles/` },
        { label: data.title },
      ]}
    />
  </div>

  <PageHero eyebrow={t('travelStyles.hero.eyebrow')} title={data.title} subtitle={data.description}>
    <a slot="cta" class="button button--primary" href={ctaHref}>{t('common.ctaQuote')} →</a>
  </PageHero>
  {
    data.draft && (
      <div class="container">
        <ContentStatusBadge tone="draft" label={t('badge.draftTranslation')} />
      </div>
    )
  }

  {
    data.storyFeatures.map(
      (feature: { title: string; body: string; imageId: string }, index: number) => (
        <StoryFeature
          title={feature.title}
          body={feature.body}
          imageId={feature.imageId}
          locale={locale}
          reverse={index % 2 === 1}
        />
      ),
    )
  }

  {
    highlights.length > 0 && (
      <section class="section">
        <div class="container prose">
          <SectionHeading eyebrow={data.title} title={t('travelStyles.detail.includesTitle')} />
          <MediaHighlightList items={highlights} locale={locale} />
        </div>
      </section>
    )
  }

  <RelatedContent
    locale={locale}
    eyebrow={t('destinations.hero.eyebrow')}
    title={t('travelStyles.detail.destinationsHeading')}
    items={excludeShownImages(destinations, shownImageIds).map((item) => ({
      href: `/${locale}/destinations/${item.data.slug}/`,
      imageId: item.data.coverImage,
      eyebrow: t(`region.${item.data.region}` as never),
      title: item.data.title,
      summary: item.data.description,
      draftLabel: item.data.draft ? t('badge.draftTranslation') : undefined,
    }))}
  />

  <RelatedContent
    locale={locale}
    eyebrow={t('journeys.hero.title')}
    title={t('travelStyles.detail.journeysHeading')}
    items={excludeShownImages(journeys, shownImageIds).map((item) => ({
      href: `/${locale}/journeys/${item.data.slug}/`,
      imageId: item.data.coverImage,
      eyebrow: t('journeys.hero.title'),
      title: item.data.title,
      summary: item.data.description,
      draftLabel: item.data.draft ? t('badge.draftTranslation') : undefined,
    }))}
  />

  <RelatedContent
    locale={locale}
    eyebrow={t('accommodations.hero.title')}
    title={t('travelStyles.detail.accommodationsHeading')}
    items={excludeShownImages(accommodations, shownImageIds).map((item) => ({
      href: `/${locale}/accommodations/${item.data.slug}/`,
      imageId: item.data.coverImage,
      eyebrow: t(`type.${item.data.type}` as never),
      title: item.data.title,
      summary: item.data.description,
      draftLabel: item.data.draft ? t('badge.draftTranslation') : undefined,
    }))}
  />

  <RelatedContent
    locale={locale}
    eyebrow={t('experiences.hero.title')}
    title={t('travelStyles.detail.experiencesHeading')}
    items={excludeShownImages(experiences, shownImageIds).map((item) => ({
      href: `/${locale}/experiences/${item.data.slug}/`,
      imageId: item.data.coverImage,
      eyebrow: t(`category.${item.data.category}` as never),
      title: item.data.title,
      summary: item.data.description,
      draftLabel: item.data.draft ? t('badge.draftTranslation') : undefined,
    }))}
  />

  <RelatedContent
    locale={locale}
    eyebrow={t('journal.hero.title')}
    title={t('travelStyles.detail.journalHeading')}
    items={excludeShownImages(journalArticles, shownImageIds).map((item) => ({
      href: `/${locale}/journal/${item.data.slug}/`,
      imageId: item.data.coverImage,
      eyebrow: t(`journalCategory.${item.data.category}` as never),
      title: item.data.title,
      summary: item.data.excerpt,
      draftLabel: item.data.draft ? t('badge.draftTranslation') : undefined,
    }))}
  />

  {
    data.faq.length > 0 && (
      <section class="section">
        <div class="container">
          <Faq
            title={t('travelStyles.detail.faqTitle')}
            items={data.faq}
            name={`faq-${data.slug}`}
          />
        </div>
      </section>
    )
  }

  {
    data.href && (
      <section class="section full-service-link">
        <div class="container prose">
          <h2>{t('travelStyles.detail.fullServiceTitle')}</h2>
          <p class="full-service-link__body">{t('travelStyles.detail.fullServiceBody')}</p>
          <a class="text-small" href={data.href}>
            {t('travelStyles.detail.fullServiceLink')} →
          </a>
        </div>
      </section>
    )
  }

  <InquiryCTA
    title={t('home.inquiry.title')}
    body={t('home.inquiry.body')}
    ctaLabel={t('common.cta')}
    ctaHref={`/${locale}/contact/`}
  />
</BaseLayout>

<style>
  .full-service-link__body {
    color: var(--color-text-muted);
  }
</style>
