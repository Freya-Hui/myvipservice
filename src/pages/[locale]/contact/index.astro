---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import StoryFeature from '../../../components/about/StoryFeature.astro';
import ProcessSteps from '../../../components/home/ProcessSteps.astro';
import { languages, useTranslations, type Locale } from '../../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);

// Aligned to the real service lines (same taxonomy as the Services page
// grouping) instead of a generic general/travel split, so an enquiry tells
// the team what kind of request it actually is.
const enquiryTypes = [
  { value: 'private-travel', label: t('servicesGroup.Private Travel') },
  { value: 'hotels-villas', label: t('servicesGroup.Hotels & Villas') },
  { value: 'private-transportation', label: t('servicesGroup.Private Transportation') },
  { value: 'concierge-lifestyle', label: t('servicesGroup.Concierge & Lifestyle') },
  { value: 'groups-corporate', label: t('servicesGroup.Groups & Corporate') },
];

// A real sequence (submit -> review -> proposal -> arrange), not a
// "why choose us" list, so numbered steps are honest here.
const processSteps = [
  { title: t('contact.process.step1.title'), description: t('contact.process.step1.description') },
  { title: t('contact.process.step2.title'), description: t('contact.process.step2.description') },
  { title: t('contact.process.step3.title'), description: t('contact.process.step3.description') },
  { title: t('contact.process.step4.title'), description: t('contact.process.step4.description') },
];

// Ranges rather than free text — the client wants budget to qualify
// enquiries up front, not just describe them.
const budgetRanges = [
  { value: 'under-5k', label: t('contact.form.budget.under5k') },
  { value: '5k-15k', label: t('contact.form.budget.5kTo15k') },
  { value: '15k-50k', label: t('contact.form.budget.15kTo50k') },
  { value: '50k-150k', label: t('contact.form.budget.50kTo150k') },
  { value: 'over-150k', label: t('contact.form.budget.over150k') },
];

const hotelBudgetRanges = [
  { value: 'under-500', label: t('contact.form.hotelBudget.under500') },
  { value: '500-1500', label: t('contact.form.hotelBudget.500To1500') },
  { value: '1500-5000', label: t('contact.form.hotelBudget.1500To5000') },
  { value: 'over-5000', label: t('contact.form.hotelBudget.over5000') },
];

// Lets the team see which channel is actually driving enquiries — optional,
// so it doesn't block submission for a visitor who'd rather not say.
const referralSources = [
  { value: 'wechat', label: t('contact.form.referralSource.wechat') },
  { value: 'xiaohongshu', label: t('contact.form.referralSource.xiaohongshu') },
  { value: 'instagram', label: t('contact.form.referralSource.instagram') },
  { value: 'referral', label: t('contact.form.referralSource.referral') },
  { value: 'search', label: t('contact.form.referralSource.search') },
  { value: 'other', label: t('contact.form.referralSource.other') },
];

// Personal phone lines and unconfirmed WeChat/WhatsApp/hours placeholders
// are intentionally not shown — email is the single public contact channel.
const contactEmail = 'contact@myvipservice.com';
---

<BaseLayout
  title={t('nav.contact')}
  description="MYVIPSERVICE — get in touch to start planning your trip."
  path="contact"
>
  <PageHero
    eyebrow={t('contact.hero.eyebrow')}
    title={t('contact.hero.title')}
    subtitle={t('contact.hero.subtitle')}
  />

  <StoryFeature
    eyebrow={t('contact.intro.eyebrow')}
    title={t('contact.intro.title')}
    body={t('contact.intro.body')}
    imageId="service-reception-desk-call"
    locale={locale}
    compact
  />

  <ProcessSteps
    eyebrow={t('contact.process.eyebrow')}
    title={t('contact.process.title')}
    steps={processSteps}
  />

  <section class="section contact">
    <div class="container contact__layout">
      <p class="contact__email text-small">
        {t('contact.info.email')}: <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
      </p>

      <form
        class="contact__form"
        id="contact-form"
        name="contact"
        method="POST"
        data-netlify="true"
        data-netlify-honeypot="bot-field"
        novalidate
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="visually-hidden">
          <label>
            Leave this field blank: <input name="bot-field" tabindex="-1" autocomplete="off" />
          </label>
        </p>

        <h2>{t('contact.form.heading')}</h2>

        <div class="form-section">
          <p class="form-section__heading">
            <span class="form-section__index" aria-hidden="true">01</span>
            {t('contact.form.section1')}
          </p>

          <fieldset>
            <legend>{t('contact.form.enquiryType')}</legend>
            {
              enquiryTypes.map((type, index) => (
                <label class="radio-label" for={`enquiry-${type.value}`}>
                  <input
                    type="radio"
                    id={`enquiry-${type.value}`}
                    name="enquiryType"
                    value={type.value}
                    checked={index === 0}
                  />
                  {type.label}
                </label>
              ))
            }
          </fieldset>

          <div class="field">
            <label for="name">{t('contact.form.name')}</label>
            <input type="text" id="name" name="name" autocomplete="name" required />
          </div>

          <div class="field">
            <label for="email">{t('contact.form.email')}</label>
            <input type="email" id="email" name="email" autocomplete="email" required />
          </div>

          <div class="field">
            <label for="phoneWechat">
              {t('contact.form.phoneWechat')}
              <span class="text-small">({t('common.optional')})</span>
            </label>
            <input type="text" id="phoneWechat" name="phoneWechat" autocomplete="tel" />
          </div>

          <div class="field">
            <label for="referralSource">
              {t('contact.form.referralSource')}
              <span class="text-small">({t('common.optional')})</span>
            </label>
            <select id="referralSource" name="referralSource">
              <option value="">{t('contact.form.referralSourcePlaceholder')}</option>
              {
                referralSources.map((source) => (
                  <option value={source.value}>{source.label}</option>
                ))
              }
            </select>
          </div>
        </div>

        <div class="form-section">
          <p class="form-section__heading">
            <span class="form-section__index" aria-hidden="true">02</span>
            {t('contact.form.section2')}
          </p>

          <div class="field">
            <label for="destination">{t('contact.form.destination')}</label>
            <input type="text" id="destination" name="destination" required />
          </div>

          <fieldset class="field-group">
            <legend>{t('contact.form.dates')}</legend>
            <div class="field-group__row">
              <div class="field">
                <label for="dateStart">{t('contact.form.dateStart')}</label>
                <input type="date" id="dateStart" name="dateStart" required />
              </div>
              <div class="field">
                <label for="dateEnd">{t('contact.form.dateEnd')}</label>
                <input type="date" id="dateEnd" name="dateEnd" required />
              </div>
            </div>
          </fieldset>

          <div class="field">
            <label for="travellers">
              {t('contact.form.travellers')}
              <span class="text-small">({t('common.optional')})</span>
            </label>
            <input type="number" id="travellers" name="travellers" min="1" step="1" />
          </div>

          <div class="field">
            <label for="budget">{t('contact.form.budget')}</label>
            <select id="budget" name="budget" required>
              <option value="">{t('contact.form.budgetPlaceholder')}</option>
              {budgetRanges.map((range) => <option value={range.value}>{range.label}</option>)}
            </select>
          </div>
        </div>

        <div class="form-section">
          <p class="form-section__heading">
            <span class="form-section__index" aria-hidden="true">03</span>
            {t('contact.form.section3')}
          </p>

          <div class="field">
            <label for="hotelBudget">
              {t('contact.form.hotelBudget')}
              <span class="text-small">({t('common.optional')})</span>
            </label>
            <select id="hotelBudget" name="hotelBudget">
              <option value="">{t('contact.form.hotelBudgetPlaceholder')}</option>
              {hotelBudgetRanges.map((range) => <option value={range.value}>{range.label}</option>)}
            </select>
          </div>

          <div class="field">
            <label for="details">{t('contact.form.details')}</label>
            <textarea id="details" name="details" rows="5" required></textarea>
          </div>
        </div>

        <button class="button button--primary" type="submit">{t('contact.form.submit')}</button>
        <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
      </form>

      <div class="contact__other">
        <h2 class="text-h4">{t('contact.other.heading')}</h2>
        <dl class="contact__other-list">
          <div>
            <dt>{t('contact.section.partnership')}</dt>
            <dd>{t('contact.section.partnershipBody')}</dd>
          </div>
          <div>
            <dt>{t('contact.section.media')}</dt>
            <dd>{t('contact.section.mediaBody')}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>
</BaseLayout>

<script
  is:inline
  define:vars={{
    successMessage: t('contact.form.success'),
    errorMessage: t('contact.form.error'),
    aboutPrefix: t('contact.form.aboutPrefix'),
  }}
>
  const form = document.getElementById('contact-form');
  const status = document.getElementById('form-status');

  // Detail pages link here with ?about=<page title> so a visitor asking
  // about a specific hotel/destination/service doesn't have to retype it.
  const about = new URLSearchParams(location.search).get('about');
  const detailsField = document.getElementById('details');
  if (about && detailsField && !detailsField.value) {
    detailsField.value = `${aboutPrefix}${about}\n\n`;
  }

  function encodeFormData(data) {
    return Object.keys(data)
      .map((key) => encodeURIComponent(key) + '=' + encodeURIComponent(data[key]))
      .join('&');
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = Object.fromEntries(new FormData(form).entries());
    fetch('/', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: encodeFormData(data),
    })
      .then(() => {
        if (status) status.textContent = successMessage;
        form.reset();
      })
      .catch(() => {
        if (status) status.textContent = errorMessage;
      });
  });
</script>

<style>
  .contact__layout {
    max-width: var(--prose-max-width);
  }

  .contact__email {
    color: var(--color-text-muted);
    margin-bottom: var(--space-5);
  }

  .contact__email a {
    color: var(--color-text);
  }

  .form-section {
    padding-top: var(--space-5);
    margin-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .form-section:first-of-type {
    padding-top: 0;
    margin-top: var(--space-5);
    border-top: none;
  }

  .form-section__heading {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--text-h4);
    margin-bottom: var(--space-4);
  }

  .form-section__index {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    border: 1px solid var(--color-accent);
    border-radius: 50%;
    color: var(--color-accent);
    font-size: var(--text-small);
  }

  .field {
    margin-bottom: var(--space-4);
  }

  .field-group {
    margin-bottom: var(--space-4);
  }

  .field-group__row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--space-3);
  }

  .radio-label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-body);
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }

  .radio-label input {
    width: auto;
  }

  .form-status {
    margin-top: var(--space-3);
    color: var(--color-success);
  }

  .contact__other {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .contact__other-list {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-3);
  }

  .contact__other-list dt {
    font-family: var(--font-display);
    font-size: var(--text-body-lg);
    margin-bottom: var(--space-1);
  }

  .contact__other-list dd {
    color: var(--color-text-muted);
    margin-left: 0;
  }

  @media (min-width: 640px) {
    .contact__other-list {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-5);
    }
  }
</style>
