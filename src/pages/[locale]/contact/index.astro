---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import { languages, useTranslations, type Locale } from '../../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);

const enquiryTypes = [
  { value: 'general', label: t('contact.section.general') },
  { value: 'travel', label: t('contact.section.travel') },
  { value: 'partnership', label: t('contact.section.partnership') },
  { value: 'media', label: t('contact.section.media') },
];

// Ranges rather than free text — the client wants budget to qualify
// enquiries up front, not just describe them.
const budgetRanges = [
  { value: 'under-5k', label: t('contact.form.budget.under5k') },
  { value: '5k-15k', label: t('contact.form.budget.5kTo15k') },
  { value: '15k-50k', label: t('contact.form.budget.15kTo50k') },
  { value: '50k-150k', label: t('contact.form.budget.50kTo150k') },
  { value: 'over-150k', label: t('contact.form.budget.over150k') },
];

const hotelBudgetRanges = [
  { value: 'under-500', label: t('contact.form.hotelBudget.under500') },
  { value: '500-1500', label: t('contact.form.hotelBudget.500To1500') },
  { value: '1500-5000', label: t('contact.form.hotelBudget.1500To5000') },
  { value: 'over-5000', label: t('contact.form.hotelBudget.over5000') },
];

// Personal phone lines and unconfirmed WeChat/WhatsApp/hours placeholders
// are intentionally not shown — email is the single public contact channel.
const infoRows = [{ label: t('contact.info.email'), value: 'contact@myvipservice.com' }];
---

<BaseLayout
  title={t('nav.contact')}
  description="MYVIPSERVICE — get in touch to start planning your trip."
  path="contact"
>
  <PageHero
    eyebrow={t('contact.hero.eyebrow')}
    title={t('contact.hero.title')}
    subtitle={t('contact.hero.subtitle')}
  />

  <section class="section contact">
    <div class="container contact__grid">
      <div class="contact__info">
        <dl>
          {
            infoRows.map((row) => (
              <div class="contact__info-row">
                <dt class="text-small">{row.label}</dt>
                <dd class="text-small">{row.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <form
        class="contact__form"
        id="contact-form"
        name="contact"
        method="POST"
        data-netlify="true"
        data-netlify-honeypot="bot-field"
        novalidate
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="visually-hidden">
          <label>
            Leave this field blank: <input name="bot-field" tabindex="-1" autocomplete="off" />
          </label>
        </p>

        <h2>{t('contact.form.heading')}</h2>

        <fieldset>
          <legend>{t('contact.form.enquiryType')}</legend>
          {
            enquiryTypes.map((type, index) => (
              <label class="radio-label" for={`enquiry-${type.value}`}>
                <input
                  type="radio"
                  id={`enquiry-${type.value}`}
                  name="enquiryType"
                  value={type.value}
                  checked={index === 0}
                />
                {type.label}
              </label>
            ))
          }
        </fieldset>

        <div class="field">
          <label for="name">{t('contact.form.name')}</label>
          <input type="text" id="name" name="name" autocomplete="name" required />
        </div>

        <div class="field">
          <label for="email">{t('contact.form.email')}</label>
          <input type="email" id="email" name="email" autocomplete="email" required />
        </div>

        <div class="field">
          <label for="phoneWechat">
            {t('contact.form.phoneWechat')}
            <span class="text-small">({t('common.optional')})</span>
          </label>
          <input type="text" id="phoneWechat" name="phoneWechat" autocomplete="tel" />
        </div>

        <div class="field">
          <label for="destination">
            {t('contact.form.destination')}
            <span class="text-small">({t('common.optional')})</span>
          </label>
          <input type="text" id="destination" name="destination" />
        </div>

        <fieldset class="field-group">
          <legend>
            {t('contact.form.dates')}
            <span class="text-small">({t('common.optional')})</span>
          </legend>
          <div class="field-group__row">
            <div class="field">
              <label for="dateStart">{t('contact.form.dateStart')}</label>
              <input type="date" id="dateStart" name="dateStart" />
            </div>
            <div class="field">
              <label for="dateEnd">{t('contact.form.dateEnd')}</label>
              <input type="date" id="dateEnd" name="dateEnd" />
            </div>
          </div>
        </fieldset>

        <div class="field">
          <label for="travellers">
            {t('contact.form.travellers')}
            <span class="text-small">({t('common.optional')})</span>
          </label>
          <input type="number" id="travellers" name="travellers" min="1" step="1" />
        </div>

        <div class="field">
          <label for="budget">
            {t('contact.form.budget')}
            <span class="text-small">({t('common.optional')})</span>
          </label>
          <select id="budget" name="budget">
            <option value="">{t('contact.form.budgetPlaceholder')}</option>
            {budgetRanges.map((range) => <option value={range.value}>{range.label}</option>)}
          </select>
        </div>

        <div class="field">
          <label for="hotelBudget">
            {t('contact.form.hotelBudget')}
            <span class="text-small">({t('common.optional')})</span>
          </label>
          <select id="hotelBudget" name="hotelBudget">
            <option value="">{t('contact.form.hotelBudgetPlaceholder')}</option>
            {hotelBudgetRanges.map((range) => <option value={range.value}>{range.label}</option>)}
          </select>
        </div>

        <div class="field">
          <label for="details">{t('contact.form.details')}</label>
          <textarea id="details" name="details" rows="5" required></textarea>
        </div>

        <button class="button button--primary" type="submit">{t('contact.form.submit')}</button>
        <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</BaseLayout>

<script
  is:inline
  define:vars={{ successMessage: t('contact.form.success'), errorMessage: t('contact.form.error') }}
>
  const form = document.getElementById('contact-form');
  const status = document.getElementById('form-status');

  function encodeFormData(data) {
    return Object.keys(data)
      .map((key) => encodeURIComponent(key) + '=' + encodeURIComponent(data[key]))
      .join('&');
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = Object.fromEntries(new FormData(form).entries());
    fetch('/', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: encodeFormData(data),
    })
      .then(() => {
        if (status) status.textContent = successMessage;
        form.reset();
      })
      .catch(() => {
        if (status) status.textContent = errorMessage;
      });
  });
</script>

<style>
  .contact__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    /* Grid items default to a content-based min-width that can overflow a
       narrow track (the classic "min-width: auto" issue) — reset it. */
    min-width: 0;
  }

  .contact__grid > * {
    min-width: 0;
  }

  .contact__info dl {
    margin: 0;
  }

  .contact__info-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }

  .contact__info-row dt {
    color: var(--color-text-muted);
  }

  .contact__info-row dd {
    margin: 0;
    color: var(--color-text);
  }

  .field {
    margin-bottom: var(--space-4);
  }

  .field-group {
    margin-bottom: var(--space-4);
  }

  .field-group__row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--space-3);
  }

  .radio-label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-body);
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }

  .radio-label input {
    width: auto;
  }

  .form-status {
    margin-top: var(--space-3);
    color: var(--color-success);
  }

  @media (min-width: 900px) {
    .contact__grid {
      grid-template-columns: 1fr 1.4fr;
    }
  }
</style>
