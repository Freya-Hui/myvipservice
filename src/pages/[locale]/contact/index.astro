---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import StoryFeature from '../../../components/about/StoryFeature.astro';
import ProcessSteps from '../../../components/home/ProcessSteps.astro';
import { languages, useTranslations, type Locale } from '../../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);

// Aligned to the real service lines (same taxonomy as the Services page
// grouping) instead of a generic general/travel split, so an enquiry tells
// the team what kind of request it actually is.
const enquiryTypes = [
  { value: 'private-travel', label: t('servicesGroup.Private Travel') },
  { value: 'hotels-villas', label: t('servicesGroup.Hotels & Villas') },
  { value: 'private-transportation', label: t('servicesGroup.Private Transportation') },
  { value: 'concierge-lifestyle', label: t('servicesGroup.Concierge & Lifestyle') },
  { value: 'groups-corporate', label: t('servicesGroup.Groups & Corporate') },
];

// A real sequence (submit -> review -> proposal -> arrange), not a
// "why choose us" list, so numbered steps are honest here.
const processSteps = [
  { title: t('contact.process.step1.title'), description: t('contact.process.step1.description') },
  { title: t('contact.process.step2.title'), description: t('contact.process.step2.description') },
  { title: t('contact.process.step3.title'), description: t('contact.process.step3.description') },
  { title: t('contact.process.step4.title'), description: t('contact.process.step4.description') },
];

// Ranges rather than free text — the client wants budget to qualify
// enquiries up front, not just describe them.
const budgetRanges = [
  { value: 'under-5k', label: t('contact.form.budget.under5k') },
  { value: '5k-15k', label: t('contact.form.budget.5kTo15k') },
  { value: '15k-50k', label: t('contact.form.budget.15kTo50k') },
  { value: '50k-150k', label: t('contact.form.budget.50kTo150k') },
  { value: 'over-150k', label: t('contact.form.budget.over150k') },
];

const hotelBudgetRanges = [
  { value: 'under-500', label: t('contact.form.hotelBudget.under500') },
  { value: '500-1500', label: t('contact.form.hotelBudget.500To1500') },
  { value: '1500-5000', label: t('contact.form.hotelBudget.1500To5000') },
  { value: 'over-5000', label: t('contact.form.hotelBudget.over5000') },
];

// Lets the team see which channel is actually driving enquiries — optional,
// so it doesn't block submission for a visitor who'd rather not say.
const referralSources = [
  { value: 'wechat', label: t('contact.form.referralSource.wechat') },
  { value: 'xiaohongshu', label: t('contact.form.referralSource.xiaohongshu') },
  { value: 'instagram', label: t('contact.form.referralSource.instagram') },
  { value: 'referral', label: t('contact.form.referralSource.referral') },
  { value: 'search', label: t('contact.form.referralSource.search') },
  { value: 'other', label: t('contact.form.referralSource.other') },
];

// Personal phone lines and unconfirmed WeChat/WhatsApp/hours placeholders
// are intentionally not shown — email is the single public contact channel.
const contactEmail = 'contact@myvipservice.com';
---

<BaseLayout
  title={t('nav.contact')}
  description="MYVIPSERVICE — get in touch to start planning your trip."
  path="contact"
>
  <PageHero
    eyebrow={t('contact.hero.eyebrow')}
    title={t('contact.hero.title')}
    subtitle={t('contact.hero.subtitle')}
  />

  <section class="section contact">
    <div class="container">
      <div class="contact__reach">
        <p class="contact__email text-small">
          {t('contact.info.email')}: <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
        </p>
        <p class="text-small">{t('contact.info.reach')}</p>
      </div>

      <form
        class="contact__form"
        id="contact-form"
        name="contact"
        method="POST"
        data-netlify="true"
        data-netlify-honeypot="bot-field"
        novalidate
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="visually-hidden">
          <label>
            Leave this field blank: <input name="bot-field" tabindex="-1" autocomplete="off" />
          </label>
        </p>

        <h2>{t('contact.form.heading')}</h2>

        <div class="contact__layout">
          <div class="contact__main">
            <div class="form-section" id="contact-step-1">
              <fieldset>
                <legend>{t('contact.form.enquiryType')}</legend>
                <div class="radio-grid">
                  {
                    enquiryTypes.map((type, index) => (
                      <label class="radio-label" for={`enquiry-${type.value}`}>
                        <input
                          type="radio"
                          id={`enquiry-${type.value}`}
                          name="enquiryType"
                          value={type.value}
                          checked={index === 0}
                        />
                        {type.label}
                      </label>
                    ))
                  }
                </div>
              </fieldset>

              <div class="field">
                <label for="name">{t('contact.form.name')}</label>
                <input type="text" id="name" name="name" autocomplete="name" required />
              </div>

              <div class="field">
                <label for="email">{t('contact.form.email')}</label>
                <input type="email" id="email" name="email" autocomplete="email" required />
              </div>

              <div class="field">
                <label for="phoneWechat">
                  {t('contact.form.phoneWechat')}
                  <span class="text-small">({t('common.optional')})</span>
                </label>
                <input type="text" id="phoneWechat" name="phoneWechat" autocomplete="tel" />
              </div>

              <div class="field">
                <label for="referralSource">
                  {t('contact.form.referralSource')}
                  <span class="text-small">({t('common.optional')})</span>
                </label>
                <select id="referralSource" name="referralSource">
                  <option value="">{t('contact.form.referralSourcePlaceholder')}</option>
                  {
                    referralSources.map((source) => (
                      <option value={source.value}>{source.label}</option>
                    ))
                  }
                </select>
              </div>
            </div>

            <div class="form-section" id="contact-step-2" hidden>
              <div class="field">
                <label for="destination">{t('contact.form.destination')}</label>
                <input type="text" id="destination" name="destination" required />
              </div>

              <fieldset class="field-group">
                <legend>{t('contact.form.dates')}</legend>
                <div class="field-group__row">
                  <div class="field">
                    <label for="dateStart">{t('contact.form.dateStart')}</label>
                    <input type="date" id="dateStart" name="dateStart" required />
                  </div>
                  <div class="field">
                    <label for="dateEnd">{t('contact.form.dateEnd')}</label>
                    <input type="date" id="dateEnd" name="dateEnd" required />
                  </div>
                </div>
              </fieldset>

              <div class="field">
                <label for="travellers">
                  {t('contact.form.travellers')}
                  <span class="text-small">({t('common.optional')})</span>
                </label>
                <input type="number" id="travellers" name="travellers" min="1" step="1" />
              </div>

              <div class="field">
                <label for="budget">{t('contact.form.budget')}</label>
                <select id="budget" name="budget" required>
                  <option value="">{t('contact.form.budgetPlaceholder')}</option>
                  {budgetRanges.map((range) => <option value={range.value}>{range.label}</option>)}
                </select>
              </div>
            </div>

            <div class="form-section" id="contact-step-3" hidden>
              <div class="field">
                <label for="hotelBudget">
                  {t('contact.form.hotelBudget')}
                  <span class="text-small">({t('common.optional')})</span>
                </label>
                <select id="hotelBudget" name="hotelBudget">
                  <option value="">{t('contact.form.hotelBudgetPlaceholder')}</option>
                  {
                    hotelBudgetRanges.map((range) => (
                      <option value={range.value}>{range.label}</option>
                    ))
                  }
                </select>
              </div>

              <div class="field">
                <label for="details">{t('contact.form.details')}</label>
                <textarea id="details" name="details" rows="5" required></textarea>
              </div>
            </div>
          </div>

          <div class="contact__side">
            <p class="contact__stepIndicator" id="contact-step-indicator">
              {t('contact.form.step1Of3')}
            </p>

            <div class="contact__summary" id="contact-summary">
              <p class="contact__summaryTitle">{t('carBooking.summaryTitle')}</p>
              <dl class="contact__summaryList" id="contact-summary-list"></dl>
            </div>

            <div class="contact__actions">
              <button type="button" class="button button--quiet" id="contact-back-button" hidden
                >{t('carBooking.backButton')}</button
              >
              <button type="button" class="button button--primary" id="contact-next-button"
                >{t('hotelEnquiry.nextButton')}</button
              >
              <button class="button button--primary" type="submit" id="contact-submit-button" hidden
                >{t('contact.form.submit')}</button
              >
            </div>
            <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
          </div>
        </div>
      </form>

      <div class="contact__other">
        <h2 class="text-h4">{t('contact.other.heading')}</h2>
        <dl class="contact__other-list">
          <div>
            <dt>{t('contact.section.partnership')}</dt>
            <dd>{t('contact.section.partnershipBody')}</dd>
          </div>
          <div>
            <dt>{t('contact.section.media')}</dt>
            <dd>{t('contact.section.mediaBody')}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <StoryFeature
    eyebrow={t('contact.intro.eyebrow')}
    title={t('contact.intro.title')}
    body={t('contact.intro.body')}
    imageId="service-reception-desk-call"
    locale={locale}
    compact
  />

  <ProcessSteps
    eyebrow={t('contact.process.eyebrow')}
    title={t('contact.process.title')}
    steps={processSteps}
  />
</BaseLayout>

<script
  is:inline
  define:vars={{
    successMessage: t('contact.form.success'),
    errorMessage: t('contact.form.error'),
    aboutPrefix: t('contact.form.aboutPrefix'),
    step1Label: t('contact.form.step1Of3'),
    step2Label: t('contact.form.step2Of3'),
    step3Label: t('contact.form.step3Of3'),
    enquiryTypes,
    enquiryTypeLabelText: t('contact.form.enquiryType'),
    destinationLabelText: t('contact.form.destination'),
    dateStartLabelText: t('contact.form.dateStart'),
    dateEndLabelText: t('contact.form.dateEnd'),
    travellersLabelText: t('contact.form.travellers'),
    budgetLabelText: t('contact.form.budget'),
    hotelBudgetLabelText: t('contact.form.hotelBudget'),
  }}
>
  const form = document.getElementById('contact-form');
  const status = document.getElementById('form-status');
  const stepIndicator = document.getElementById('contact-step-indicator');
  const steps = [
    document.getElementById('contact-step-1'),
    document.getElementById('contact-step-2'),
    document.getElementById('contact-step-3'),
  ];
  const stepLabels = [step1Label, step2Label, step3Label];
  const nextButton = document.getElementById('contact-next-button');
  const backButton = document.getElementById('contact-back-button');
  const submitButton = document.getElementById('contact-submit-button');
  const enquiryTypeInputs = form.querySelectorAll('input[name="enquiryType"]');
  const destinationInput = document.getElementById('destination');
  const dateStartInput = document.getElementById('dateStart');
  const dateEndInput = document.getElementById('dateEnd');
  const travellersInput = document.getElementById('travellers');
  const budgetSelect = document.getElementById('budget');
  const hotelBudgetSelect = document.getElementById('hotelBudget');
  const summaryList = document.getElementById('contact-summary-list');

  let current = 0;

  // Detail pages link here with ?about=<page title> so a visitor asking
  // about a specific hotel/destination/service doesn't have to retype it.
  const about = new URLSearchParams(location.search).get('about');
  const detailsField = document.getElementById('details');
  if (about && detailsField && !detailsField.value) {
    detailsField.value = `${aboutPrefix}${about}\n\n`;
  }

  // Mirrors the selections shown, not raw contact info (name/email/phone
  // aren't shown here either) — same convention as the booking widgets'
  // own "Your Selection" summaries.
  function updateSummary() {
    if (!summaryList) return;
    const rows = [];
    const selectedType = [...enquiryTypeInputs].find((input) => input.checked);
    const typeMatch =
      selectedType && enquiryTypes.find((type) => type.value === selectedType.value);
    if (typeMatch) rows.push([enquiryTypeLabelText, typeMatch.label]);
    if (destinationInput.value) rows.push([destinationLabelText, destinationInput.value]);
    if (dateStartInput.value) rows.push([dateStartLabelText, dateStartInput.value]);
    if (dateEndInput.value) rows.push([dateEndLabelText, dateEndInput.value]);
    if (travellersInput.value) rows.push([travellersLabelText, travellersInput.value]);
    const budgetOption = budgetSelect.options[budgetSelect.selectedIndex];
    if (budgetSelect.value && budgetOption) rows.push([budgetLabelText, budgetOption.textContent]);
    const hotelBudgetOption = hotelBudgetSelect.options[hotelBudgetSelect.selectedIndex];
    if (hotelBudgetSelect.value && hotelBudgetOption) {
      rows.push([hotelBudgetLabelText, hotelBudgetOption.textContent]);
    }
    summaryList.innerHTML = rows
      .map(([k, v]) => `<div class="contact__summaryRow"><dt>${k}</dt><dd>${v}</dd></div>`)
      .join('');
  }

  enquiryTypeInputs.forEach((input) => input.addEventListener('change', updateSummary));
  [destinationInput, dateStartInput, dateEndInput, travellersInput].forEach((el) => {
    el.addEventListener('input', updateSummary);
    el.addEventListener('change', updateSummary);
  });
  budgetSelect.addEventListener('change', updateSummary);
  hotelBudgetSelect.addEventListener('change', updateSummary);

  function showStep(index) {
    steps.forEach((panel, i) => (panel.hidden = i !== index));
    stepIndicator.textContent = stepLabels[index];
    backButton.hidden = index === 0;
    nextButton.hidden = index === steps.length - 1;
    submitButton.hidden = index !== steps.length - 1;
    form.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  nextButton?.addEventListener('click', () => {
    // The hidden attribute doesn't stop constraint validation, so scope the
    // check to the current step's own fields rather than the whole (mostly
    // still-hidden) form — novalidate on <form> only suppresses the
    // automatic submit-time check, not this explicit one.
    const invalid = steps[current].querySelector(':invalid');
    if (invalid) {
      invalid.reportValidity();
      return;
    }
    current = Math.min(current + 1, steps.length - 1);
    showStep(current);
  });

  backButton?.addEventListener('click', () => {
    current = Math.max(current - 1, 0);
    showStep(current);
  });

  function encodeFormData(data) {
    return Object.keys(data)
      .map((key) => encodeURIComponent(key) + '=' + encodeURIComponent(data[key]))
      .join('&');
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const invalid = steps[current].querySelector(':invalid');
    if (invalid) {
      invalid.reportValidity();
      return;
    }
    const data = Object.fromEntries(new FormData(form).entries());
    fetch('/', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: encodeFormData(data),
    })
      .then(() => {
        if (status) status.textContent = successMessage;
        form.reset();
        current = 0;
        showStep(current);
        updateSummary();
      })
      .catch(() => {
        if (status) status.textContent = errorMessage;
      });
  });

  showStep(current);
  updateSummary();
</script>

<style>
  .contact__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 56rem) {
    .contact__layout {
      grid-template-columns: 1fr 20rem;
      align-items: start;
    }

    .contact__side {
      position: sticky;
      top: var(--space-5);
    }
  }

  .contact__side {
    padding: var(--space-4);
    background: var(--color-bg-inset);
    border-radius: var(--radius);
  }

  .contact__summary {
    padding-bottom: var(--space-3);
    margin-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .contact__summary:empty,
  .contact__summaryList:empty {
    display: none;
  }

  .contact__summaryTitle {
    font-size: var(--text-small);
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .contact__summaryList {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin: 0;
  }

  /* Built client-side via innerHTML (see updateSummary() in the script
     above), so these rows never get Astro's scoping attribute — :global()
     is required for the styles to reach them. */
  :global(.contact__summaryRow) {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    font-size: var(--text-small);
  }

  :global(.contact__summaryRow dt) {
    color: var(--color-text-muted);
  }

  :global(.contact__summaryRow dd) {
    margin: 0;
    text-align: right;
  }

  .contact__reach {
    color: var(--color-text-muted);
    margin-bottom: var(--space-5);
  }

  .contact__reach p + p {
    margin-top: var(--space-1);
  }

  .contact__email a {
    color: var(--color-text);
  }

  .form-section {
    padding-top: var(--space-5);
    margin-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .form-section:first-of-type {
    padding-top: 0;
    margin-top: var(--space-5);
    border-top: none;
  }

  .contact__stepIndicator {
    color: var(--color-text-muted);
    font-size: var(--text-small);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: var(--space-4);
  }

  .contact__actions {
    display: flex;
    gap: var(--space-3);
  }

  .contact__actions .button {
    flex: 1;
  }

  .contact__actions .button[hidden] {
    display: none;
  }

  .field {
    margin-bottom: var(--space-4);
  }

  .field-group {
    margin-bottom: var(--space-4);
  }

  .field-group__row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--space-3);
  }

  .radio-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    column-gap: var(--space-4);
  }

  .radio-label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-body);
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }

  .radio-label input {
    width: auto;
  }

  .form-status {
    margin-top: var(--space-3);
    color: var(--color-success);
  }

  .contact__other {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .contact__other-list {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-3);
  }

  .contact__other-list dt {
    font-family: var(--font-display);
    font-size: var(--text-body-lg);
    margin-bottom: var(--space-1);
  }

  .contact__other-list dd {
    color: var(--color-text-muted);
    margin-left: 0;
  }

  @media (min-width: 640px) {
    .contact__other-list {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-5);
    }
  }
</style>
