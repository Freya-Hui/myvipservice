---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/home/Hero.astro';
import StoryFeature from '../../components/about/StoryFeature.astro';
import RelatedContent from '../../components/RelatedContent.astro';
import AccommodationFeature from '../../components/home/AccommodationFeature.astro';
import TravelTypes from '../../components/home/TravelTypes.astro';
import ConciergeOverview from '../../components/home/ConciergeOverview.astro';
import ProcessSteps from '../../components/home/ProcessSteps.astro';
import JournalPreview from '../../components/home/JournalPreview.astro';
import InquiryCTA from '../../components/home/InquiryCTA.astro';
import { getLocaleEntries } from '../../lib/content';
import { languages, useTranslations, type Locale } from '../../i18n/ui';
import { travelTypes, whyUsPoints, destinationCountryGroups } from '../../data/site-content';

export function getStaticPaths() {
  return Object.keys(languages).map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);

function bySlug(entries: CollectionEntry<'services'>[], slug: string) {
  const entry = entries.find((item) => item.id === `${locale}/${slug}`);
  if (!entry) throw new Error(`Missing services entry "${slug}" for locale "${locale}"`);
  return entry.data;
}

const services = (
  await getCollection('services', (entry) => entry.id.startsWith(`${locale}/`))
).sort((a, b) => a.data.order - b.data.order);
const destinations = await getLocaleEntries('destinations', locale);
// France first, then the rest of Europe — same priority order as the
// Destinations list page's country grouping, so both pages agree.
const destinationPriority = destinationCountryGroups.flatMap((group) => group.translationKeys);
const featuredDestinations = destinations
  .filter((entry) => entry.data.featured)
  .sort(
    (a, b) =>
      destinationPriority.indexOf(a.data.translationKey) -
      destinationPriority.indexOf(b.data.translationKey),
  );
const journalEntries = (await getLocaleEntries('journal', locale))
  .sort((a, b) => (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0))
  .slice(0, 3);
const experiences = (await getLocaleEntries('experiences', locale)).filter(
  (entry) => entry.data.featured,
);

const hotelsService = bySlug(services, 'hotel-villa-reservations');
const conciergeService = bySlug(services, 'personal-concierge');
---

<BaseLayout
  title={t('nav.home')}
  description="MYVIPSERVICE — private concierge and bespoke travel, based in Paris."
  path=""
>
  <Hero
    eyebrow={t('home.hero.eyebrow')}
    tagline={t('home.hero.tagline')}
    ctaLabel={t('common.cta')}
    ctaHref={`/${locale}/contact/`}
    locale={locale}
  />

  <StoryFeature
    eyebrow={t('home.intro.eyebrow')}
    title={t('home.intro.title')}
    body={t('home.intro.body')}
    imageId="service-concierge"
    locale={locale}
  />

  <ProcessSteps
    eyebrow={t('home.whyUs.eyebrow')}
    title={t('home.whyUs.title')}
    steps={whyUsPoints[locale]}
  />

  <TravelTypes
    eyebrow={t('home.travelTypes.eyebrow')}
    title={t('home.travelTypes.title')}
    subtitle={t('home.travelTypes.subtitle')}
    items={travelTypes[locale].filter((item) => item.featured).sort((a, b) => a.order - b.order)}
    ctaLabel={t('home.travelTypes.cta')}
    ctaHref={`/${locale}/contact/`}
  />

  <RelatedContent
    locale={locale}
    eyebrow={t('home.destinations.eyebrow')}
    title={t('home.destinations.title')}
    items={featuredDestinations.map((entry) => ({
      href: `/${locale}/destinations/${entry.data.slug}/`,
      imageId: entry.data.coverImage,
      eyebrow: t(`region.${entry.data.region}` as never),
      title: entry.data.title,
      summary: entry.data.description,
      draftLabel: entry.data.draft ? t('badge.draftTranslation') : undefined,
    }))}
  />

  <RelatedContent
    locale={locale}
    eyebrow={t('home.experience.eyebrow')}
    title={t('home.experience.title')}
    items={experiences.map((entry) => ({
      href: `/${locale}/experiences/${entry.data.slug}/`,
      imageId: entry.data.coverImage,
      eyebrow: t(`category.${entry.data.category}` as never),
      title: entry.data.title,
      summary: entry.data.description,
      draftLabel: entry.data.draft ? t('badge.draftTranslation') : undefined,
    }))}
  />

  <AccommodationFeature
    eyebrow={t('home.hotels.eyebrow')}
    title={hotelsService.title}
    body={hotelsService.summary}
    ctaLabel={t('home.hotels.cta')}
    ctaHref={`/${locale}/accommodations/`}
    imageId="service-hotels-villas"
    locale={locale}
  />

  <ConciergeOverview
    eyebrow={t('home.concierge.eyebrow')}
    title={t('home.concierge.title')}
    body={conciergeService.summary}
    ctaLabel={t('home.concierge.cta')}
    ctaHref={`/${locale}/services/#personal-concierge`}
  />

  <JournalPreview
    eyebrow={t('home.journal.eyebrow')}
    title={t('home.journal.title')}
    entries={journalEntries.map((entry) => ({
      href: `/${locale}/journal/${entry.data.slug}/`,
      title: entry.data.title,
      summary: entry.data.excerpt,
      coverImage: entry.data.coverImage,
    }))}
    emptyNote={t('journal.emptyState')}
    viewAllLabel={t('journal.viewAll')}
    viewAllHref={`/${locale}/journal/`}
    locale={locale}
  />

  <InquiryCTA
    title={t('home.inquiry.title')}
    body={t('home.inquiry.body')}
    ctaLabel={t('home.inquiry.cta')}
    ctaHref={`/${locale}/contact/`}
  />
</BaseLayout>
