---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import ContentGrid from '../../../components/ContentGrid.astro';
import ContentCard from '../../../components/ContentCard.astro';
import EmptyState from '../../../components/EmptyState.astro';
import InquiryCTA from '../../../components/home/InquiryCTA.astro';
import { getLocaleEntries } from '../../../lib/content';
import { languages, useTranslations, type Locale } from '../../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);

const CATEGORIES = [
  'Art & Culture',
  'Food & Wine',
  'Family',
  'Wellness',
  'Nature',
  'Fashion',
  'Celebration',
  'Private Access',
] as const;

const all = await getLocaleEntries('experiences', locale);
const featured = all.filter((entry) => entry.data.featured);

function toCard(entry: (typeof all)[number]) {
  return {
    href: `/${locale}/experiences/${entry.data.slug}/`,
    imageId: entry.data.coverImage,
    eyebrow: t(`category.${entry.data.category}` as never),
    title: entry.data.title,
    summary: entry.data.description,
    draftLabel: entry.data.draft ? t('badge.draftTranslation') : undefined,
  };
}
---

<BaseLayout
  title={t('experiences.hero.title')}
  description="MYVIPSERVICE — private experiences we use to test the experience template."
  path="experiences"
>
  <div class="container">
    <Breadcrumbs
      items={[
        { label: t('nav.home'), href: `/${locale}/` },
        { label: t('experiences.hero.title') },
      ]}
    />
  </div>

  <PageHero
    eyebrow={t('experiences.hero.eyebrow')}
    title={t('experiences.hero.title')}
    subtitle={t('experiences.hero.subtitle')}
  />

  {
    all.length === 0 ? (
      <div class="container">
        <EmptyState message={t('experiences.emptyState')} />
      </div>
    ) : (
      <Fragment>
        {featured.length > 0 && (
          <section class="section">
            <div class="container">
              <SectionHeading
                eyebrow={t('experiences.hero.eyebrow')}
                title={t('experiences.featuredHeading')}
              />
              <ContentGrid>
                {featured.map((entry) => (
                  <ContentCard {...toCard(entry)} locale={locale} />
                ))}
              </ContentGrid>
            </div>
          </section>
        )}

        {CATEGORIES.map((category) => {
          const entries = all.filter((entry) => entry.data.category === category);
          return (
            entries.length > 0 && (
              <section class="section">
                <div class="container">
                  <SectionHeading
                    eyebrow={t('experiences.hero.eyebrow')}
                    title={t(`category.${category}` as never)}
                  />
                  <ContentGrid>
                    {entries.map((entry) => (
                      <ContentCard {...toCard(entry)} locale={locale} />
                    ))}
                  </ContentGrid>
                </div>
              </section>
            )
          );
        })}
      </Fragment>
    )
  }

  <InquiryCTA
    title={t('home.inquiry.title')}
    body={t('home.inquiry.body')}
    ctaLabel={t('common.cta')}
    ctaHref={`/${locale}/contact/`}
  />
</BaseLayout>
