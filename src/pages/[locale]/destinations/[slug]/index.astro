---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PageHero from '../../../../components/PageHero.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import Gallery from '../../../../components/Gallery.astro';
import SectionHeading from '../../../../components/SectionHeading.astro';
import ContentSection from '../../../../components/ContentSection.astro';
import KeyFacts from '../../../../components/KeyFacts.astro';
import RelatedContent from '../../../../components/RelatedContent.astro';
import ContentStatusBadge from '../../../../components/ContentStatusBadge.astro';
import InquiryCTA from '../../../../components/home/InquiryCTA.astro';
import {
  getDetailStaticPaths,
  resolveRelated,
  getRelatedDestinations,
  getEntriesByDestination,
} from '../../../../lib/content';
import { useTranslations, type Locale } from '../../../../i18n/ui';

export const getStaticPaths = () => getDetailStaticPaths('destinations');

const { locale } = Astro.params as { locale: Locale };
const { entry } = Astro.props as Awaited<ReturnType<typeof getDetailStaticPaths>>[number]['props'];
const { data } = entry;
const t = useTranslations(locale);

// Merge the manually curated list with a reverse lookup by the item's own
// destinationKey — the manual list drifts out of sync as new accommodations/
// experiences are added (it did: several real experiences never made it
// onto their destination's list), so the reverse lookup is the safety net.
function dedupeByTranslationKey<T extends { data: { translationKey: string } }>(entries: T[]): T[] {
  const seen = new Set<string>();
  return entries.filter((entry) => {
    if (seen.has(entry.data.translationKey)) return false;
    seen.add(entry.data.translationKey);
    return true;
  });
}

const [
  accommodationsManual,
  accommodationsByDestination,
  experiencesManual,
  experiencesByDestination,
] = await Promise.all([
  resolveRelated('accommodations', locale, data.relatedAccommodationKeys, data.translationKey),
  getEntriesByDestination('accommodations', locale, data.translationKey),
  resolveRelated('experiences', locale, data.relatedExperienceKeys, data.translationKey),
  getEntriesByDestination('experiences', locale, data.translationKey),
]);
const accommodations = dedupeByTranslationKey([
  ...accommodationsManual,
  ...accommodationsByDestination,
]);
const experiences = dedupeByTranslationKey([...experiencesManual, ...experiencesByDestination]);
const relatedDestinations = await getRelatedDestinations(locale, data.translationKey, data.region);
const journalArticles = await resolveRelated('journal', locale, data.relatedJournalKeys);

const keyFacts = [
  ...(data.bestTime
    ? [{ label: t('destinations.detail.bestTimeLabel'), value: data.bestTime }]
    : []),
  ...(data.suggestedStay
    ? [{ label: t('destinations.detail.suggestedStayLabel'), value: data.suggestedStay }]
    : []),
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'TouristDestination',
    name: data.title,
    description: data.description,
    url: new URL(`/${locale}/destinations/${data.slug}/`, Astro.site).toString(),
  },
];
---

<BaseLayout
  title={data.title}
  description={data.seoDescription ?? data.description}
  path={`destinations/${data.slug}`}
  imageId={data.coverImage}
  structuredData={structuredData}
  translationContext={{ collection: 'destinations', translationKey: data.translationKey }}
>
  <div class="container">
    <Breadcrumbs
      items={[
        { label: t('nav.home'), href: `/${locale}/` },
        { label: t('nav.destinations'), href: `/${locale}/destinations/` },
        { label: data.title },
      ]}
    />
  </div>

  <PageHero eyebrow={t(`region.${data.region}` as never)} title={data.title} />
  {
    data.draft && (
      <div class="container">
        <ContentStatusBadge tone="draft" label={t('badge.draftTranslation')} />
      </div>
    )
  }

  <div class="container">
    <Gallery images={data.gallery.length > 0 ? data.gallery : [data.coverImage]} locale={locale} />
  </div>

  <ContentSection title={t('destinations.detail.overviewTitle')} body={data.description} />

  {
    data.highlights.length > 0 && (
      <section class="section">
        <div class="container prose">
          <SectionHeading
            eyebrow={t('destinations.hero.eyebrow')}
            title={t('destinations.detail.whyVisitTitle')}
          />
          <ul class="highlight-list">
            {data.highlights.map((item: string) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    keyFacts.length > 0 && (
      <section class="section">
        <div class="container">
          <KeyFacts facts={keyFacts} />
        </div>
      </section>
    )
  }

  <RelatedContent
    locale={locale}
    eyebrow={t('destinations.hero.eyebrow')}
    title={t('destinations.detail.accommodationsHeading')}
    items={accommodations.map((item) => ({
      href: `/${locale}/accommodations/${item.data.slug}/`,
      imageId: item.data.coverImage,
      eyebrow: t(`type.${item.data.type}` as never),
      title: item.data.title,
      summary: item.data.description,
      draftLabel: item.data.draft ? t('badge.draftTranslation') : undefined,
    }))}
  />

  <RelatedContent
    locale={locale}
    eyebrow={t('destinations.hero.eyebrow')}
    title={t('destinations.detail.experiencesHeading')}
    items={experiences.map((item) => ({
      href: `/${locale}/experiences/${item.data.slug}/`,
      imageId: item.data.coverImage,
      eyebrow: t(`category.${item.data.category}` as never),
      title: item.data.title,
      summary: item.data.description,
      draftLabel: item.data.draft ? t('badge.draftTranslation') : undefined,
    }))}
  />

  {
    data.travelNotes && (
      <ContentSection title={t('destinations.detail.travelNotesTitle')} body={data.travelNotes} />
    )
  }

  <RelatedContent
    locale={locale}
    eyebrow={t('destinations.hero.eyebrow')}
    title={t('destinations.detail.journalHeading')}
    items={journalArticles.map((item) => ({
      href: `/${locale}/journal/${item.data.slug}/`,
      imageId: item.data.coverImage,
      eyebrow: t(`journalCategory.${item.data.category}` as never),
      title: item.data.title,
      summary: item.data.excerpt,
      draftLabel: item.data.draft ? t('badge.draftTranslation') : undefined,
    }))}
  />

  <RelatedContent
    locale={locale}
    eyebrow={t('destinations.hero.eyebrow')}
    title={t('destinations.detail.relatedHeading')}
    items={relatedDestinations.map((item) => ({
      href: `/${locale}/destinations/${item.data.slug}/`,
      imageId: item.data.coverImage,
      eyebrow: t(`region.${item.data.region}` as never),
      title: item.data.title,
      summary: item.data.description,
      draftLabel: item.data.draft ? t('badge.draftTranslation') : undefined,
    }))}
  />

  <section class="section">
    <div class="container prose">
      <SectionHeading
        eyebrow={t('destinations.hero.eyebrow')}
        title={t('destinations.detail.whyUsTitle')}
      />
      <ul class="highlight-list">
        <li>{t('destinations.detail.whyUsPoint1')}</li>
        <li>{t('destinations.detail.whyUsPoint2')}</li>
        <li>{t('destinations.detail.whyUsPoint3')}</li>
        <li>{t('destinations.detail.whyUsPoint4')}</li>
      </ul>
    </div>
  </section>

  <InquiryCTA
    title={t('home.inquiry.title')}
    body={t('home.inquiry.body')}
    ctaLabel={t('common.cta')}
    ctaHref={`/${locale}/contact/`}
  />
</BaseLayout>

<style>
  .highlight-list {
    color: var(--color-text-muted);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
</style>
