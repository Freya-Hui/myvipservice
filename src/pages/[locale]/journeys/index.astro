---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ContentGrid from '../../../components/ContentGrid.astro';
import ContentCard from '../../../components/ContentCard.astro';
import EmptyState from '../../../components/EmptyState.astro';
import InquiryCTA from '../../../components/home/InquiryCTA.astro';
import { getLocaleEntries } from '../../../lib/content';
import { languages, useTranslations, type Locale } from '../../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);

const journeys = await getLocaleEntries('journeys', locale);
---

<BaseLayout
  title={t('journeys.hero.title')}
  description="MYVIPSERVICE — themed journeys across Europe, each built from real experiences we can arrange."
  path="journeys"
>
  <div class="container">
    <Breadcrumbs
      items={[{ label: t('nav.home'), href: `/${locale}/` }, { label: t('journeys.hero.title') }]}
    />
  </div>

  <PageHero
    eyebrow={t('journeys.hero.eyebrow')}
    title={t('journeys.hero.title')}
    subtitle={t('journeys.hero.subtitle')}
  />

  <section class="section">
    <div class="container">
      {
        journeys.length === 0 ? (
          <EmptyState message={t('journeys.emptyState')} />
        ) : (
          <ContentGrid>
            {journeys.map((entry) => (
              <ContentCard
                href={`/${locale}/journeys/${entry.data.slug}/`}
                imageId={entry.data.coverImage}
                eyebrow={entry.data.theme}
                title={entry.data.title}
                summary={entry.data.description}
                meta={entry.data.duration}
                draftLabel={entry.data.draft ? t('badge.draftTranslation') : undefined}
                locale={locale}
              />
            ))}
          </ContentGrid>
        )
      }
    </div>
  </section>

  <InquiryCTA
    title={t('home.inquiry.title')}
    body={t('home.inquiry.body')}
    ctaLabel={t('common.cta')}
    ctaHref={`/${locale}/contact/`}
  />
</BaseLayout>
