---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PageHero from '../../../../components/PageHero.astro';
import QuickInquiryButton from '../../../../components/QuickInquiryButton.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import Gallery from '../../../../components/Gallery.astro';
import SectionHeading from '../../../../components/SectionHeading.astro';
import ContentSection from '../../../../components/ContentSection.astro';
import DayItinerary from '../../../../components/DayItinerary.astro';
import MediaHighlightList from '../../../../components/MediaHighlightList.astro';
import KeyFacts from '../../../../components/KeyFacts.astro';
import RelatedContent from '../../../../components/RelatedContent.astro';
import ContentStatusBadge from '../../../../components/ContentStatusBadge.astro';
import InquiryCTA from '../../../../components/home/InquiryCTA.astro';
import { getDetailStaticPaths, resolveRelated, excludeShownImages } from '../../../../lib/content';
import { useTranslations, type Locale } from '../../../../i18n/ui';

export const getStaticPaths = () => getDetailStaticPaths('journeys');

const { locale } = Astro.params as { locale: Locale };
const { entry } = Astro.props as Awaited<ReturnType<typeof getDetailStaticPaths>>[number]['props'];
const { data } = entry;
const t = useTranslations(locale);

// Destinations covered stays unfiltered — those cities are the journey's
// core content, not a tangential suggestion, so they belong even if a
// photo repeats. Included experiences and journal picks are supplementary,
// so a duplicate-image one is dropped rather than shown looking identical.
const shownImageIds = [data.coverImage, ...data.gallery];
const includedExperiences = excludeShownImages(
  await resolveRelated('experiences', locale, data.includedExperienceKeys),
  shownImageIds,
);
const destinationsCovered = await resolveRelated('destinations', locale, data.destinationKeys);
const journalArticles = excludeShownImages(
  await resolveRelated('journal', locale, data.relatedJournalKeys),
  shownImageIds,
);

const keyFacts = [
  { label: t('journeys.detail.themeLabel'), value: data.theme },
  ...(data.duration ? [{ label: t('journeys.detail.durationLabel'), value: data.duration }] : []),
];

// A highlight is either a plain string or a {text, image} pair — same
// normalization as the accommodations template, so MediaHighlightList
// doesn't need to branch on it.
interface HighlightItem {
  text: string;
  image?: string;
}
const normalizeHighlights = (items: (string | HighlightItem)[]): HighlightItem[] =>
  items.map((item) => (typeof item === 'string' ? { text: item, image: undefined } : item));
const highlights = normalizeHighlights(data.highlights);

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'TouristTrip',
    name: data.title,
    description: data.description,
    url: new URL(`/${locale}/journeys/${data.slug}/`, Astro.site).toString(),
  },
];
---

<BaseLayout
  title={data.title}
  description={data.seoDescription ?? data.description}
  path={`journeys/${data.slug}`}
  imageId={data.coverImage}
  structuredData={structuredData}
  translationContext={{ collection: 'journeys', translationKey: data.translationKey }}
>
  <div class="container">
    <Breadcrumbs
      items={[
        { label: t('nav.home'), href: `/${locale}/` },
        { label: t('journeys.hero.title'), href: `/${locale}/journeys/` },
        { label: data.title },
      ]}
    />
  </div>

  <PageHero eyebrow={data.theme} title={data.title} />
  <QuickInquiryButton locale={locale} subject={data.title} label={t('common.ctaQuote')} />
  {
    data.draft && (
      <div class="container badge-row">
        <ContentStatusBadge tone="draft" label={t('badge.draftTranslation')} />
      </div>
    )
  }

  <div class="container">
    <Gallery images={data.gallery.length > 0 ? data.gallery : [data.coverImage]} locale={locale} />
  </div>

  <ContentSection title={t('journeys.detail.overviewTitle')} body={data.description}>
    {data.itinerary.length > 0 && <DayItinerary days={data.itinerary} locale={locale} />}
  </ContentSection>

  {
    highlights.length > 0 && (
      <section class="section">
        <div class="container prose">
          <SectionHeading eyebrow={data.theme} title={t('journeys.detail.highlightsTitle')} />
          <MediaHighlightList items={highlights} locale={locale} />
        </div>
      </section>
    )
  }

  {
    keyFacts.length > 0 && (
      <section class="section">
        <div class="container">
          <KeyFacts facts={keyFacts} />
        </div>
      </section>
    )
  }

  {
    data.customisationNotes && (
      <ContentSection
        title={t('journeys.detail.customisationTitle')}
        body={data.customisationNotes}
      />
    )
  }

  <RelatedContent
    locale={locale}
    eyebrow={data.theme}
    title={t('journeys.detail.includedExperiencesHeading')}
    items={includedExperiences.map((item) => ({
      href: `/${locale}/experiences/${item.data.slug}/`,
      imageId: item.data.coverImage,
      eyebrow: t(`category.${item.data.category}` as never),
      title: item.data.title,
      summary: item.data.description,
      draftLabel: item.data.draft ? t('badge.draftTranslation') : undefined,
    }))}
  />

  <RelatedContent
    locale={locale}
    eyebrow={data.theme}
    title={t('journeys.detail.destinationsHeading')}
    items={destinationsCovered.map((item) => ({
      href: `/${locale}/destinations/${item.data.slug}/`,
      imageId: item.data.coverImage,
      eyebrow: t(`region.${item.data.region}` as never),
      title: item.data.title,
      summary: item.data.description,
      draftLabel: item.data.draft ? t('badge.draftTranslation') : undefined,
    }))}
  />

  <RelatedContent
    locale={locale}
    eyebrow={data.theme}
    title={t('journeys.detail.journalHeading')}
    items={journalArticles.map((item) => ({
      href: `/${locale}/journal/${item.data.slug}/`,
      imageId: item.data.coverImage,
      eyebrow: t(`journalCategory.${item.data.category}` as never),
      title: item.data.title,
      summary: item.data.excerpt,
      draftLabel: item.data.draft ? t('badge.draftTranslation') : undefined,
    }))}
  />

  <InquiryCTA
    title={t('home.inquiry.title')}
    body={t('home.inquiry.body')}
    ctaLabel={t('common.cta')}
    ctaHref={`/${locale}/contact/`}
  />
</BaseLayout>

<style>
  .badge-row {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
</style>
