---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import ContentSection from '../../../components/ContentSection.astro';
import StoryFeature from '../../../components/about/StoryFeature.astro';
import VideoFeature from '../../../components/home/VideoFeature.astro';
import InquiryCTA from '../../../components/home/InquiryCTA.astro';
import { languages, useTranslations, type Locale } from '../../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);

const [about] = await getCollection('about', (entry) => entry.id === `${locale}/about`);
const { data } = about;
---

<BaseLayout
  title={t('nav.about')}
  description="MYVIPSERVICE — our story, philosophy and international service network."
  path="about"
>
  <PageHero
    eyebrow={t('about.hero.eyebrow')}
    title="MYVIPSERVICE"
    subtitle={t('about.hero.subtitle')}
    imageId="hero-home"
    locale={locale}
  />

  <VideoFeature
    eyebrow={t('about.founderVideo.eyebrow')}
    title={t('about.founderVideo.title')}
    body={t('about.founderVideo.body')}
    posterImageId="service-lobby-detail"
    comingSoonLabel={t('about.founderVideo.comingSoon')}
    locale={locale}
  />

  <ContentSection title={data.brandStoryTitle} body={data.brandStoryBody} />
  <StoryFeature
    title={data.philosophyTitle}
    body={data.philosophyBody}
    imageId="destination-french-riviera"
    locale={locale}
  />
  <StoryFeature
    title={data.whatWeDoTitle}
    body={data.whatWeDoBody}
    imageId="service-hotels-villas"
    locale={locale}
    reverse
  />
  <StoryFeature
    id="international-service-network"
    title={data.networkTitle}
    body={data.networkBody}
    imageId="destination-geneva"
    locale={locale}
  />
  <StoryFeature
    title={data.howWeWorkTitle}
    body={data.howWeWorkBody}
    imageId="journal-preview-paris-cafe"
    locale={locale}
    reverse
  />
  <ContentSection title={data.privacyTitle} body={data.privacyBody} />

  <InquiryCTA
    title={t('about.cta.title')}
    body={t('about.cta.body')}
    ctaLabel={t('common.cta')}
    ctaHref={`/${locale}/contact/`}
  />
</BaseLayout>
