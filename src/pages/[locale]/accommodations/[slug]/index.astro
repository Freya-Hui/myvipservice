---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PageHero from '../../../../components/PageHero.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import SectionHeading from '../../../../components/SectionHeading.astro';
import KeyFacts from '../../../../components/KeyFacts.astro';
import RelatedContent from '../../../../components/RelatedContent.astro';
import ContentStatusBadge from '../../../../components/ContentStatusBadge.astro';
import MediaHighlightList from '../../../../components/MediaHighlightList.astro';
import ArticleTOC from '../../../../components/ArticleTOC.astro';
import InquiryCTA from '../../../../components/home/InquiryCTA.astro';
import {
  getDetailStaticPaths,
  resolveRelated,
  getEntryByTranslationKey,
  excludeShownImages,
} from '../../../../lib/content';
import { useTranslations, type Locale } from '../../../../i18n/ui';

export const getStaticPaths = () => getDetailStaticPaths('accommodations');

const { locale } = Astro.params as { locale: Locale };
const { entry } = Astro.props as Awaited<ReturnType<typeof getDetailStaticPaths>>[number]['props'];
const { data } = entry;
const t = useTranslations(locale);

const destination = await getEntryByTranslationKey('destinations', locale, data.destinationKey);
const shownImageIds = [data.coverImage, ...data.gallery];
const relatedDestination = excludeShownImages(destination ? [destination] : [], shownImageIds);
const experiences = excludeShownImages(
  await resolveRelated('experiences', locale, data.relatedExperienceKeys, data.translationKey),
  shownImageIds,
);
const relatedAccommodations = excludeShownImages(
  await resolveRelated(
    'accommodations',
    locale,
    data.relatedAccommodationKeys,
    data.translationKey,
  ),
  shownImageIds,
);
const journalArticles = excludeShownImages(
  await resolveRelated('journal', locale, data.relatedJournalKeys),
  shownImageIds,
);

const keyFacts = [
  { label: t('accommodations.detail.typeLabel'), value: t(`type.${data.type}` as never) },
  { label: t('accommodations.detail.locationTitle'), value: `${data.city}, ${data.country}` },
  ...(data.positioning.length > 0
    ? [
        {
          label: t('accommodations.detail.positioningLabel'),
          value: data.positioning
            .map((item: string) => t(`positioning.${item}` as never))
            .join(', '),
        },
      ]
    : []),
  ...(data.suitableFor.length > 0
    ? [{ label: t('accommodations.detail.suitableForLabel'), value: data.suitableFor.join(', ') }]
    : []),
];

// Only the original placeholder listings (translationKey prefixed
// "demo-") are unconfirmed sample content — the named partner hotels are
// real properties, so they don't get the "demo listing" badge.
const isDemoListing = data.translationKey.startsWith('demo-');

// A highlight/room-type entry is either a plain string (all existing
// content) or a {text, image} pair — normalize both fields to one shape so
// MediaHighlightList doesn't need to branch on it. Only entries with an
// image get the image-then-text treatment; text-only bullets render plain.
interface HighlightItem {
  text: string;
  image?: string;
}
const normalizeHighlights = (items: (string | HighlightItem)[]): HighlightItem[] =>
  items.map((item) => (typeof item === 'string' ? { text: item, image: undefined } : item));
const highlights = normalizeHighlights(data.highlights);
const roomTypes = normalizeHighlights(data.roomTypes);
const overviewItem: HighlightItem = { text: data.description, image: data.coverImage };

const sectionEyebrow = t(`type.${data.type}` as never);
const quoteHref = data.bookingHref
  ? `/${locale}/${data.bookingHref}`
  : `/${locale}/contact/?about=${encodeURIComponent(data.title)}`;

// Drives both the sidebar TOC and which sections actually render — kept in
// sync with the conditionals below (a section only appears in one list if
// it appears in the other).
const tocSections = [
  { key: 'overview', title: t('accommodations.detail.overviewTitle') },
  ...(highlights.length > 0
    ? [{ key: 'highlights', title: t('accommodations.detail.highlightsTitle') }]
    : []),
  ...(roomTypes.length > 0
    ? [{ key: 'roomTypes', title: t('accommodations.detail.roomTypesTitle') }]
    : []),
  ...(data.familyNotes
    ? [{ key: 'familyNotes', title: t('accommodations.detail.familyNotesTitle') }]
    : []),
  ...(data.diningWellness
    ? [{ key: 'diningWellness', title: t('accommodations.detail.diningWellnessTitle') }]
    : []),
  ...(data.servicePerspective
    ? [{ key: 'perspective', title: t('accommodations.detail.perspectiveTitle') }]
    : []),
];
const hasToc = tocSections.length > 1;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'LodgingBusiness',
    name: data.title,
    description: data.description,
    url: new URL(`/${locale}/accommodations/${data.slug}/`, Astro.site).toString(),
  },
];
---

<BaseLayout
  title={data.title}
  description={data.seoDescription ?? data.description}
  path={`accommodations/${data.slug}`}
  imageId={data.coverImage}
  structuredData={structuredData}
  translationContext={{ collection: 'accommodations', translationKey: data.translationKey }}
>
  <div class="container">
    <Breadcrumbs
      items={[
        { label: t('nav.home'), href: `/${locale}/` },
        { label: t('accommodations.hero.title'), href: `/${locale}/accommodations/` },
        { label: data.title },
      ]}
    />
  </div>

  <PageHero eyebrow={sectionEyebrow} title={data.title}>
    <a slot="cta" class="button button--primary" href={quoteHref}>
      {t('common.ctaQuote')} →
    </a>
  </PageHero>
  <div class="container badge-row">
    {isDemoListing && <ContentStatusBadge tone="demo" label={t('badge.demoListing')} />}
    {data.draft && <ContentStatusBadge tone="draft" label={t('badge.draftTranslation')} />}
  </div>

  {
    data.logo && (
      <div class="container">
        <img class="property-logo" src={data.logo} alt={data.title} loading="lazy" />
      </div>
    )
  }

  <section class="section">
    <div class="container">
      <KeyFacts facts={keyFacts} />
    </div>
  </section>

  <section class="section">
    <div class:list={['container', 'article-layout', { 'has-toc': hasToc }]}>
      <div class="article-layout__body prose">
        <section id="overview">
          <SectionHeading
            eyebrow={sectionEyebrow}
            title={t('accommodations.detail.overviewTitle')}
          />
          <MediaHighlightList items={[overviewItem]} locale={locale} />
        </section>

        {
          highlights.length > 0 && (
            <section id="highlights">
              <SectionHeading
                eyebrow={sectionEyebrow}
                title={t('accommodations.detail.highlightsTitle')}
              />
              <MediaHighlightList items={highlights} locale={locale} />
            </section>
          )
        }

        {
          roomTypes.length > 0 && (
            <section id="roomTypes">
              <SectionHeading
                eyebrow={sectionEyebrow}
                title={t('accommodations.detail.roomTypesTitle')}
              />
              <MediaHighlightList items={roomTypes} locale={locale} />
            </section>
          )
        }

        {
          data.familyNotes && (
            <section id="familyNotes">
              <SectionHeading
                eyebrow={sectionEyebrow}
                title={t('accommodations.detail.familyNotesTitle')}
              />
              <p class="section-body-text">{data.familyNotes}</p>
            </section>
          )
        }

        {
          data.diningWellness && (
            <section id="diningWellness">
              <SectionHeading
                eyebrow={sectionEyebrow}
                title={t('accommodations.detail.diningWellnessTitle')}
              />
              <p class="section-body-text">{data.diningWellness}</p>
            </section>
          )
        }

        {
          /* Closing "who this suits" read — deliberately last, after the
             features and room types, so the page reads intro → features →
             rooms → who it's for, instead of leading with the agency's own
             take. */
          data.servicePerspective && (
            <section id="perspective">
              <SectionHeading
                eyebrow={sectionEyebrow}
                title={t('accommodations.detail.perspectiveTitle')}
              />
              <p class="section-body-text">{data.servicePerspective}</p>
            </section>
          )
        }
      </div>

      {
        hasToc && (
          <ArticleTOC
            headings={tocSections.map((s) => ({ depth: 2, slug: s.key, text: s.title }))}
            label={t('journal.detail.tocHeading')}
          >
            <a class="button button--primary" href={quoteHref}>
              {t('common.ctaQuote')} →
            </a>
          </ArticleTOC>
        )
      }
    </div>
  </section>

  <RelatedContent
    locale={locale}
    eyebrow={t(`type.${data.type}` as never)}
    title={t('accommodations.detail.relatedDestinationHeading')}
    items={relatedDestination.map((item) => ({
      href: `/${locale}/destinations/${item.data.slug}/`,
      imageId: item.data.coverImage,
      eyebrow: t(`region.${item.data.region}` as never),
      title: item.data.title,
      summary: item.data.description,
      draftLabel: item.data.draft ? t('badge.draftTranslation') : undefined,
    }))}
  />

  <RelatedContent
    locale={locale}
    eyebrow={t(`type.${data.type}` as never)}
    title={t('accommodations.detail.nearbyExperiencesHeading')}
    items={experiences.map((item) => ({
      href: `/${locale}/experiences/${item.data.slug}/`,
      imageId: item.data.coverImage,
      eyebrow: t(`category.${item.data.category}` as never),
      title: item.data.title,
      summary: item.data.description,
      draftLabel: item.data.draft ? t('badge.draftTranslation') : undefined,
    }))}
  />

  <RelatedContent
    locale={locale}
    eyebrow={t(`type.${data.type}` as never)}
    title={t('accommodations.detail.relatedAccommodationsHeading')}
    items={relatedAccommodations.map((item) => ({
      href: `/${locale}/accommodations/${item.data.slug}/`,
      imageId: item.data.coverImage,
      eyebrow: t(`type.${item.data.type}` as never),
      title: item.data.title,
      summary: item.data.description,
      meta: `${item.data.city}, ${item.data.country}`,
      draftLabel: item.data.draft ? t('badge.draftTranslation') : undefined,
    }))}
  />

  <RelatedContent
    locale={locale}
    eyebrow={t(`type.${data.type}` as never)}
    title={t('accommodations.detail.journalHeading')}
    items={journalArticles.map((item) => ({
      href: `/${locale}/journal/${item.data.slug}/`,
      imageId: item.data.coverImage,
      eyebrow: t(`journalCategory.${item.data.category}` as never),
      title: item.data.title,
      summary: item.data.excerpt,
      draftLabel: item.data.draft ? t('badge.draftTranslation') : undefined,
    }))}
  />

  <section class="section price-notice-section">
    <div class="container">
      <p class="price-notice">{t('accommodations.detail.priceNotice')}</p>
    </div>
  </section>

  <InquiryCTA
    title={t('home.inquiry.title')}
    body={t('home.inquiry.body')}
    ctaLabel={t('common.cta')}
    ctaHref={`/${locale}/contact/`}
  />
</BaseLayout>

<style>
  .badge-row {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  .property-logo {
    background: #fff;
    border-radius: var(--radius);
    padding: var(--space-3) var(--space-4);
    height: 3rem;
    width: auto;
    max-width: 16rem;
    object-fit: contain;
    margin-bottom: var(--space-5);
  }

  .article-layout__body section + section {
    margin-top: var(--space-6);
  }

  .section-body-text {
    color: var(--color-text-muted);
    font-size: var(--text-body-lg);
  }

  .price-notice-section {
    padding-block: var(--space-4);
  }

  .price-notice {
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
    padding: var(--space-4);
    color: var(--color-text-muted);
  }
</style>
