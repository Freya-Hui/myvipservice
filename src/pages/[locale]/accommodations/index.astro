---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import ContentGrid from '../../../components/ContentGrid.astro';
import ContentCard from '../../../components/ContentCard.astro';
import EmptyState from '../../../components/EmptyState.astro';
import InquiryCTA from '../../../components/home/InquiryCTA.astro';
import { getLocaleEntries } from '../../../lib/content';
import { languages, useTranslations, type Locale } from '../../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);

const all = await getLocaleEntries('accommodations', locale);
const featured = all.filter((entry) => entry.data.featured);
const hotels = all.filter((entry) => entry.data.type === 'hotel');
const villas = all.filter((entry) => entry.data.type === 'villa');

function toCard(entry: (typeof all)[number]) {
  return {
    href: `/${locale}/accommodations/${entry.data.slug}/`,
    imageId: entry.data.coverImage,
    eyebrow: t(`type.${entry.data.type}` as never),
    title: entry.data.title,
    summary: entry.data.description,
    meta: `${entry.data.city}, ${entry.data.country}`,
    draftLabel: entry.data.draft ? t('badge.draftTranslation') : undefined,
  };
}
---

<BaseLayout
  title={t('accommodations.hero.title')}
  description="MYVIPSERVICE — hotels and villas we use to test the accommodation template."
  path="accommodations"
>
  <div class="container">
    <Breadcrumbs
      items={[
        { label: t('nav.home'), href: `/${locale}/` },
        { label: t('accommodations.hero.title') },
      ]}
    />
  </div>

  <PageHero
    eyebrow={t('accommodations.hero.eyebrow')}
    title={t('accommodations.hero.title')}
    subtitle={t('accommodations.hero.subtitle')}
  />

  {
    all.length === 0 ? (
      <div class="container">
        <EmptyState message={t('accommodations.emptyState')} />
      </div>
    ) : (
      <Fragment>
        {featured.length > 0 && (
          <section class="section">
            <div class="container">
              <SectionHeading
                eyebrow={t('accommodations.hero.eyebrow')}
                title={t('accommodations.featuredHeading')}
              />
              <ContentGrid>
                {featured.map((entry) => (
                  <ContentCard {...toCard(entry)} />
                ))}
              </ContentGrid>
            </div>
          </section>
        )}

        {hotels.length > 0 && (
          <section class="section">
            <div class="container">
              <SectionHeading
                eyebrow={t('accommodations.hero.eyebrow')}
                title={t('accommodations.hotelsHeading')}
              />
              <ContentGrid>
                {hotels.map((entry) => (
                  <ContentCard {...toCard(entry)} />
                ))}
              </ContentGrid>
            </div>
          </section>
        )}

        {villas.length > 0 && (
          <section class="section">
            <div class="container">
              <SectionHeading
                eyebrow={t('accommodations.hero.eyebrow')}
                title={t('accommodations.villasHeading')}
              />
              <ContentGrid>
                {villas.map((entry) => (
                  <ContentCard {...toCard(entry)} />
                ))}
              </ContentGrid>
            </div>
          </section>
        )}
      </Fragment>
    )
  }

  <InquiryCTA
    title={t('home.inquiry.title')}
    body={t('home.inquiry.body')}
    ctaLabel={t('common.cta')}
    ctaHref={`/${locale}/contact/`}
  />
</BaseLayout>
