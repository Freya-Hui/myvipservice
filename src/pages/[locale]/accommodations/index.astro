---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import ContentGrid from '../../../components/ContentGrid.astro';
import ContentCard from '../../../components/ContentCard.astro';
import EmptyState from '../../../components/EmptyState.astro';
import InquiryCTA from '../../../components/home/InquiryCTA.astro';
import { getLocaleEntries } from '../../../lib/content';
import { languages, useTranslations, type Locale } from '../../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);

const all = await getLocaleEntries('accommodations', locale);
const featured = all.filter((entry) => entry.data.featured);
// Type-grouped sections below only show entries not already shown above,
// so the same property never appears twice on this page.
const remaining = all.filter((entry) => !entry.data.featured);
const hotels = remaining.filter((entry) => entry.data.type === 'hotel');
const villas = remaining.filter((entry) => entry.data.type === 'villa');

function toCard(entry: (typeof all)[number]) {
  // A positioning tag (e.g. "Palace", "Design-Led") is more useful here than
  // repeating the city — most of our current hotel network sits in Paris, so
  // "Paris, France" on every card would just be noise, not a filter.
  const meta = entry.data.positioning[0]
    ? t(`positioning.${entry.data.positioning[0]}` as never)
    : `${entry.data.city}, ${entry.data.country}`;
  return {
    href: `/${locale}/accommodations/${entry.data.slug}/`,
    imageId: entry.data.coverImage,
    logo: entry.data.logo,
    eyebrow: t(`type.${entry.data.type}` as never),
    title: entry.data.title,
    summary: entry.data.description,
    meta,
    draftLabel: entry.data.draft ? t('badge.draftTranslation') : undefined,
  };
}
---

<BaseLayout
  title={t('accommodations.hero.title')}
  description={t('accommodations.hero.subtitle')}
  path="accommodations"
>
  <div class="container">
    <Breadcrumbs
      items={[
        { label: t('nav.home'), href: `/${locale}/` },
        { label: t('accommodations.hero.title') },
      ]}
    />
  </div>

  <PageHero
    eyebrow={t('accommodations.hero.eyebrow')}
    title={t('accommodations.hero.title')}
    subtitle={t('accommodations.hero.subtitle')}
  />

  {
    all.length === 0 ? (
      <div class="container">
        <EmptyState message={t('accommodations.emptyState')} />
      </div>
    ) : (
      <Fragment>
        {featured.length > 0 && (
          <section class="section">
            <div class="container">
              <SectionHeading
                eyebrow={t('accommodations.hero.eyebrow')}
                title={t('accommodations.featuredHeading')}
              />
              <ContentGrid>
                {featured.map((entry) => (
                  <ContentCard {...toCard(entry)} locale={locale} />
                ))}
              </ContentGrid>
            </div>
          </section>
        )}

        {hotels.length > 0 && (
          <section class="section">
            <div class="container">
              <SectionHeading
                eyebrow={t('accommodations.hero.eyebrow')}
                title={t('accommodations.hotelsHeading')}
              />
              <ContentGrid>
                {hotels.map((entry) => (
                  <ContentCard {...toCard(entry)} locale={locale} />
                ))}
              </ContentGrid>
            </div>
          </section>
        )}

        {villas.length > 0 && (
          <section class="section">
            <div class="container">
              <SectionHeading
                eyebrow={t('accommodations.hero.eyebrow')}
                title={t('accommodations.villasHeading')}
              />
              <ContentGrid>
                {villas.map((entry) => (
                  <ContentCard {...toCard(entry)} locale={locale} />
                ))}
              </ContentGrid>
            </div>
          </section>
        )}
      </Fragment>
    )
  }

  <InquiryCTA
    title={t('home.inquiry.title')}
    body={t('home.inquiry.body')}
    ctaLabel={t('common.cta')}
    ctaHref={`/${locale}/contact/`}
  />
</BaseLayout>
