---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import { languages, useTranslations, type Locale } from '../../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);

const [entry] = await getCollection('legal', (e) => e.id === `${locale}/legal-notice`);
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.title} path="legal-notice">
  <PageHero eyebrow={t('footer.legalNotice')} title={entry.data.title} />
  <section class="section">
    <div class="container prose">
      <Content />
    </div>
  </section>
</BaseLayout>
