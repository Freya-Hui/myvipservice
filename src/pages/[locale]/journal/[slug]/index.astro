---
import { render } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PageHero from '../../../../components/PageHero.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import Gallery from '../../../../components/Gallery.astro';
import KeyFacts from '../../../../components/KeyFacts.astro';
import RelatedContent from '../../../../components/RelatedContent.astro';
import ContentStatusBadge from '../../../../components/ContentStatusBadge.astro';
import ArticleTOC from '../../../../components/ArticleTOC.astro';
import InquiryCTA from '../../../../components/home/InquiryCTA.astro';
import { getDetailStaticPaths, resolveRelated, excludeShownImages } from '../../../../lib/content';
import { useTranslations, type Locale } from '../../../../i18n/ui';

export const getStaticPaths = () => getDetailStaticPaths('journal');

const { locale } = Astro.params as { locale: Locale };
const { entry } = Astro.props as Awaited<ReturnType<typeof getDetailStaticPaths>>[number]['props'];
const { data, body } = entry;
const t = useTranslations(locale);
const { Content, headings } = await render(entry);

// Rough estimate, not a precise word-count tool: strip markdown syntax
// (headings/emphasis/links/images) and count. Chinese reads by character,
// not whitespace-separated words, so the two locale families need
// different units and speeds — figures are the commonly-cited averages
// for unhurried reading, not a formal readability study.
const plainText = (body ?? '')
  .replace(/!\[[^\]]*]\([^)]*\)/g, '')
  .replace(/\[([^\]]*)]\([^)]*\)/g, '$1')
  .replace(/[#*_`>-]/g, '')
  .trim();
const readingMinutes =
  locale === 'zh'
    ? Math.max(1, Math.round(plainText.replace(/\s/g, '').length / 400))
    : Math.max(1, Math.round(plainText.split(/\s+/).filter(Boolean).length / 200));

// Matches ArticleTOC.astro's own filter — needed here too so the layout
// only reserves a sidebar column when one will actually render, instead of
// leaving dead grid space on short articles with too few h2s to list.
const hasToc = headings.filter((heading) => heading.depth === 2).length > 1;

const shownImageIds = [data.coverImage, ...data.gallery];
const relatedDestinations = excludeShownImages(
  await resolveRelated('destinations', locale, data.relatedDestinationKeys),
  shownImageIds,
);
const relatedAccommodations = excludeShownImages(
  await resolveRelated('accommodations', locale, data.relatedAccommodationKeys),
  shownImageIds,
);
const relatedExperiences = excludeShownImages(
  await resolveRelated('experiences', locale, data.relatedExperienceKeys),
  shownImageIds,
);
const relatedJourneys = excludeShownImages(
  await resolveRelated('journeys', locale, data.relatedJourneyKeys),
  shownImageIds,
);

const keyFacts = [
  {
    label: t('journal.detail.categoryLabel'),
    value: t(`journalCategory.${data.category}` as never),
  },
  {
    label: t('journal.detail.readingTimeLabel'),
    value: t('journal.detail.readingTimeValue').replace('{minutes}', String(readingMinutes)),
  },
  ...(data.publishedAt
    ? [
        {
          label: t('journal.detail.publishedLabel'),
          value: new Intl.DateTimeFormat(locale, { dateStyle: 'long' }).format(data.publishedAt),
        },
      ]
    : []),
  ...(data.author ? [{ label: t('journal.detail.authorLabel'), value: data.author }] : []),
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: data.title,
    description: data.excerpt,
    url: new URL(`/${locale}/journal/${data.slug}/`, Astro.site).toString(),
  },
];
---

<BaseLayout
  title={data.seoTitle ?? data.title}
  description={data.seoDescription ?? data.excerpt}
  path={`journal/${data.slug}`}
  imageId={data.coverImage}
  structuredData={structuredData}
  translationContext={{ collection: 'journal', translationKey: data.translationKey }}
>
  <div class="container">
    <Breadcrumbs
      items={[
        { label: t('nav.home'), href: `/${locale}/` },
        { label: t('journal.hero.title'), href: `/${locale}/journal/` },
        { label: data.title },
      ]}
    />
  </div>

  <PageHero eyebrow={t(`journalCategory.${data.category}` as never)} title={data.title} />
  {
    data.draft && (
      <div class="container badge-row">
        <ContentStatusBadge tone="draft" label={t('badge.draftTranslation')} />
      </div>
    )
  }

  <div class="container">
    <Gallery images={data.gallery.length > 0 ? data.gallery : [data.coverImage]} locale={locale} />
  </div>

  <section class="section">
    <div class="container">
      <KeyFacts facts={keyFacts} />
    </div>
  </section>

  <section class="section">
    <div class="container article-layout" class:list={{ 'has-toc': hasToc }}>
      <div class="prose article-layout__body">
        <Content />
      </div>
      {hasToc && <ArticleTOC headings={headings} label={t('journal.detail.tocHeading')} />}
    </div>
  </section>

  <RelatedContent
    locale={locale}
    eyebrow={t(`journalCategory.${data.category}` as never)}
    title={t('journal.detail.relatedDestinationsHeading')}
    items={relatedDestinations.map((item) => ({
      href: `/${locale}/destinations/${item.data.slug}/`,
      imageId: item.data.coverImage,
      eyebrow: t(`region.${item.data.region}` as never),
      title: item.data.title,
      summary: item.data.description,
      draftLabel: item.data.draft ? t('badge.draftTranslation') : undefined,
    }))}
  />

  <RelatedContent
    locale={locale}
    eyebrow={t(`journalCategory.${data.category}` as never)}
    title={t('journal.detail.relatedExperiencesHeading')}
    items={relatedExperiences.map((item) => ({
      href: `/${locale}/experiences/${item.data.slug}/`,
      imageId: item.data.coverImage,
      eyebrow: t(`category.${item.data.category}` as never),
      title: item.data.title,
      summary: item.data.description,
      draftLabel: item.data.draft ? t('badge.draftTranslation') : undefined,
    }))}
  />

  <RelatedContent
    locale={locale}
    eyebrow={t(`journalCategory.${data.category}` as never)}
    title={t('journal.detail.relatedJourneysHeading')}
    items={relatedJourneys.map((item) => ({
      href: `/${locale}/journeys/${item.data.slug}/`,
      imageId: item.data.coverImage,
      eyebrow: item.data.theme,
      title: item.data.title,
      summary: item.data.description,
      draftLabel: item.data.draft ? t('badge.draftTranslation') : undefined,
    }))}
  />

  <RelatedContent
    locale={locale}
    eyebrow={t(`journalCategory.${data.category}` as never)}
    title={t('journal.detail.relatedAccommodationsHeading')}
    items={relatedAccommodations.map((item) => ({
      href: `/${locale}/accommodations/${item.data.slug}/`,
      imageId: item.data.coverImage,
      eyebrow: t(`type.${item.data.type}` as never),
      title: item.data.title,
      summary: item.data.description,
      meta: `${item.data.city}, ${item.data.country}`,
      draftLabel: item.data.draft ? t('badge.draftTranslation') : undefined,
    }))}
  />

  <InquiryCTA
    title={t('home.inquiry.title')}
    body={t('home.inquiry.body')}
    ctaLabel={t('common.cta')}
    ctaHref={`/${locale}/contact/`}
  />
</BaseLayout>

<style>
  .badge-row {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  /* .article-layout / .article-layout__body / .has-toc now live in
     global.css — shared with the accommodation detail page's own sidebar
     TOC, see src/styles/global.css. */
</style>
