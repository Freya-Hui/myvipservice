---
import { getCollection, getEntry, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import PageHero from '../../../../../components/PageHero.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';
import CarBookingWidget from '../../../../../components/CarBookingWidget.astro';
import PrivateTerminalBookingWidget from '../../../../../components/PrivateTerminalBookingWidget.astro';
import Gallery from '../../../../../components/Gallery.astro';
import SectionHeading from '../../../../../components/SectionHeading.astro';
import Faq from '../../../../../components/Faq.astro';
import RelatedContent from '../../../../../components/RelatedContent.astro';
import InquiryCTA from '../../../../../components/home/InquiryCTA.astro';
import { useTranslations, type Locale } from '../../../../../i18n/ui';

// A dedicated booking page exists for chauffeur (instant payment) and
// private terminal (enquiry, confirmed manually) — every other
// transportation topic still routes its CTA to the contact form. Filtering
// getStaticPaths down to just these two topics keeps this out of the
// [topic] index's own routing instead of needing a runtime redirect/404
// branch. (getStaticPaths runs in an isolated scope and can't reference
// outer frontmatter variables, so the list is duplicated inline here — kept
// in sync with the BOOKABLE_TOPICS check further down and in index.astro.)
export async function getStaticPaths() {
  const topics = await getCollection('transportationTopics', (topic) =>
    ['chauffeur', 'private-terminal'].includes(topic.id.split('/').slice(1).join('/')),
  );
  return topics.map((entry) => ({
    params: { locale: entry.id.split('/')[0], topic: entry.id.split('/').slice(1).join('/') },
    props: { entry },
  }));
}

const { locale } = Astro.params as { locale: Locale };
const { entry } = Astro.props as { entry: CollectionEntry<'transportationTopics'> };
const { data } = entry;
const { Content } = await render(entry);
const topicSlug = entry.id.split('/').slice(1).join('/');
const isTerminal = topicSlug === 'private-terminal';
const t = useTranslations(locale);

const parentService = await getEntry('services', `${locale}/private-transportation`);
if (!parentService) {
  throw new Error(`Missing services entry "private-transportation" for locale "${locale}"`);
}

const siblingTopics = (
  await getCollection(
    'transportationTopics',
    (topic) => topic.id.startsWith(`${locale}/`) && topic.id !== entry.id,
  )
).sort((a, b) => a.data.order - b.data.order);

const pageTitle = isTerminal ? t('terminalBooking.title') : t('carBooking.title');
const pageSubtitle = isTerminal ? t('terminalBooking.subtitle') : t('carBooking.subtitle');

const faqItems = [
  { question: t('carBooking.faq.cancel.q'), answer: t('carBooking.faq.cancel.a') },
  { question: t('carBooking.faq.noVehicle.q'), answer: t('carBooking.faq.noVehicle.a') },
  { question: t('carBooking.faq.driverInfo.q'), answer: t('carBooking.faq.driverInfo.a') },
  {
    question: t('carBooking.faq.paymentSecurity.q'),
    answer: t('carBooking.faq.paymentSecurity.a'),
  },
  { question: t('carBooking.faq.changes.q'), answer: t('carBooking.faq.changes.a') },
];
---

<BaseLayout
  title={pageTitle}
  description={pageSubtitle}
  path={`services/private-transportation/${topicSlug}/book`}
>
  <div class="container">
    <Breadcrumbs
      items={[
        { label: t('nav.home'), href: `/${locale}/` },
        { label: t('nav.services'), href: `/${locale}/services/` },
        {
          label: parentService.data.title,
          href: `/${locale}/services/private-transportation/`,
        },
        {
          label: data.title,
          href: `/${locale}/services/private-transportation/${topicSlug}/`,
        },
        { label: pageTitle },
      ]}
    />
  </div>

  <PageHero eyebrow={parentService.data.title} title={data.title} subtitle={data.summary} />

  <div class="container">
    {
      isTerminal ? (
        <PrivateTerminalBookingWidget locale={locale} />
      ) : (
        <CarBookingWidget locale={locale} />
      )
    }
  </div>

  {
    // The quick-nav shortcut now lands directly here, skipping the topic's
    // own detail page — so what used to be the only place explaining this
    // service moves below the form instead of disappearing. Same
    // gallery/body/highlights the detail page renders, not a rewrite.
    data.gallery.length > 0 && (
      <div class="container">
        <Gallery images={data.gallery} locale={locale} />
      </div>
    )
  }

  <section class="section">
    <div class="container prose">
      <Content />
    </div>
  </section>

  {
    data.highlights.length > 0 && (
      <section class="section highlights-section">
        <div class="container">
          <SectionHeading
            eyebrow={parentService.data.title}
            title={t('services.detail.highlightsTitle')}
          />
          <ul class="highlight-list">
            {data.highlights.map((item: string) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    !isTerminal && (
      <section class="section">
        <div class="container">
          <Faq title={t('carBooking.faqTitle')} items={faqItems} name="chauffeur-booking-faq" />
        </div>
      </section>
    )
  }

  {
    siblingTopics.length > 0 && (
      <RelatedContent
        locale={locale}
        eyebrow={parentService.data.title}
        title={t('services.detail.relatedTopicsHeading')}
        items={siblingTopics.map((topic) => ({
          href: `/${locale}/services/private-transportation/${topic.id.split('/').slice(1).join('/')}/`,
          imageId: topic.data.image ?? parentService.data.image ?? 'service-private-transportation',
          eyebrow: parentService.data.title,
          title: topic.data.title,
          summary: topic.data.summary,
          meta: topic.data.price
            ? `${topic.data.price}${topic.data.priceNote ? ` — ${topic.data.priceNote}` : ''}`
            : undefined,
          draftLabel: topic.data.draft ? t('badge.draftTranslation') : undefined,
        }))}
      />
    )
  }

  <InquiryCTA
    title={t('home.inquiry.title')}
    body={t('home.inquiry.body')}
    ctaLabel={t('common.cta')}
    ctaHref={`/${locale}/contact/`}
  />
</BaseLayout>

<style>
  /* This page's booking widget deliberately runs wider than the site's
     usual reading column (it's the page's whole job, and the two-column
     layout needs the room — see CarBookingWidget.astro). PageHero's own
     text block still uses the narrow `.container.prose` convention, which
     left-edge-misaligns against the widget below it — widen it to match
     here without touching PageHero itself (every other page still wants
     the narrow, centered version). */
  :global(.page-hero .container.prose) {
    max-width: var(--content-max-width);
    margin-inline: auto;
  }

  /* PageHero's own heading has its own narrower prose cap for the normal
     (no-CTA) case — the override above only widened its parent, so without
     this it stays flush-left inside the now-wider, centered container. */
  :global(.page-hero .container.prose .page-hero__heading) {
    max-width: 100%;
  }

  .highlights-section {
    padding-top: 0;
  }

  .highlight-list {
    color: var(--color-text-muted);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
</style>
