---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PageHero from '../../../../components/PageHero.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import SectionHeading from '../../../../components/SectionHeading.astro';
import RelatedContent from '../../../../components/RelatedContent.astro';
import CarBookingWidget from '../../../../components/CarBookingWidget.astro';
import VipReceptionBookingWidget from '../../../../components/VipReceptionBookingWidget.astro';
import PrivateTerminalBookingWidget from '../../../../components/PrivateTerminalBookingWidget.astro';
import InquiryCTA from '../../../../components/home/InquiryCTA.astro';
import { languages, useTranslations, type Locale } from '../../../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);

// One hub for the three ways of arriving. The three booking widgets already
// exist and each keeps its own pricing/enquiry logic — chauffeur-only is the
// one case with a computed price (instant online payment); VIP reception and
// the private terminal are enquiries confirmed by an advisor. The hub only
// decides which widget to show, so no pricing rule is duplicated here.
const cards = [
  {
    href: `/${locale}/services/private-transportation/chauffeur/`,
    imageId: 'service-car-aviation-seats',
    title: t('arrival.mode.chauffeur'),
    summary: t('arrival.summary.chauffeur'),
    meta: t('arrival.price.chauffeur'),
  },
  {
    href: `/${locale}/services/vip-airport-reception/`,
    imageId: 'service-concierge',
    title: t('arrival.mode.reception'),
    summary: t('arrival.summary.reception'),
    meta: t('arrival.price.reception'),
  },
  {
    href: `/${locale}/services/private-transportation/private-terminal/`,
    imageId: 'experience-extime-lounge',
    title: t('arrival.mode.terminal'),
    summary: t('arrival.summary.terminal'),
    meta: t('arrival.price.terminal'),
  },
];

const nav = t('nav.services');
---

<BaseLayout title={t('arrival.title')} description={t('arrival.subtitle')} path="services/arrival">
  <div class="container">
    <Breadcrumbs
      items={[
        { label: t('nav.home'), href: `/${locale}/` },
        { label: nav, href: `/${locale}/services/` },
        { label: t('arrival.title') },
      ]}
    />
  </div>

  <PageHero eyebrow={nav} title={t('arrival.title')} subtitle={t('arrival.subtitle')} />

  <RelatedContent
    locale={locale}
    eyebrow={t('arrival.optionsEyebrow')}
    title={t('arrival.optionsTitle')}
    items={cards}
  />

  <section class="section arrival-choose" id="choose">
    <div class="container">
      <SectionHeading eyebrow={t('arrival.chooseEyebrow')} title={t('arrival.chooseTitle')} />

      <div class="arrival-choose__controls">
        <span class="arrival-choose__label">{t('arrival.step1')}</span>
        <div class="arrival-choose__pills" role="radiogroup" aria-label={t('arrival.step1')}>
          <button type="button" class="pill is-active" data-arrival-mode="chauffeur">
            {t('arrival.mode.chauffeur')}
          </button>
          <button type="button" class="pill" data-arrival-mode="reception">
            {t('arrival.mode.reception')}
          </button>
          <button type="button" class="pill" data-arrival-mode="terminal">
            {t('arrival.mode.terminal')}
          </button>
        </div>

        <label class="arrival-choose__add" id="arrival-add" hidden>
          <input type="checkbox" id="arrival-add-chauffeur" />
          {t('arrival.addChauffeur')}
        </label>

        <p class="arrival-choose__note" id="arrival-note" aria-live="polite"></p>
        <p class="arrival-choose__exclusive" id="arrival-exclusive" hidden>
          {t('arrival.exclusive')}
        </p>
      </div>

      <div id="arrival-panel-chauffeur"><CarBookingWidget locale={locale} /></div>
      <div id="arrival-panel-reception" hidden><VipReceptionBookingWidget locale={locale} /></div>
      <div id="arrival-panel-terminal" hidden>
        <PrivateTerminalBookingWidget locale={locale} />
      </div>

      <p class="arrival-choose__other">
        {t('arrival.other')}
        <a href={`/${locale}/contact/?about=${encodeURIComponent(t('arrival.title'))}`}
          >{t('arrival.otherLink')}</a
        >
      </p>
    </div>
  </section>

  <InquiryCTA
    title={t('home.inquiry.title')}
    body={t('home.inquiry.body')}
    ctaLabel={t('common.cta')}
    ctaHref={`/${locale}/contact/`}
  />
</BaseLayout>

<script
  is:inline
  define:vars={{
    notes: {
      chauffeur: t('arrival.note.chauffeur'),
      reception: t('arrival.note.reception'),
      terminal: t('arrival.note.terminal'),
    },
  }}
>
  (function () {
    const pills = document.querySelectorAll('[data-arrival-mode]');
    const addWrap = document.getElementById('arrival-add');
    const add = document.getElementById('arrival-add-chauffeur');
    const note = document.getElementById('arrival-note');
    const exclusive = document.getElementById('arrival-exclusive');
    const panels = {
      chauffeur: document.getElementById('arrival-panel-chauffeur'),
      reception: document.getElementById('arrival-panel-reception'),
      terminal: document.getElementById('arrival-panel-terminal'),
    };
    const chauffeurBox = {
      reception: 'vr-chauffeur',
      terminal: 'tb-chauffeur',
    };
    let mode = 'chauffeur';

    function render() {
      Object.keys(panels).forEach(function (key) {
        panels[key].hidden = key !== mode;
      });
      pills.forEach(function (pill) {
        const active = pill.getAttribute('data-arrival-mode') === mode;
        pill.classList.toggle('is-active', active);
        pill.setAttribute('aria-checked', active ? 'true' : 'false');
      });
      const airport = mode !== 'chauffeur';
      addWrap.hidden = !airport;
      exclusive.hidden = !airport;
      note.textContent = notes[mode];
      if (airport) {
        // The widgets own their chauffeur checkbox (it also reveals the
        // vehicle choice), so drive that one and let its own handler run.
        const box = document.getElementById(chauffeurBox[mode]);
        if (box && box.checked !== add.checked) {
          box.checked = add.checked;
          box.dispatchEvent(new Event('change', { bubbles: true }));
        }
      }
    }

    pills.forEach(function (pill) {
      pill.addEventListener('click', function () {
        mode = pill.getAttribute('data-arrival-mode');
        render();
      });
    });
    add.addEventListener('change', render);

    // Keep the hub toggle honest if the visitor ticks the widget's own box.
    Object.keys(chauffeurBox).forEach(function (key) {
      const box = document.getElementById(chauffeurBox[key]);
      if (box) {
        box.addEventListener('change', function () {
          if (key === mode) add.checked = box.checked;
        });
      }
    });

    // Deep links: ?mode=terminal / reception / chauffeur (+ &chauffeur=1).
    const params = new URLSearchParams(location.search);
    const wanted = params.get('mode');
    if (wanted && panels[wanted]) mode = wanted;
    if (params.get('chauffeur') === '1') add.checked = true;
    render();
  })();
</script>

<style>
  .arrival-choose__controls {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .arrival-choose__label {
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }

  .arrival-choose__pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  /* Same pill look as the booking widgets' scenario picker. */
  .arrival-choose__pills .pill {
    font: inherit;
    font-size: var(--text-small);
    padding: 0.5rem 1rem;
    min-height: var(--button-min-height);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
    background: var(--color-bg-elevated);
    color: inherit;
    cursor: pointer;
  }

  .arrival-choose__pills .pill.is-active {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-bg-elevated);
  }

  .arrival-choose__add {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-body);
  }

  .arrival-choose__add input {
    width: auto;
    flex-shrink: 0;
  }

  /* The hub's own toggle drives the widgets' chauffeur checkbox, so the
     duplicate row inside each widget is hidden here (the widgets still read
     the checkbox value on submit). */
  .arrival-choose :global(.vip-reception__checkbox),
  .arrival-choose :global(.terminal-booking__checkbox) {
    display: none !important; /* beats the widgets' own scoped display rule */
  }

  .arrival-choose__add[hidden],
  .arrival-choose__exclusive[hidden] {
    display: none;
  }

  .arrival-choose__note {
    color: var(--color-text);
    font-weight: 600;
    margin: 0;
  }

  .arrival-choose__exclusive {
    color: var(--color-text-muted);
    font-size: var(--text-small);
    margin: 0;
  }

  .arrival-choose__other {
    margin-top: var(--space-5);
    color: var(--color-text-muted);
  }

  /* The booking widgets use a two-column layout and need the same widening
     the dedicated booking pages give them. */
  :global(.page-hero .container.prose) {
    max-width: var(--content-max-width);
    margin-inline: auto;
  }

  :global(.page-hero .container.prose .page-hero__heading) {
    max-width: 100%;
  }
</style>
