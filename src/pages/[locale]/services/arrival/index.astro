---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PageHero from '../../../../components/PageHero.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import SectionHeading from '../../../../components/SectionHeading.astro';
import StoryFeature from '../../../../components/about/StoryFeature.astro';
import CarBookingWidget from '../../../../components/CarBookingWidget.astro';
import VipReceptionBookingWidget from '../../../../components/VipReceptionBookingWidget.astro';
import PrivateTerminalBookingWidget from '../../../../components/PrivateTerminalBookingWidget.astro';
import InquiryCTA from '../../../../components/home/InquiryCTA.astro';
import { languages, useTranslations, type Locale } from '../../../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);

// One hub for the three ways of arriving. The three booking widgets already
// exist and each keeps its own pricing/enquiry logic — chauffeur-only is the
// one case with a computed price (instant online payment); VIP reception and
// the private terminal are enquiries confirmed by an advisor. The hub only
// decides which widget to show, so no pricing rule is duplicated here.
const features = [
  {
    key: 'chauffeur',
    href: `/${locale}/services/private-transportation/chauffeur/`,
    imageId: 'service-car-aviation-seats',
  },
  {
    key: 'reception',
    href: `/${locale}/services/vip-airport-reception/`,
    imageId: 'service-concierge',
  },
  {
    key: 'terminal',
    href: `/${locale}/services/private-transportation/private-terminal/`,
    imageId: 'experience-extime-lounge',
  },
] as const;

const nav = t('nav.services');
---

<BaseLayout title={t('arrival.title')} description={t('arrival.subtitle')} path="services/arrival">
  <div class="container">
    <Breadcrumbs
      items={[
        { label: t('nav.home'), href: `/${locale}/` },
        { label: nav, href: `/${locale}/services/` },
        { label: t('arrival.title') },
      ]}
    />
  </div>

  <PageHero eyebrow={nav} title={t('arrival.title')} subtitle={t('arrival.subtitle')} />

  {
    features.map((feature) => (
      <StoryFeature
        eyebrow={t(`arrival.price.${feature.key}`)}
        title={t(`arrival.mode.${feature.key}`)}
        body={t(`arrival.summary.${feature.key}`)}
        imageId={feature.imageId}
        locale={locale}
      />
    ))
  }

  <div class="container arrival-more">
    <p>
      {t('arrival.moreAbout')}
      {
        features.map((feature, index) => (
          <>
            {index > 0 && ' · '}
            <a href={feature.href}>{t(`arrival.mode.${feature.key}`)}</a>
          </>
        ))
      }
    </p>
  </div>

  <section class="section arrival-choose" id="choose">
    <div class="container">
      <SectionHeading eyebrow={t('arrival.chooseEyebrow')} title={t('arrival.chooseTitle')} />

      <div class="arrival-choose__controls">
        <span class="arrival-choose__label">{t('arrival.step1')}</span>
        <div class="arrival-choose__pills" role="group" aria-label={t('arrival.step1')}>
          <button
            type="button"
            class="pill is-active"
            data-arrival-toggle="chauffeur"
            aria-pressed="true"
          >
            {t('arrival.mode.chauffeur')}
          </button>
          <button type="button" class="pill" data-arrival-toggle="reception" aria-pressed="false">
            {t('arrival.mode.reception')}
          </button>
          <button type="button" class="pill" data-arrival-toggle="terminal" aria-pressed="false">
            {t('arrival.mode.terminal')}
          </button>
        </div>
        <p class="arrival-choose__exclusive">{t('arrival.exclusive')}</p>
        <p class="arrival-choose__note" id="arrival-note" aria-live="polite"></p>
      </div>

      <div id="arrival-panel-chauffeur"><CarBookingWidget locale={locale} /></div>
      <div id="arrival-panel-reception" hidden><VipReceptionBookingWidget locale={locale} /></div>
      <div id="arrival-panel-terminal" hidden>
        <PrivateTerminalBookingWidget locale={locale} />
      </div>

      <p class="arrival-choose__other">
        {t('arrival.other')}
        <a href={`/${locale}/contact/?about=${encodeURIComponent(t('arrival.title'))}`}
          >{t('arrival.otherLink')}</a
        >
      </p>
    </div>
  </section>

  <InquiryCTA
    title={t('home.inquiry.title')}
    body={t('home.inquiry.body')}
    ctaLabel={t('common.cta')}
    ctaHref={`/${locale}/contact/`}
  />
</BaseLayout>

<script
  is:inline
  define:vars={{
    notes: {
      chauffeur: t('arrival.note.chauffeur'),
      reception: t('arrival.note.reception'),
      terminal: t('arrival.note.terminal'),
      none: t('arrival.none'),
      combo: t('arrival.comboNote'),
    },
  }}
>
  (function () {
    const toggles = document.querySelectorAll('[data-arrival-toggle]');
    const note = document.getElementById('arrival-note');
    const panels = {
      chauffeur: document.getElementById('arrival-panel-chauffeur'),
      reception: document.getElementById('arrival-panel-reception'),
      terminal: document.getElementById('arrival-panel-terminal'),
    };
    const chauffeurBox = { reception: 'vr-chauffeur', terminal: 'tb-chauffeur' };
    // chauffeur stacks with either airport service; VIP reception and the
    // private terminal are alternatives (turning one on turns the other off).
    const state = { chauffeur: true, reception: false, terminal: false };

    function activePanel() {
      if (state.reception) return 'reception';
      if (state.terminal) return 'terminal';
      if (state.chauffeur) return 'chauffeur';
      return null;
    }

    function render() {
      const shown = activePanel();
      Object.keys(panels).forEach(function (key) {
        panels[key].hidden = key !== shown;
      });
      toggles.forEach(function (btn) {
        const key = btn.getAttribute('data-arrival-toggle');
        btn.classList.toggle('is-active', state[key]);
        btn.setAttribute('aria-pressed', state[key] ? 'true' : 'false');
      });
      const withChauffeur = shown && shown !== 'chauffeur' && state.chauffeur;
      note.textContent = shown
        ? notes[shown] + (withChauffeur ? ' ' + notes.combo : '')
        : notes.none;
      // The widgets own their chauffeur checkbox (it also reveals the
      // vehicle choice), so drive it and let the widget's own handler run.
      if (shown && chauffeurBox[shown]) {
        const box = document.getElementById(chauffeurBox[shown]);
        if (box && box.checked !== state.chauffeur) {
          box.checked = state.chauffeur;
          box.dispatchEvent(new Event('change', { bubbles: true }));
        }
      }
    }

    toggles.forEach(function (btn) {
      btn.addEventListener('click', function () {
        const key = btn.getAttribute('data-arrival-toggle');
        state[key] = !state[key];
        if (state[key] && key === 'reception') state.terminal = false;
        if (state[key] && key === 'terminal') state.reception = false;
        render();
      });
    });

    // Deep links: ?mode=reception|terminal|chauffeur, plus &chauffeur=1 to
    // stack the chauffeur on an airport service.
    const params = new URLSearchParams(location.search);
    const wanted = params.get('mode');
    if (wanted === 'reception' || wanted === 'terminal') {
      state.reception = wanted === 'reception';
      state.terminal = wanted === 'terminal';
      state.chauffeur = params.get('chauffeur') === '1';
    }
    render();
  })();
</script>

<style>
  .arrival-choose__controls {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .arrival-choose__label {
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }

  .arrival-choose__pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  /* Same pill look as the booking widgets' scenario picker. */
  .arrival-choose__pills .pill {
    font: inherit;
    font-size: var(--text-small);
    padding: 0.5rem 1rem;
    min-height: var(--button-min-height);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
    background: var(--color-bg-elevated);
    color: inherit;
    cursor: pointer;
  }

  .arrival-choose__pills .pill.is-active {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-bg-elevated);
  }

  /* The hub's own toggle drives the widgets' chauffeur checkbox, so the
     duplicate row inside each widget is hidden here (the widgets still read
     the checkbox value on submit). */
  .arrival-choose :global(.vip-reception__checkbox),
  .arrival-choose :global(.terminal-booking__checkbox) {
    display: none !important; /* beats the widgets' own scoped display rule */
  }

  .arrival-choose__note {
    color: var(--color-text);
    font-weight: 600;
    margin: 0;
  }

  .arrival-choose__exclusive {
    color: var(--color-text-muted);
    font-size: var(--text-small);
    margin: 0;
  }

  .arrival-more {
    margin-block: var(--space-4) var(--space-5);
    color: var(--color-text-muted);
  }

  .arrival-choose__other {
    margin-top: var(--space-5);
    color: var(--color-text-muted);
  }

  /* The booking widgets use a two-column layout and need the same widening
     the dedicated booking pages give them. */
  :global(.page-hero .container.prose) {
    max-width: var(--content-max-width);
    margin-inline: auto;
  }

  :global(.page-hero .container.prose .page-hero__heading) {
    max-width: 100%;
  }
</style>
