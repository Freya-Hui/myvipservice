---
import { getEntry } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PageHero from '../../../../components/PageHero.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import VipReceptionBookingWidget from '../../../../components/VipReceptionBookingWidget.astro';
import InquiryCTA from '../../../../components/home/InquiryCTA.astro';
import { languages, useTranslations, type Locale } from '../../../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);

const parentService = await getEntry('services', `${locale}/vip-airport-reception`);
if (!parentService) {
  throw new Error(`Missing services entry "vip-airport-reception" for locale "${locale}"`);
}

const pageTitle = t('vipReceptionBooking.title');
const pageSubtitle = t('vipReceptionBooking.subtitle');
---

<BaseLayout title={pageTitle} description={pageSubtitle} path="services/vip-airport-reception/book">
  <div class="container">
    <Breadcrumbs
      items={[
        { label: t('nav.home'), href: `/${locale}/` },
        { label: t('nav.services'), href: `/${locale}/services/` },
        {
          label: parentService.data.title,
          href: `/${locale}/services/vip-airport-reception/`,
        },
        { label: pageTitle },
      ]}
    />
  </div>

  <PageHero eyebrow={parentService.data.title} title={pageTitle} subtitle={pageSubtitle} />

  <div class="container">
    <VipReceptionBookingWidget locale={locale} />
  </div>

  <InquiryCTA
    title={t('home.inquiry.title')}
    body={t('home.inquiry.body')}
    ctaLabel={t('common.cta')}
    ctaHref={`/${locale}/contact/`}
  />
</BaseLayout>

<style>
  /* Same widening as the other booking pages — the widget's two-column
     layout needs more room than the site's usual prose column. */
  :global(.page-hero .container.prose) {
    max-width: var(--content-max-width);
  }
</style>
