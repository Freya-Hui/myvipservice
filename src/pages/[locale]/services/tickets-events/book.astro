---
import { getEntry } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PageHero from '../../../../components/PageHero.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import TicketBookingWidget from '../../../../components/TicketBookingWidget.astro';
import StoryFeature from '../../../../components/about/StoryFeature.astro';
import SectionHeading from '../../../../components/SectionHeading.astro';
import MediaHighlightList from '../../../../components/MediaHighlightList.astro';
import RelatedContent from '../../../../components/RelatedContent.astro';
import InquiryCTA from '../../../../components/home/InquiryCTA.astro';
import { languages, useTranslations, type Locale } from '../../../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);

const parentService = await getEntry('services', `${locale}/tickets-events`);
if (!parentService) {
  throw new Error(`Missing services entry "tickets-events" for locale "${locale}"`);
}

const pageTitle = t('ticketBooking.title');
const pageSubtitle = t('ticketBooking.subtitle');

// Same {text | {text,image,href}} normalization the service detail page
// uses for this same field, so MediaHighlightList doesn't need to branch.
interface HighlightItem {
  text: string;
  image?: string;
  href?: string;
}
const highlights: HighlightItem[] = parentService.data.highlights.map((item) =>
  typeof item === 'string' ? { text: item } : item,
);

// A day out usually also means a ride there and somewhere to stay —
// surface both instead of leaving the connection for the visitor to find
// on their own.
const chauffeurTopic = await getEntry('transportationTopics', `${locale}/chauffeur`);
const hotelService = await getEntry('services', `${locale}/hotel-villa-reservations`);
const relatedServices = [
  chauffeurTopic && {
    href: `/${locale}/services/private-transportation/chauffeur/book/`,
    imageId: chauffeurTopic.data.image ?? 'service-car-interior',
    eyebrow: t('nav.services'),
    title: chauffeurTopic.data.title,
    summary: chauffeurTopic.data.summary,
  },
  hotelService && {
    href: `/${locale}/services/hotel-villa-reservations/book/`,
    imageId: hotelService.data.image ?? 'service-hotel-exterior',
    eyebrow: t('nav.services'),
    title: hotelService.data.title,
    summary: hotelService.data.summary,
  },
].filter((item): item is NonNullable<typeof item> => Boolean(item));
---

<BaseLayout title={pageTitle} description={pageSubtitle} path="services/tickets-events/book">
  <div class="container">
    <Breadcrumbs
      items={[
        { label: t('nav.home'), href: `/${locale}/` },
        { label: t('nav.services'), href: `/${locale}/services/` },
        {
          label: parentService.data.title,
          href: `/${locale}/services/tickets-events/`,
        },
        { label: pageTitle },
      ]}
    />
  </div>

  <PageHero eyebrow={parentService.data.title} title={pageTitle} subtitle={pageSubtitle} />

  <div class="container">
    <TicketBookingWidget locale={locale} />
  </div>

  {
    // The quick-nav shortcut lands directly here, skipping the service
    // detail page — so the explanation of what this actually includes moves
    // below the form instead of disappearing. Same storyFeatures/highlights
    // the detail page renders, not a rewritten summary.
    parentService.data.storyFeatures.map((feature, index) => (
      <StoryFeature
        title={feature.title}
        body={feature.body}
        imageId={feature.imageId}
        locale={locale}
        reverse={index % 2 === 1}
      />
    ))
  }

  {
    highlights.length > 0 && (
      <section class="section highlights-section">
        <div class="container">
          <SectionHeading
            eyebrow={parentService.data.title}
            title={t('services.detail.highlightsTitle')}
          />
          <MediaHighlightList items={highlights} locale={locale} />
        </div>
      </section>
    )
  }

  {
    relatedServices.length > 0 && (
      <RelatedContent
        locale={locale}
        eyebrow={parentService.data.title}
        title={t('services.detail.relatedTopicsHeading')}
        items={relatedServices}
      />
    )
  }

  <InquiryCTA
    title={t('home.inquiry.title')}
    body={t('home.inquiry.body')}
    ctaLabel={t('common.cta')}
    ctaHref={`/${locale}/contact/`}
  />
</BaseLayout>

<style>
  /* Same widening as the chauffeur/terminal booking pages — the widget's
     two-column layout needs more room than the site's usual prose column. */
  :global(.page-hero .container.prose) {
    max-width: var(--content-max-width);
    margin-inline: auto;
  }

  /* PageHero's own heading has its own narrower prose cap for the normal
     (no-CTA) case — the override above only widened its parent, so without
     this it stays flush-left inside the now-wider, centered container. */
  :global(.page-hero .container.prose .page-hero__heading) {
    max-width: 100%;
  }

  .highlights-section {
    padding-top: 0;
  }
</style>
