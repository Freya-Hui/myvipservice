---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import { getImage } from '../../../data/image-attributions';
import { languages, useTranslations, type Locale } from '../../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);

const services = (
  await getCollection('services', (entry) => entry.id.startsWith(`${locale}/`))
).sort((a, b) => a.data.order - b.data.order);

function slugOf(id: string) {
  return id.split('/').slice(1).join('/');
}

// Fixed display order for user-task grouping (AGENTS.md principle 5) —
// services without a `group` (shouldn't happen once all 10 are tagged,
// but stay defensive) fall into a final "ungrouped" bucket.
const GROUP_ORDER = [
  'Private Travel',
  'Hotels & Villas',
  'Private Chauffeur',
  'Concierge & Lifestyle',
  'Groups & Corporate',
] as const;

const grouped = GROUP_ORDER.map((group) => ({
  group,
  services: services.filter((service) => service.data.group === group),
})).filter((entry) => entry.services.length > 0);

const ungrouped = services.filter((service) => !service.data.group);
---

<BaseLayout
  title={t('nav.services')}
  description="MYVIPSERVICE — ten ways we support our clients, from a single reservation to a fully managed private event."
  path="services"
>
  <PageHero
    eyebrow={t('services.hero.eyebrow')}
    title={t('services.hero.title')}
    subtitle={t('services.hero.subtitle')}
  />

  {
    [...grouped, ...(ungrouped.length > 0 ? [{ group: null, services: ungrouped }] : [])].map(
      ({ group, services: groupServices }) => (
        <section class="section services">
          <div class="container">
            {group && (
              <SectionHeading
                eyebrow={t('services.hero.eyebrow')}
                title={t(`servicesGroup.${group}` as never)}
              />
            )}
            <ul class="services__grid">
              {groupServices.map((service) => {
                const slug = slugOf(service.id);
                const image = service.data.image ? getImage(service.data.image) : null;
                const index = services.indexOf(service);
                return (
                  <li class="card service-card" id={slug}>
                    {image ? (
                      <div class="figure figure--standard">
                        <img
                          src={image.src}
                          alt={image.altByLocale[locale]}
                          width="1600"
                          height="1200"
                          loading="lazy"
                        />
                      </div>
                    ) : (
                      <span class="service-card__index" aria-hidden="true">
                        {String(index + 1).padStart(2, '0')}
                      </span>
                    )}
                    <h2>{service.data.title}</h2>
                    <p class="text-small service-card__summary">{service.data.summary}</p>
                    {service.data.investmentTier && (
                      <p class="text-small service-card__tier">
                        {t(`services.tier.${service.data.investmentTier}` as never)}
                      </p>
                    )}
                    <a class="button button--quiet" href={`/${locale}/services/${slug}/`}>
                      {t('common.viewDetails')} →
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        </section>
      ),
    )
  }
</BaseLayout>

<style>
  .services__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: var(--space-5);
    list-style: none;
    margin: 0 0 var(--space-5);
    padding: 0;
  }

  .service-card {
    scroll-margin-top: var(--space-5);
  }

  .service-card__index {
    display: inline-flex;
    color: var(--color-accent);
    font-family: var(--font-display);
    font-size: var(--text-h2);
    margin-bottom: var(--space-2);
  }

  .service-card h2 {
    font-size: var(--text-h4);
    margin-bottom: var(--space-2);
  }

  .service-card__summary {
    color: var(--color-text-muted);
  }

  .service-card__tier {
    color: var(--color-accent);
    margin-top: var(--space-2);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
  }
</style>
