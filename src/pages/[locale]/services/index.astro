---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import ContentGrid from '../../../components/ContentGrid.astro';
import ContentCard from '../../../components/ContentCard.astro';
import { languages, useTranslations, type Locale } from '../../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);

const services = (
  await getCollection('services', (entry) => entry.id.startsWith(`${locale}/`))
).sort((a, b) => a.data.order - b.data.order);

function slugOf(id: string) {
  return id.split('/').slice(1).join('/');
}
---

<BaseLayout
  title={t('nav.services')}
  description="MYVIPSERVICE — ten ways we support our clients, from a single reservation to a fully managed private event."
  path="services"
>
  <PageHero
    eyebrow={t('services.hero.eyebrow')}
    title={t('services.hero.title')}
    subtitle={t('services.hero.subtitle')}
  />

  <section class="section services">
    <div class="container">
      <ContentGrid>
        {
          services.map((service) => (
            <ContentCard
              href={`/${locale}/services/${slugOf(service.id)}/`}
              imageId={service.data.image ?? 'hero-home'}
              title={service.data.title}
              summary={service.data.summary}
              meta={
                service.data.investmentTier
                  ? t(`services.tier.${service.data.investmentTier}` as never)
                  : undefined
              }
              locale={locale}
            />
          ))
        }
      </ContentGrid>
    </div>
  </section>
</BaseLayout>
