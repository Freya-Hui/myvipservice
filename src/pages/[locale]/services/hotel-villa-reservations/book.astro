---
import { getEntry } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PageHero from '../../../../components/PageHero.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import HotelEnquiryWidget from '../../../../components/HotelEnquiryWidget.astro';
import StoryFeature from '../../../../components/about/StoryFeature.astro';
import Faq from '../../../../components/Faq.astro';
import RelatedContent from '../../../../components/RelatedContent.astro';
import InquiryCTA from '../../../../components/home/InquiryCTA.astro';
import { languages, useTranslations, type Locale } from '../../../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);

const parentService = await getEntry('services', `${locale}/hotel-villa-reservations`);
if (!parentService) {
  throw new Error(`Missing services entry "hotel-villa-reservations" for locale "${locale}"`);
}

const pageTitle = t('hotelEnquiry.title');
const pageSubtitle = t('accommodationBooking.subtitle');

// Real facts already confirmed on the service page (see its `highlights`
// field) recast as the questions a visitor actually has, rather than a
// flat list — nothing here is new information.
const faqItems = [
  { question: t('hotelEnquiry.faq.hotels.q'), answer: t('hotelEnquiry.faq.hotels.a') },
  { question: t('hotelEnquiry.faq.upgrades.q'), answer: t('hotelEnquiry.faq.upgrades.a') },
  { question: t('hotelEnquiry.faq.pickup.q'), answer: t('hotelEnquiry.faq.pickup.a') },
  { question: t('hotelEnquiry.faq.pricing.q'), answer: t('hotelEnquiry.faq.pricing.a') },
];

// A stay usually also needs a ride — surface the two transportation
// services most people ask about right after booking a hotel, instead of
// leaving that connection for the visitor to find on their own.
const chauffeurTopic = await getEntry('transportationTopics', `${locale}/chauffeur`);
const vipReceptionService = await getEntry('services', `${locale}/vip-airport-reception`);
const relatedServices = [
  chauffeurTopic && {
    href: `/${locale}/services/private-transportation/chauffeur/book/`,
    imageId: chauffeurTopic.data.image ?? 'service-car-interior',
    eyebrow: t('nav.services'),
    title: chauffeurTopic.data.title,
    summary: chauffeurTopic.data.summary,
  },
  vipReceptionService && {
    href: `/${locale}/services/vip-airport-reception/book/`,
    imageId: vipReceptionService.data.image ?? 'service-reception-desk-call',
    eyebrow: t('nav.services'),
    title: vipReceptionService.data.title,
    summary: vipReceptionService.data.summary,
  },
].filter((item): item is NonNullable<typeof item> => Boolean(item));
---

<BaseLayout
  title={pageTitle}
  description={pageSubtitle}
  path="services/hotel-villa-reservations/book"
>
  <div class="container">
    <Breadcrumbs
      items={[
        { label: t('nav.home'), href: `/${locale}/` },
        { label: t('nav.services'), href: `/${locale}/services/` },
        {
          label: parentService.data.title,
          href: `/${locale}/services/hotel-villa-reservations/`,
        },
        { label: pageTitle },
      ]}
    />
  </div>

  <PageHero eyebrow={parentService.data.title} title={pageTitle} subtitle={pageSubtitle} />

  <div class="container">
    <HotelEnquiryWidget locale={locale} />
  </div>

  {
    // The quick-nav shortcut lands directly here, skipping the service
    // detail page — so the explanation of what this actually includes moves
    // below the form instead of disappearing. Same storyFeatures/highlights
    // the detail page renders, not a rewritten summary.
    parentService.data.storyFeatures.map((feature, index) => (
      <StoryFeature
        title={feature.title}
        body={feature.body}
        imageId={feature.imageId}
        locale={locale}
        reverse={index % 2 === 1}
      />
    ))
  }

  <section class="section highlights-section">
    <div class="container">
      <Faq title={t('services.detail.highlightsTitle')} items={faqItems} name="hotel-enquiry-faq" />
    </div>
  </section>

  {
    relatedServices.length > 0 && (
      <RelatedContent
        locale={locale}
        eyebrow={parentService.data.title}
        title={t('services.detail.relatedTopicsHeading')}
        items={relatedServices}
      />
    )
  }

  <InquiryCTA
    title={t('home.inquiry.title')}
    body={t('home.inquiry.body')}
    ctaLabel={t('common.cta')}
    ctaHref={`/${locale}/contact/`}
  />
</BaseLayout>

<style>
  /* Same widening as the other booking pages — the widget needs more room
     than the site's usual prose column. */
  :global(.page-hero .container.prose) {
    max-width: var(--content-max-width);
    margin-inline: auto;
  }

  /* PageHero's own heading has its own narrower prose cap for the normal
     (no-CTA) case — the override above only widened its parent, so without
     this it stays flush-left inside the now-wider, centered container. */
  :global(.page-hero .container.prose .page-hero__heading) {
    max-width: 100%;
  }

  .highlights-section {
    padding-top: 0;
  }
</style>
