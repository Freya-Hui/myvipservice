---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PageHero from '../../../../components/PageHero.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import SectionHeading from '../../../../components/SectionHeading.astro';
import Gallery from '../../../../components/Gallery.astro';
import StoryFeature from '../../../../components/about/StoryFeature.astro';
import RelatedContent from '../../../../components/RelatedContent.astro';
import MediaHighlightList from '../../../../components/MediaHighlightList.astro';
import TravelTypes from '../../../../components/home/TravelTypes.astro';
import InquiryCTA from '../../../../components/home/InquiryCTA.astro';
import { getLocaleEntries } from '../../../../lib/content';
import { useTranslations, type Locale } from '../../../../i18n/ui';

function slugOf(id: string) {
  return id.split('/').slice(1).join('/');
}

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((entry) => ({
    params: { locale: entry.id.split('/')[0], slug: entry.id.split('/').slice(1).join('/') },
    props: { entry },
  }));
}

const { locale } = Astro.params as { locale: Locale };
const { entry } = Astro.props as { entry: CollectionEntry<'services'> };
const { data } = entry;
const slug = slugOf(entry.id);
const t = useTranslations(locale);
const { Content } = await render(entry);

// A curated handful, not the entire catalogue — mixing the palace-hotel and
// villa styles this page's storyFeatures actually contrast.
const FEATURED_ACCOMMODATION_KEYS = [
  'ritz-paris',
  'four-seasons-george-v',
  'hotel-de-crillon',
  'cheval-blanc',
  'grand-villa-geneva-mies',
  'chateau-de-neydens',
];
const accommodations =
  slug === 'hotel-villa-reservations'
    ? (await getLocaleEntries('accommodations', locale)).filter((entry) =>
        FEATURED_ACCOMMODATION_KEYS.includes(entry.data.translationKey),
      )
    : [];

const transportationTopics =
  slug === 'private-transportation'
    ? (
        await getCollection('transportationTopics', (topic) => topic.id.startsWith(`${locale}/`))
      ).sort((a, b) => a.data.order - b.data.order)
    : [];

const featuredTravelStyles =
  slug === 'tailor-made-travel-planning'
    ? (await getLocaleEntries('travelStyles', locale))
        .filter((entry) => entry.data.featured)
        .sort((a, b) => a.data.order - b.data.order)
        .map((entry) => ({
          title: entry.data.title,
          description: entry.data.description,
          href: `/${locale}/travel-styles/${entry.data.slug}/`,
        }))
    : [];

// Tailor-made planning names the themes it covers (wine, art, skiing, the
// coast) as plain content — the sample journeys built around those themes
// are a separate "go see one" section afterwards, not links buried inside
// the descriptive text itself.
const SAMPLE_JOURNEY_KEYS = [
  'bordeaux-burgundy-wine-journey',
  'paris-loire-valley-journey',
  'alps-geneva-journey',
  'cote-dazur-provence-journey',
];
const sampleJourneys =
  slug === 'tailor-made-travel-planning'
    ? (await getLocaleEntries('journeys', locale)).filter((entry) =>
        SAMPLE_JOURNEY_KEYS.includes(entry.data.translationKey),
      )
    : [];

// A highlight is either a plain string or a {text, image?, href?} object —
// normalize both to one shape, same as the accommodations/journeys
// templates, so MediaHighlightList doesn't need to branch on it.
interface HighlightItem {
  text: string;
  image?: string;
  href?: string;
}
const highlights: HighlightItem[] = data.highlights.map((item) =>
  typeof item === 'string' ? { text: item } : item,
);

// The quote/booking CTA sits on the same row as the title (PageHero's `cta`
// slot), so it's computed once here instead of via QuickInquiryButton's own
// full-width row further down the page.
const ctaLabel =
  slug === 'vip-airport-reception'
    ? t('vipReceptionBooking.title')
    : slug === 'tickets-events'
      ? t('ticketBooking.title')
      : slug === 'hotel-villa-reservations'
        ? t('hotelEnquiry.title')
        : t('common.ctaQuote');
const ctaHref =
  slug === 'vip-airport-reception'
    ? `/${locale}/services/vip-airport-reception/book/`
    : slug === 'tickets-events'
      ? `/${locale}/services/tickets-events/book/`
      : slug === 'hotel-villa-reservations'
        ? `/${locale}/services/hotel-villa-reservations/book/`
        : `/${locale}/contact/?about=${encodeURIComponent(data.title)}`;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: data.title,
  description: data.seoDescription ?? data.summary,
  provider: { '@type': 'Organization', name: 'MYVIPSERVICE' },
  areaServed: 'Europe',
  url: new URL(`/${locale}/services/${slug}/`, Astro.site).toString(),
};
---

<BaseLayout
  title={data.title}
  description={data.seoDescription ?? data.summary}
  path={`services/${slug}`}
  imageId={data.image}
  structuredData={structuredData}
>
  <div class="container">
    <Breadcrumbs
      items={[
        { label: t('nav.home'), href: `/${locale}/` },
        { label: t('nav.services'), href: `/${locale}/services/` },
        { label: data.title },
      ]}
    />
  </div>

  <PageHero
    eyebrow={t('nav.services')}
    title={data.title}
    subtitle={data.summary}
    imageId={data.image}
    locale={locale}
  >
    <a slot="cta" class="button button--primary" href={ctaHref}>
      {ctaLabel} →
    </a>
  </PageHero>

  {
    // The top gallery band is a fallback for pages that have no other
    // photography — once a page's highlights or sample-journey cards carry
    // their own images further down, a second photo strip up here is
    // redundant clutter, not added value.
    data.storyFeatures.length === 0 &&
      data.gallery.length > 0 &&
      sampleJourneys.length === 0 &&
      !highlights.some((item) => item.image) && (
        <div class="container">
          <Gallery images={data.gallery} locale={locale} />
        </div>
      )
  }

  <section class="section">
    <div class="container prose">
      <Content />
    </div>
  </section>

  {
    data.storyFeatures.map((feature, index) => (
      <StoryFeature
        title={feature.title}
        body={feature.body}
        imageId={feature.imageId}
        locale={locale}
        reverse={index % 2 === 1}
      />
    ))
  }

  {
    highlights.length > 0 && (
      <section class="section highlights-section">
        <div class="container prose">
          <SectionHeading eyebrow={data.title} title={t('services.detail.highlightsTitle')} />
          <MediaHighlightList items={highlights} locale={locale} />
        </div>
      </section>
    )
  }

  {
    transportationTopics.length > 0 && (
      <RelatedContent
        locale={locale}
        eyebrow={data.title}
        title={t('services.detail.transportationTopicsHeading')}
        items={transportationTopics.map((topic) => ({
          href: `/${locale}/services/${slug}/${topic.id.split('/').slice(1).join('/')}/`,
          imageId: topic.data.image ?? data.image ?? 'service-private-transportation',
          eyebrow: data.title,
          title: topic.data.title,
          summary: topic.data.summary,
          meta: topic.data.price
            ? `${topic.data.price}${topic.data.priceNote ? ` — ${topic.data.priceNote}` : ''}`
            : undefined,
          draftLabel: topic.data.draft ? t('badge.draftTranslation') : undefined,
        }))}
      />
    )
  }

  {
    sampleJourneys.length > 0 && (
      <RelatedContent
        locale={locale}
        eyebrow={t('journeys.hero.title')}
        title={t('services.detail.sampleJourneysHeading')}
        items={sampleJourneys.map((item) => ({
          href: `/${locale}/journeys/${item.data.slug}/`,
          imageId: item.data.coverImage,
          eyebrow: item.data.theme,
          title: item.data.title,
          summary: item.data.description,
          meta: item.data.duration,
        }))}
        viewAllLabel={t('services.detail.viewAllJourneys')}
        viewAllHref={`/${locale}/journeys/`}
      />
    )
  }

  {
    data.investmentTier && (
      <div class="container">
        <p class="text-small tier-line">
          <span class="tier-line__label">{t('services.tier.label')}:</span>{' '}
          <span class="tier-line__value">{t(`services.tier.${data.investmentTier}` as never)}</span>
          <span class="tier-line__note"> — {t('services.tier.note')}</span>
        </p>
      </div>
    )
  }

  {
    accommodations.length > 0 && (
      <RelatedContent
        locale={locale}
        eyebrow={t('accommodations.hero.title')}
        title={t('services.detail.accommodationsHeading')}
        items={accommodations.map((item) => ({
          href: `/${locale}/accommodations/${item.data.slug}/`,
          imageId: item.data.coverImage,
          eyebrow: t(`type.${item.data.type}` as never),
          title: item.data.title,
          summary: item.data.description,
          meta: `${item.data.city}, ${item.data.country}`,
          draftLabel: item.data.draft ? t('badge.draftTranslation') : undefined,
        }))}
      />
    )
  }

  {
    accommodations.length > 0 && (
      <div class="container view-all-row">
        <a class="button button--quiet" href={`/${locale}/accommodations/`}>
          {t('services.detail.viewAllAccommodations')} →
        </a>
      </div>
    )
  }

  {
    featuredTravelStyles.length > 0 && (
      <TravelTypes
        eyebrow={t('home.travelTypes.eyebrow')}
        title={t('home.travelTypes.title')}
        subtitle={t('home.travelTypes.subtitle')}
        items={featuredTravelStyles}
        ctaLabel={t('common.cta')}
        ctaHref={`/${locale}/contact/`}
      />
    )
  }

  <InquiryCTA
    title={t('home.inquiry.title')}
    body={t('home.inquiry.body')}
    ctaLabel={t('common.cta')}
    ctaHref={`/${locale}/contact/`}
  />
</BaseLayout>

<style>
  .highlights-section {
    padding-top: 0;
  }

  .view-all-row {
    margin-top: calc(var(--space-5) * -1);
    margin-bottom: var(--space-6);
  }

  .tier-line {
    color: var(--color-text-muted);
    margin-bottom: var(--space-5);
  }

  .tier-line__label {
    color: var(--color-text-faint);
  }

  .tier-line__value {
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
  }
</style>
