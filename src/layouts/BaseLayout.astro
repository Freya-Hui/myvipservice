---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Seo from '../components/Seo.astro';
import { useTranslations, type Locale } from '../i18n/ui';
import type { LinkableCollection } from '../lib/content';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Path relative to /<locale>/, e.g. '' for the homepage or 'about' — no leading/trailing slash. */
  path: string;
  /** Matches an id in src/data/image-attributions.ts — defaults to the hero shot. */
  imageId?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  /** Set on detail pages so the language switcher can find the matching translation. */
  translationContext?: { collection: LinkableCollection; translationKey: string };
  /** Homepage only: floats the header over the full-bleed hero image instead of a solid bar above it. */
  transparentHeader?: boolean;
  /** See Seo.astro — pages reachable only via a private link. */
  noindex?: boolean;
}

const {
  title,
  description,
  path,
  imageId,
  structuredData,
  translationContext,
  transparentHeader,
  noindex,
} = Astro.props;
const currentLocale = (Astro.currentLocale ?? 'en') as Locale;
const t = useTranslations(currentLocale);
---

<!doctype html>
<html lang={currentLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#f7f3ec" />
    <Seo
      title={title}
      description={description}
      path={path}
      imageId={imageId}
      structuredData={structuredData}
      noindex={noindex}
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{t('a11y.skipToContent')}</a>
    <Header translationContext={translationContext} transparent={transparentHeader} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
